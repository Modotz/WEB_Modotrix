@using ERP.Web.Models
@model GoodsReceiptViewModel

@{
    ViewData["Title"] = T["Penerimaan"] + " " + Model.ReceiptNo;

    var culture = new System.Globalization.CultureInfo("id-ID");
    var details = Model.Details ?? new List<GoodsReceiptItemViewModel>();
    var total = details.Sum(x => x.Subtotal);

    var status = (Model.Status ?? "draft").Trim().ToLowerInvariant();
    var isDraft = status == "draft";
    var deleteConfirm = isDraft
        ? T["Hapus draft penerimaan {0}?", Model.ReceiptNo]
        : T["Batalkan penerimaan {0}? Stok & qty diterima PO akan dikembalikan.", Model.ReceiptNo];

    var (statusText, statusClass) = status switch
    {
        "draft" => (T["Draft"], "product-badge-unit"),
        "posted" => (T["Diposting"], "product-badge-stock"),
        "cancelled" => (T["Dibatalkan"], "product-badge-no-stock"),
        _ => (status, "product-badge-type")
    };

    var no = 1;
}

<div class="po-view-page">

    <h1 class="po-view-title">@T["Penerimaan"] @Model.ReceiptNo</h1>

    <section class="po-view-card po-info-card">
        <div class="po-view-card-header po-info-header">

            <div class="po-info-heading">
                <strong>@T["Penerimaan"] @Model.ReceiptNo</strong>

                <span class="po-status-badge @statusClass">
                    @statusText
                </span>
            </div>

            <div class="po-actions">

                @if (isDraft)
                {
                    <a asp-action="Edit"
                       asp-route-uid="@Model.Uid"
                       data-perm="update"
                       class="btn btn-warning btn-sm">
                        <i class="bi bi-pencil"></i> @T["Edit"]
                    </a>

                    <button type="button"
                            class="btn btn-primary btn-sm"
                            data-perm="update"
                            data-bs-toggle="modal"
                            data-bs-target="#postReceiptModal">
                        <i class="bi bi-check2-circle"></i> @T["Posting"]
                    </button>
                }

                <form asp-action="Delete"
                      asp-route-uid="@Model.Uid"
                      method="post"
                      data-perm="delete"
                      class="po-action-form"
                      onsubmit='return confirm(@Json.Serialize(deleteConfirm));'>
                    <button type="submit"
                            class="btn btn-outline-danger btn-sm"
                            title="@T["Batalkan Penerimaan"]">
                        <i class="bi bi-x-circle"></i> @T["Batalkan"]
                    </button>
                </form>

                <a asp-action="Print"
                   asp-route-uid="@Model.Uid"
                   target="_blank"
                   class="btn btn-light btn-sm">
                    <i class="bi bi-printer"></i> @T["Cetak"]
                </a>

                <a asp-action="ExportPdf"
                   asp-route-uid="@Model.Uid"
                   class="btn btn-danger btn-sm">
                    <i class="bi bi-file-pdf"></i> PDF
                </a>

                <a asp-action="Index"
                   class="btn btn-secondary btn-sm"
                   title="@T["Kembali"]">
                    <i class="bi bi-arrow-left"></i>
                </a>
            </div>
        </div>

        <div class="po-info-grid">

            <div class="po-info-column">
                <div class="po-info-row">
                    <strong>@T["Tanggal"]</strong>
                    <span>@Model.ReceiptDate.ToString("dd MMM yyyy", culture)</span>
                </div>

                <div class="po-info-row">
                    <strong>@T["Gudang Tujuan"]</strong>
                    <span>@(Model.WarehouseName ?? "-")</span>
                </div>

                <div class="po-info-row">
                    <strong>@T["Supplier"]</strong>
                    <span>@(string.IsNullOrWhiteSpace(Model.SupplierName) ? "-" : Model.SupplierName)</span>
                </div>
            </div>

            <div class="po-info-column">
                <div class="po-info-row">
                    <strong>@T["Dari PO"]</strong>
                    <span>
                        @if (!string.IsNullOrWhiteSpace(Model.POUid))
                        {
                            <a asp-controller="GoodsPurchaseOrders"
                               asp-action="Details"
                               asp-route-uid="@Model.POUid">@Model.PONo</a>
                        }
                        else
                        {
                            @("-")
                        }
                    </span>
                </div>

                <div class="po-info-row">
                    <strong>@T["No. Referensi"]</strong>
                    <span>@(string.IsNullOrWhiteSpace(Model.RefNo) ? "-" : Model.RefNo)</span>
                </div>

                <div class="po-info-row">
                    <strong>@T["Catatan"]</strong>
                    <span>@(string.IsNullOrWhiteSpace(Model.Note) ? "-" : Model.Note)</span>
                </div>
            </div>
        </div>

        @if (isDraft)
        {
            <div class="alert alert-warning small m-3 mb-0">
                <i class="bi bi-info-circle me-1"></i>
                @Html.Raw(T["Masih <strong>draft</strong>: stok belum bertambah. Klik <strong>Posting</strong> bila penerimaan sudah final."])
            </div>
        }
    </section>

    <section class="po-view-card po-items-card">

        <div class="po-view-card-header">
            <strong>@T["Item Diterima"]</strong>
        </div>

        <div class="po-table-wrapper">
            <table class="table po-items-table">
                <thead>
                    <tr>
                        <th class="po-number-col">#</th>
                        <th class="text-start">@T["Produk"]</th>
                        <th class="text-start">@T["Satuan"]</th>
                        <th>@T["Qty"]</th>
                        <th>@T["Harga Beli"]</th>
                        <th class="text-end">@T["Subtotal"]</th>
                    </tr>
                </thead>

                <tbody>
                    @if (details.Any())
                    {
                        foreach (var item in details)
                        {
                            <tr>
                                <td class="po-number-col">@(no++)</td>
                                <td class="text-start po-product-cell">
                                    <div class="po-product-name">@item.ProductName</div>
                                </td>
                                <td class="text-start">@(item.UnitCode ?? "-")</td>
                                <td class="text-end">@item.Qty.ToString("N2", culture)</td>
                                <td class="text-end">@item.UnitCost.ToString("N2", culture)</td>
                                <td class="text-end po-money">@item.Subtotal.ToString("N2", culture)</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="po-empty">
                                <i class="bi bi-inbox"></i>
                                @T["Belum ada item."]
                            </td>
                        </tr>
                    }
                </tbody>

                <tfoot>
                    <tr class="po-total-row">
                        <td colspan="5" class="text-end">@T["Total"]</td>
                        <td class="text-end po-money">@total.ToString("N2", culture)</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </section>
</div>

@if (isDraft)
{
    <div class="modal fade"
         id="postReceiptModal"
         tabindex="-1"
         aria-labelledby="postReceiptModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="postReceiptModalLabel">@T["Konfirmasi Posting"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T["Tutup"]"></button>
                </div>

                <div class="modal-body">
                    @T["Posting penerimaan"] <strong>@Model.ReceiptNo</strong>?
                    @T["Setelah diposting, dokumen tidak dapat diubah lagi."]
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">@T["Tidak"]</button>

                    <form asp-action="Approve"
                          asp-route-uid="@Model.Uid"
                          method="post">
                        <button type="submit" class="btn btn-primary btn-sm">
                            <i class="bi bi-check2-circle"></i> @T["Ya, posting"]
                        </button>
                    </form>
                </div>

            </div>
        </div>
    </div>
}
