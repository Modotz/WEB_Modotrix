@using ERP.Web.Models
@model GoodsReceiptViewModel
@inject ERP.Web.Services.BrandingService Branding

@{
    Layout = null;

    var branding = await Branding.GetAsync();
    var culture = new System.Globalization.CultureInfo("id-ID");
    var details = Model.Details ?? new List<GoodsReceiptItemViewModel>();
    var total = details.Sum(x => x.Subtotal);
    var statusText = (Model.Status ?? "draft").ToLowerInvariant() switch
    {
        "draft" => "DRAFT",
        "posted" => T["DIPOSTING"],
        "cancelled" => T["DIBATALKAN"],
        var s => s.ToUpperInvariant()
    };
    var no = 1;
}

<!DOCTYPE html>
<html lang="@T.Lang">
<head>
    <meta charset="utf-8" />
    <title>@T["Penerimaan"] @Model.ReceiptNo</title>
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; padding: 24px; font-family: Arial, Helvetica, sans-serif; color: #111; background: #fff; font-size: 11px; }
        .head { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid #111; padding-bottom: 8px; margin-bottom: 12px; }
        .head h1 { margin: 0; font-size: 18px; }
        .head .app { font-size: 14px; font-weight: 700; }
        .status { border: 1px solid #111; padding: 2px 8px; font-weight: 700; font-size: 10px; }
        .info { display: grid; grid-template-columns: 1fr 1fr; gap: 4px 24px; margin-bottom: 12px; }
        .info div { display: flex; gap: 8px; }
        .info strong { min-width: 110px; }
        table { width: 100%; border-collapse: collapse; }
        th, td { border: 1px solid #999; padding: 4px 6px; text-align: left; }
        th { background: #eee; }
        td.num, th.num { text-align: right; }
        tfoot td { font-weight: 700; }
        .sign { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 40px; text-align: center; }
        .sign .line { margin-top: 56px; border-top: 1px solid #111; padding-top: 4px; }
        @@media print { body { padding: 0; } }
    </style>
</head>
<body onload="window.print()">

    <div class="head">
        <div>
            <div class="app">@branding.AppName</div>
            <h1>@T["BUKTI PENERIMAAN BARANG"]</h1>
        </div>
        <span class="status">@statusText</span>
    </div>

    <div class="info">
        <div><strong>@T["No. Penerimaan"]</strong><span>@Model.ReceiptNo</span></div>
        <div><strong>@T["Supplier"]</strong><span>@(string.IsNullOrWhiteSpace(Model.SupplierName) ? "-" : Model.SupplierName)</span></div>
        <div><strong>@T["Tanggal"]</strong><span>@Model.ReceiptDate.ToString("dd MMMM yyyy", culture)</span></div>
        <div><strong>@T["Gudang Tujuan"]</strong><span>@(Model.WarehouseName ?? "-")</span></div>
        <div><strong>@T["Dari PO"]</strong><span>@(string.IsNullOrWhiteSpace(Model.PONo) ? "-" : Model.PONo)</span></div>
        <div><strong>@T["No. Referensi"]</strong><span>@(string.IsNullOrWhiteSpace(Model.RefNo) ? "-" : Model.RefNo)</span></div>
        <div><strong>@T["Catatan"]</strong><span>@(string.IsNullOrWhiteSpace(Model.Note) ? "-" : Model.Note)</span></div>
    </div>

    <table>
        <thead>
            <tr>
                <th style="width: 32px;">@T["No"]</th>
                <th>@T["Produk"]</th>
                <th style="width: 70px;">@T["Satuan"]</th>
                <th class="num" style="width: 80px;">@T["Qty"]</th>
                <th class="num" style="width: 110px;">@T["Harga Beli"]</th>
                <th class="num" style="width: 120px;">@T["Subtotal"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in details)
            {
                <tr>
                    <td>@(no++)</td>
                    <td>@item.ProductName</td>
                    <td>@(item.UnitCode ?? "-")</td>
                    <td class="num">@item.Qty.ToString("N2", culture)</td>
                    <td class="num">@item.UnitCost.ToString("N2", culture)</td>
                    <td class="num">@item.Subtotal.ToString("N2", culture)</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="5" class="num">@T["Total"]</td>
                <td class="num">@total.ToString("N2", culture)</td>
            </tr>
        </tfoot>
    </table>

    <div class="sign">
        <div>@T["Dikirim oleh"]<div class="line">@T["Supplier / Pengirim"]</div></div>
        <div>@T["Diterima oleh"]<div class="line">@T["Petugas Gudang"]</div></div>
        <div>@T["Diketahui oleh"]<div class="line">@T["Kepala Gudang"]</div></div>
    </div>

    <p style="margin-top: 24px; color: #666;">@T["Dicetak"]: @DateTime.Now.ToString("dd/MM/yyyy HH:mm", culture)</p>
</body>
</html>
