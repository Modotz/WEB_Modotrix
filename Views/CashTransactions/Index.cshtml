@model ERP.Web.Models.CashTransactionsIndexViewModel
@{
    ViewData["Title"] = T["Transaksi Kas & Bank"];
    var f = Model.Filter;
    var list = Model.Transactions;
    var query = f.ToQueryString();
    var qs = query.Length > 0 ? "?" + query : "";
    string PageUrl(int p) => Url.Action("Index") + "?" + (query.Length > 0 ? query + "&" : "") + $"page={p}&pageSize={f.PageSize}";

    Func<object?, Microsoft.AspNetCore.Mvc.Razor.HelperResult> createButtons =
        @<text>
            <a href="@Url.Action("Create", new { type = "in" })" class="btn btn-teal btn-custom-action d-inline-flex align-items-center gap-1" data-perm="create">
                <i class="bi bi-box-arrow-in-down"></i><span>@T["Kas Masuk"]</span>
            </a>
            <a href="@Url.Action("Create", new { type = "out" })" class="btn btn-danger btn-custom-action btn-cash-out d-inline-flex align-items-center gap-1" data-perm="create">
                <i class="bi bi-box-arrow-up"></i><span>@T["Kas Keluar"]</span>
            </a>
            <a href="@Url.Action("Create", new { type = "transfer" })" class="btn btn-primary btn-custom-action btn-cash-transfer d-inline-flex align-items-center gap-1" data-perm="create">
                <i class="bi bi-arrow-left-right"></i><span>@T["Transfer"]</span>
            </a>
        </text>;

    var header = new ListHeaderModel
    {
        Title = T["Daftar Transaksi"],
        Count = list.TotalCount,
        Description = T["Kas masuk, kas keluar dan transfer antar rekening"],
        PdfUrl = Url.Action("ExportPdf") + qs,
        ExcelUrl = Url.Action("ExportExcel") + qs,
        PrintUrl = Url.Action("PrintList") + qs,
        Extra = createButtons(null)
    };
}

<style>
    .btn-custom-action.btn-cash-out { background: #dc3545; border-color: #dc3545; }
    .btn-custom-action.btn-cash-out:hover { background: #bb2d3b; border-color: #bb2d3b; }
    .btn-custom-action.btn-cash-transfer { background: #0d6efd; border-color: #0d6efd; }
    .btn-custom-action.btn-cash-transfer:hover { background: #0b5ed7; border-color: #0b5ed7; }
</style>

<div class="page-heading supplier-page">

    <h3 class="fw-bold mb-3">@T["Transaksi Kas & Bank"]</h3>

    <!-- FILTER CARD -->
    <div class="card supplier-card supplier-filter">
        <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-funnel"></i>
                <span class="fw-semibold">@T["Filter"]</span>
            </div>
            <button class="btn btn-sm text-muted p-0" type="button" data-bs-toggle="collapse" data-bs-target="#filterCollapse" aria-expanded="true" aria-controls="filterCollapse">
                <i class="bi bi-chevron-down"></i>
            </button>
        </div>
        <div class="collapse show" id="filterCollapse">
            <div class="card-body">
                <form method="get" asp-action="Index" class="row g-2 align-items-end">
                    <div class="col-md-2">
                        <label class="form-label" for="q">@T["Cari"]</label>
                        <input type="text" class="form-control" id="q" name="q" value="@f.Q" placeholder="@T["No., keterangan, referensi"]" />
                    </div>
                    <div class="col-md">
                        <label class="form-label" for="cashAccountUid">@T["Rekening"]</label>
                        <select class="form-select" id="cashAccountUid" name="cashAccountUid">
                            <option value="">@T["-- Semua --"]</option>
                            @foreach (var c in Model.CashAccounts)
                            {
                                <option value="@c.Uid" selected="@(c.Uid == f.CashAccountUid)">@c.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md">
                        <label class="form-label" for="type">@T["Jenis"]</label>
                        <select class="form-select" id="type" name="type">
                            <option value="">@T["-- Semua --"]</option>
                            <option value="in" selected="@(f.Type == "in")">@T["Masuk"]</option>
                            <option value="out" selected="@(f.Type == "out")">@T["Keluar"]</option>
                            <option value="transfer" selected="@(f.Type == "transfer")">@T["Transfer"]</option>
                        </select>
                    </div>
                    <div class="col-md">
                        <label class="form-label" for="status">@T["Status"]</label>
                        <select class="form-select" id="status" name="status">
                            <option value="">@T["-- Semua --"]</option>
                            <option value="draft" selected="@(f.Status == "draft")">@T["Draft"]</option>
                            <option value="posted" selected="@(f.Status == "posted")">@T["Posted"]</option>
                            <option value="void" selected="@(f.Status == "void")">@T["Dibatalkan"]</option>
                        </select>
                    </div>
                    <div class="col-md-auto">
                        <label class="form-label" for="dateFrom">@T["Dari"]</label>
                        <input type="date" class="form-control" id="dateFrom" name="dateFrom" value="@f.DateFrom?.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-auto">
                        <label class="form-label" for="dateTo">@T["Sampai"]</label>
                        <input type="date" class="form-control" id="dateTo" name="dateTo" value="@f.DateTo?.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-1">
                        <label class="form-label" for="pageSize">@T["Per Halaman"]</label>
                        <select class="form-select" id="pageSize" name="pageSize">
                            @foreach (var size in new[] { 10, 25, 50, 100 })
                            {
                                <option value="@size" selected="@(f.PageSize == size)">@size</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-auto d-flex gap-2">
                        <button type="submit" class="btn btn-primary d-flex align-items-center gap-2">
                            <i class="bi bi-search"></i>
                            @T["Terapkan"]
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary" title="@T["Reset Filter"]">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- DATA TABLE CARD -->
    <div class="card supplier-card supplier-table-card">
        <partial name="_ListHeader" model="header" />

        <div class="collapse show" id="listBody">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 supplier-table first-left">
                <thead>
                    <tr>
                        <th class="ps-4" style="width: 140px;">@T["NO."]</th>
                        <th style="width: 100px;">@T["TANGGAL"]</th>
                        <th style="width: 100px;">@T["JENIS"]</th>
                        <th>@T["REKENING / LAWAN"]</th>
                        <th>@T["KETERANGAN"]</th>
                        <th class="text-end" style="width: 150px;">@T["NOMINAL"]</th>
                        <th style="width: 150px;">@T["STATUS"]</th>
                        <th class="text-center" style="width: 70px;">@T["AKSI"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (list.Data.Count == 0)
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">@T["Belum ada transaksi."]</td></tr>
                    }
                    @foreach (var t in list.Data)
                    {
                        var (label, css) = t.StatusBadge;
                        <tr>
                            <td class="ps-4"><a asp-action="Details" asp-route-uid="@t.Uid" class="text-info text-decoration-none">@t.TrxNo</a></td>
                            <td class="text-white small">@Acc.Date(t.TrxDate)</td>
                            <td class="small @(t.Type == "in" ? "text-success" : t.Type == "out" ? "text-danger" : "text-info")">@T[t.TypeLabel]</td>
                            <td class="text-white small">
                                @if (t.Type == "transfer")
                                {
                                    @t.Counterpart
                                }
                                else
                                {
                                    <div>@t.CashAccountName</div>
                                    <div class="text-white-50">@t.Counterpart</div>
                                }
                            </td>
                            <td class="text-white">@(t.Description ?? "-")</td>
                            <td class="text-end text-white">
                                @Acc.Fx(t.Amount, t.CurrencyCode)
                                @if (t.Type == "transfer" && t.DestCurrencyCode != null && t.DestCurrencyCode != t.CurrencyCode)
                                {
                                    <div class="text-white-50 small">→ @Acc.Fx(t.DestAmount ?? 0, t.DestCurrencyCode)</div>
                                }
                                else if (t.HasForeign && t.Status != "draft")
                                {
                                    <div class="text-white-50 small">≈ @Acc.Money(t.FunctionalAmount)</div>
                                }
                            </td>
                            <td><span class="badge @css">@T[label]</span></td>
                            <td class="text-center">
                                <div class="row-actions">
                                    <a asp-action="Details" asp-route-uid="@t.Uid" class="act-btn act-view" title="@T["Lihat"]"><i class="bi bi-eye"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_ListPagination" model="new ListPaginationModel { Page = list.Page, PageSize = list.PageSize, TotalCount = list.TotalCount, PageUrl = PageUrl }" />
        </div>
    </div>
</div>
