                                {
                                    <option value="@value">@T[label]</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="dpDate">@T["Tanggal"]</label>
                            <input type="date" class="form-control" name="date" id="dpDate" value="@today" max="@today" required />
                        </div>
                        <div class="col-md-6 dp-proceeds">
                            <label class="form-label" for="dpProceeds">@T["Hasil pelepasan"]</label>
                            <input type="number" step="0.01" min="0" class="form-control text-end" name="proceeds" id="dpProceeds" value="0" />
                        </div>
                        <div class="col-md-6 dp-proceeds">
                            <label class="form-label" for="dpCash">@T["Diterima di rekening"]</label>
                            <select class="form-select" name="cashAccountId" id="dpCash">
                                <option value="">@T["— Pilih —"]</option>
                                @foreach (var c in Model.CashAccounts)
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="dpNote">@T["Catatan"]</label>
                            <input type="text" class="form-control" name="note" id="dpNote" maxlength="255" />
                        </div>
                        <div class="col-12 small text-muted">@T["Nilai buku saat ini: {0}", Acc.Money(a.BookValue)]</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@T["Batal"]</button>
                    <button type="submit" class="btn btn-danger">@T["Lepas Aset"]</button>
                </div>
            </form>
        </div>
    </div>
}

@if (a.CanCancelDisposal)
{
    <div class="modal fade" id="cancelDisposalModal" tabindex="-1">
        <div class="modal-dialog">
            <form method="post" asp-action="CancelDisposal" asp-route-uid="@a.Uid" class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@T["Batal Pelepasan"] @a.AssetNo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="small">@T["Jurnal pelepasan dibalik, aset kembali aktif dan jadwal penyusutan dibuat ulang."]</p>
                    <div class="mb-3">
                        <label class="form-label" for="cdDate">@T["Tanggal jurnal pembalik"]</label>
                        <input type="date" class="form-control" name="date" id="cdDate" value="@a.DisposalDate?.ToString("yyyy-MM-dd")" min="@a.DisposalDate?.ToString("yyyy-MM-dd")" required />
                    </div>
                    <label class="form-label" for="cdReason">@T["Alasan (wajib)"]</label>
                    <textarea class="form-control" name="reason" id="cdReason" rows="2" maxlength="200" required></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@T["Tidak"]</button>
                    <button type="submit" class="btn btn-warning">@T["Batal Pelepasan"]</button>
                </div>
            </form>
        </div>
    </div>
}

@if (a.CanVoid)
{
    <div class="modal fade" id="voidModal" tabindex="-1">
        <div class="modal-dialog">
            <form method="post" asp-action="Delete" asp-route-uid="@a.Uid" class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@T["Batalkan Perolehan"] @a.AssetNo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="small">@T["Jurnal perolehan dibalik (aset dari stok kembali ke gudang); aset berstatus Dibatalkan dan tetap tercatat. Hanya bila belum ada penyusutan terposting."]</p>
                    <div class="mb-3">
                        <label class="form-label" for="vdDate">@T["Tanggal pembatalan"]</label>
                        <input type="date" class="form-control" name="date" id="vdDate" value="@today" required />
                    </div>
                    <label class="form-label" for="vdReason">@T["Alasan (wajib)"]</label>
                    <textarea class="form-control" name="reason" id="vdReason" rows="2" maxlength="200" required></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@T["Tidak"]</button>
                    <button type="submit" class="btn btn-danger">@T["Batalkan Perolehan"]</button>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <script>
        (function () {
            // Buka tab dari hash (#schedule, #usage, #adjustments, #assignments, #maintenance, #journals).
            const hash = location.hash.replace('#', '');
            const btn = hash && document.getElementById('btn-tab-' + hash);
            if (btn) new bootstrap.Tab(btn).show();

            const type = document.getElementById('dpType');
            if (type) {
                const sync = () => document.querySelectorAll('.dp-proceeds').forEach(el => el.classList.toggle('d-none', type.value === 'lost'));
                type.addEventListener('change', sync);
                sync();
            }

            const method = document.getElementById('chMethod');
            if (method) {
                const syncF = () => {
                    document.getElementById('chFactor').disabled = method.value !== 'declining_balance';
                    document.getElementById('chUnitsBox').classList.toggle('d-none', method.value !== 'units_of_production');
                };
                method.addEventListener('change', syncF);
                syncF();
            }

            // Penyesuaian nilai: satu modal untuk tambah biaya / revaluasi / impairment / pembalikan impairment.
            const modal = document.getElementById('adjustModal');
            if (modal) {
                const fmt = new Intl.NumberFormat('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                const info = {
                    book: @Json.Serialize(a.BookValue), salvage: @Json.Serialize(a.SalvageValue), surplus: @Json.Serialize(a.RevaluationSurplus)
                };
                const text = {
                    capex: [@Json.Serialize(T["Tambah Biaya ke Aset"]), @Json.Serialize(T["Capital expenditure: D akun aset / K kas. Harga perolehan bertambah; sisa nilai buku − residu dibagi ulang ke sisa umur (umur tidak diperpanjang)."])],
                    revaluation: [@Json.Serialize(T["Revaluasi Aset"]), @Json.Serialize(T["Revaluasi ke ekuitas (3-4000 Surplus Revaluasi). Turun dibatasi saldo surplus aset ini — kelebihannya catat sebagai Impairment terpisah."])],
                    impairment: [@Json.Serialize(T["Impairment Aset"]), @Json.Serialize(T["Rugi penurunan nilai: D 5-4200 / K akumulasi penyusutan (harga perolehan tetap). Dibatasi nilai buku di atas residu."])],
                    'impairment-reversal': [@Json.Serialize(T["Balik Impairment {0}"]), @Json.Serialize(T["Pemulihan: D akumulasi / K 4-2500 (pos pemulihan sendiri). Sekali per impairment, maksimal nilai impairment aslinya."])]
                };
                const t = {
                    book: @Json.Serialize(T["Nilai buku {0} · residu {1}"]), surplus: @Json.Serialize(T["Saldo surplus revaluasi aset ini: {0}"]),
                    max: @Json.Serialize(T["Maksimal {0}"])
                };
                const $ = (id) => document.getElementById(id);

                function open(kind, btn) {
                    $('adKind').value = kind;
                    $('adReverses').value = btn.dataset.reverses ?? '';
                    $('adTitle').textContent = text[kind][0].replace('{0}', btn.dataset.label ?? '');
                    $('adHelp').textContent = text[kind][1];
                    modal.querySelectorAll('.ad-capex').forEach(el => el.classList.toggle('d-none', kind !== 'capex'));
                    modal.querySelectorAll('.ad-revaluation').forEach(el => el.classList.toggle('d-none', kind !== 'revaluation'));
                    $('adCash').required = kind === 'capex';
                    $('adAmount').value = kind === 'impairment-reversal' ? btn.dataset.max : '';
                    $('adAmount').max = kind === 'impairment-reversal' ? btn.dataset.max : '';
                    const lines = [t.book.replace('{0}', fmt.format(info.book)).replace('{1}', fmt.format(info.salvage))];
                    if (kind === 'revaluation') lines.push(t.surplus.replace('{0}', fmt.format(info.surplus)));
                    if (kind === 'impairment-reversal') lines.push(t.max.replace('{0}', fmt.format(Number(btn.dataset.max))));
                    $('adInfo').textContent = lines.join(' · ');
                    bootstrap.Modal.getOrCreateInstance(modal).show();
                }

                document.querySelectorAll('.btn-adjust').forEach(b => b.addEventListener('click', () => open(b.dataset.kind, b)));
            }
        })();
    </script>
}
