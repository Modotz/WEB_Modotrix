@model ERP.Web.Models.JournalViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="@T.Lang">
<head>
    <meta charset="utf-8" />
    <title>@T["Jurnal {0}", Model.JournalNo]</title>
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; padding: 24px; font-family: Arial, Helvetica, sans-serif; color: #111; background: #fff; font-size: 12px; }
        h1 { margin: 0 0 4px 0; font-size: 18px; }
        .meta { display: grid; grid-template-columns: 140px 1fr 140px 1fr; gap: 4px 12px; margin: 12px 0 16px; }
        .meta div:nth-child(odd) { color: #6c757d; }
        table { width: 100%; border-collapse: collapse; }
        th, td { border: 1px solid #ccc; padding: 5px 8px; text-align: left; }
        th { background: #f1f3f5; }
        td.num, th.num { text-align: right; }
        tfoot td { font-weight: 700; }
        .note { margin-top: 10px; color: #6c757d; }
        .sign { display: flex; justify-content: space-between; margin-top: 48px; }
        .sign div { width: 30%; text-align: center; border-top: 1px solid #333; padding-top: 4px; }
        @@media print { body { padding: 0; } }
    </style>
</head>
<body onload="window.print()">
    <h1>@T["Bukti Jurnal {0}", Model.JournalNo]</h1>
    <div>@T["Status"]: @T[Model.StatusBadge.Label]</div>

    <div class="meta">
        <div>@T["Tanggal"]</div><div>@Acc.Date(Model.JournalDate)</div>
        <div>@T["Referensi"]</div><div>@(Model.Reference ?? "-")</div>
        <div>@T["Keterangan"]</div><div>@(Model.Description ?? "-")</div>
        <div>@T["Sumber"]</div><div>@(Model.Source == "manual" ? T["Manual"] : $"{T["Sistem"]} — {T[Model.SourceLabel]}")</div>
    </div>

    <table>
        <thead>
            <tr><th style="width: 90px;">@T["Kode"]</th><th>@T["Akun"]</th><th>@T["Keterangan"]</th><th class="num" style="width: 130px;">@T["Debit"]</th><th class="num" style="width: 130px;">@T["Kredit"]</th></tr>
        </thead>
        <tbody>
            @foreach (var l in Model.Lines)
            {
                <tr>
                    <td>@l.AccountCode</td>
                    <td>@l.AccountName</td>
                    <td>@l.Description</td>
                    <td class="num">@Acc.MoneyOrBlank(l.Debit)</td>
                    <td class="num">@Acc.MoneyOrBlank(l.Credit)</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="3" class="num">@T["Total"]</td>
                <td class="num">@Acc.Money(Model.Lines.Sum(l => l.Debit))</td>
                <td class="num">@Acc.Money(Model.Lines.Sum(l => l.Credit))</td>
            </tr>
        </tfoot>
    </table>

    @if (Model.ReversesNo != null)
    {
        <div class="note">@T["Jurnal pembalik dari"] @Model.ReversesNo. @T["Alasan:"] @(Model.VoidReason ?? "-")</div>
    }
    @if (Model.ReversedByNo != null)
    {
        <div class="note">@T["Jurnal ini sudah dibatalkan oleh"] @Model.ReversedByNo.</div>
    }

    <div class="sign">
        <div>@T["Dibuat"] (@(Model.CreatedByName ?? "-"))</div>
        <div>@T["Diperiksa"]</div>
        <div>@T["Disetujui"]</div>
    </div>
</body>
</html>
