@using ERP.Web.Models
@model PagedResult<ProductViewModel>

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />

    <title>@T["Produk"]</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 20px;
            font-family: Arial, Helvetica, sans-serif;
            color: #111;
            background: #fff;
            font-size: 11px;
        }

        .print-container {
            width: 100%;
        }

        .header {
            margin-bottom: 12px;
        }

        .header h1 {
            margin: 0 0 4px 0;
            font-size: 20px;
            font-weight: 700;
        }

        .header-info {
            font-size: 11px;
            color: #444;
        }

        .header-info span {
            margin-right: 5px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

        th,
        td {
            border: 1px solid #999;
            padding: 5px 6px;
            text-align: left;
            vertical-align: middle;
            word-wrap: break-word;
        }

        th {
            background: #0d6efd;
            color: white;
            font-weight: 700;
            text-align: center;
        }

        td:first-child {
            text-align: center;
        }

        .status {
            text-align: center;
        }

        .footer {
            margin-top: 12px;
            font-size: 10px;
            color: #555;
        }

        .print-button {
            margin-bottom: 15px;
        }

        .print-button button {
            padding: 8px 16px;
            border: none;
            border-radius: 4px;
            background: #0d6efd;
            color: white;
            cursor: pointer;
        }

        .close-button {
            padding: 8px 16px;
            border: none;
            border-radius: 4px;
            background: #6c757d;
            color: white;
            cursor: pointer;
            margin-left: 5px;
        }

        @@media print {

            @@page {
                size: A4 landscape;
                margin: 10mm;
            }

            body {
                padding: 0;
                font-size: 9px;
            }

            .print-button {
                display: none;
            }

            .header h1 {
                font-size: 16px;
            }

            table {
                font-size: 8px;
            }

            th,
            td {
                padding: 3px 4px;
            }

            .footer {
                font-size: 8px;
            }
        }
    </style>
</head>

<body>

    <div class="print-container">

        <div class="print-button">
            <button type="button" onclick="window.print()">
                @T["Cetak"]
            </button>

            <button type="button"
                    class="close-button"
                    onclick="window.close()">
                @T["Tutup"]
            </button>
        </div>

        <div class="header">

            <h1>ERP-LITE</h1>

            <div class="header-info">
                <span>@T["Produk"]</span>
                <span>•</span>
                <span>
                    @T["Dicetak"]:
                    @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
                </span>
                <span>•</span>
                <span>
                    @T["Total: {0}", T["{0} data", Model.TotalData]]
                </span>
            </div>

        </div>

        <table>

            <thead>
                <tr>
                    <th style="width: 4%;">No</th>
                    <th style="width: 15%;">Sku</th>
                    <th style="width: 20%;">Barcode</th>
                    <th style="width: 20%;">Name</th>
                    <th style="width: 8%;">@T["Kategori"]</th>
                    <th style="width: 5%;">Unit</th>
                    <th style="width: 5%;">Cost Price</th>
                    <th style="width: 5%;">Sell Price</th>
                    <th style="width: 5%;">Min Stock</th>
                    <th style="width: 5%;">Track Stock</th>
                    <th style="width: 5%;">Status</th>
                    <th style="width: 20%;">Image</th>
                </tr>
            </thead>

            <tbody>

                @{
                    var no = 1;
                }

                @foreach (var item in Model.Data)
                {
                    <tr>
                        <td>@no</td>

                        <td>
                            @item.Sku
                        </td>

                        <td>
                            @item.Barcode
                        </td>

                        <td>
                            @item.Name
                        </td>

                        <td>
                            @item.CategoryName
                        </td>

                        <td>
                            @item.UnitName
                        </td>

                        <td>
                            @item.CostPrice?.ToString("#,##0", new System.Globalization.CultureInfo("id-ID"))
                        </td>

                        <td>
                            @item.SellPrice?.ToString("#,##0", new System.Globalization.CultureInfo("id-ID"))
                        </td>

                        <td>
                            @item.MinStock?.ToString("#,##0.###")
                        </td>

                        <td>
                            @item.TrackStock
                        </td>
                         
                        <td class="status">
                            @(item.IsActive ? T["Aktif"] : T["Nonaktif"])
                        </td>
                        
                        <td>
                            @item.Image
                        </td>
                    </tr>

                    no++;
                }

            </tbody>

        </table>

        <div class="footer">
            @T["Dokumen dihasilkan otomatis oleh sistem."]
        </div>

    </div>

    <script>
        window.onload = function () {
            window.print();
        };
    </script>

</body>
</html>