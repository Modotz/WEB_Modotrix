@using ERP.Web.Models
@model ProductViewModel

@{
    ViewData["Title"] = "Tambah Produk";

    var allCategories = ViewBag.Categories as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var categories = allCategories.Where(x => x.ParentId == null).ToList();
    var subCategories = allCategories.Where(x => x.ParentId != null).ToList();
    var brands = ViewBag.Brands as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var units = ViewBag.Units as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
}

<div class="product-page-title">
   Tambah Produk
</div>


<div class="product-info-card">
    <div class="product-info-header"
         data-bs-toggle="collapse"
         data-bs-target="#productInfo">
        <div>
            <i class="bi bi-info-circle-fill me-2"></i>
            <strong>Panduan Pengisian - Produk </strong>
        </div>
        <i class="bi bi-chevron-down"></i>
    </div>

    <div id="productInfo"
         class="collapse show">

        <div class="product-info-body">
            <ol class ="ps-3 mb-0">
                <li>
                   <strong> Identitas : </strong>isi <strong>SKU</strong> (kode unik, wajib) dan <strong>Nama Produk</strong> 
                    (wajib). <i>No. Produk</i> terisi otomatis (PRD-xxxxx); <i>Barcode</i> opsional.
                </li>

                <li>
                   <strong> Klasifikasi : </strong> pilih <strong>Category & Brand </strong> (opsional), <strong>Jenis Produk</strong>
                    (wajib), dan <i>Unit </i> - satuan dasar produk (wajib). Satuan lain & konversinya diatur nanti lewat menu <i>Satuan Produk</i>.
                </li>

                <li>
                    <strong> Mode Dimensi </strong> menentukan cara Qty dihitung di transaksi: pilih  <strong>"Tidak"</strong>bila qty = jumlah satuan (mis. Pcs/Lembar); pilih 
                    <strong>Panjang/Luas/Volume</strong>bila qty dihitung dari dimensi (mis. busa/kain). Bila dimensional, isi <i>Dimensi per satuan (cm) </i> 
                    sebagai nilai default.
                </li>

                <li>
                    <strong> Mode Harga: "Harga tetap" </strong> → isi <strong>Harga Beli & Harga Jual </strong>langsung. 
                    <strong>"Per kubikasi" </strong>→ isi <strong>Tarif Beli/Jual per m³ </strong>+ dimensi (P×L×T); harga per satuan dihitung otomatis (Beli/Jual jadi read-only).
                    <strong>Min Stock</strong> opsional (peringatan stok menipis).
                </li>

                <li>
                    <strong>Lain-lain: </strong><i>Deskripsi & Gambar </i> opsional. Sakelar: <strong>Track Stock </strong>(pantau stok),
                    <strong>Lacak Serial </strong>(tiap unit discan nomor serial saat penerimaan), <strong>Aktif. Garansi (bulan) </strong> 
                    berlaku untuk produk ber-serial (dihitung sejak terjual).
                </li>

                <li>
                    Klik <strong>Simpan </strong>Untuk produk ber-<strong>varian </strong>(mis. beda ukuran/warna): 
                    simpan dulu induknya, lalu kelola varian dari daftar produk (tombol <i class="bi bi-diagram-3"></i>  Varian).
                </li>

            </ol>

            <div class="product-info-tip">
                <i class="bi bi-lightbulb"></i>
                kolom bertanda <span class="required-mark"> * </span> wajib diisi. Panel ini bisa ditutup dengan mengklik judulnya.
            </div>

        </div>

    </div>
</div>

<div class="card product-create-card">
    <div class="card-header">
        <strong>Tambah Produk</strong>
    </div>

    <div class="card-body">
        <form method="post" asp-action="Create" asp-controller="Products" enctype="multipart/form-data">
             @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger mb-3">
                <strong>Data belum dapat disimpan.</strong>

                <ul class="mb-0 mt-2">
                    @foreach (var error in ViewData.ModelState.Values
                        .SelectMany(v => v.Errors))
                    {
                        <li>
                            @(string.IsNullOrWhiteSpace(error.ErrorMessage)
                                ? "Nilai yang dimasukkan tidak valid."
                                : error.ErrorMessage)
                        </li>
                    }
                </ul>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                <strong>Gagal menyimpan:</strong>
                @TempData["Error"]
            </div>
        }
                @Html.AntiForgeryToken()
               
            <div class="section-title">
                <i class="bi bi-card-text"></i>
                IDENTITAS
            </div> 
            <div class="row g-2">
                <div class="col-md-4">
                    <label class="form-label">
                        No. Produk
                    </label>

                    <input type="text"
                           class="form-control"
                           id="ProductNumber"
                           placeholder="Otomatis (PRD-xxxx)" readonly>
                </div>

                <div class="col-md-4">
                    <label class="form-label">
                        SKU <span class="text-danger">*</span>
                    </label>

                    <input type="text"
                           class="form-control"
                           id="Sku"
                           name="Sku"
                           required>
                </div>

                <div class="col-md-4">
                    <label class="form-label">
                        Barcode
                    </label>

                    <input type="text"
                           class="form-control"
                           id="Barcode"
                           name="Barcode">
                </div>

                <div class="col-md-3">
                    <label class="form-label">
                        Kode Internal
                    </label>

                    <input type="text"
                           class="form-control"
                           id="InternalCode"
                           name="InternalCode">
                </div>

                <div class="col-md-3">
                    <label class="form-label">
                        Kode Eksternal 1
                    </label>

                    <input type="text"
                           class="form-control"
                           id="ExternalCode1"
                           name="ExternalCode1">
                </div>

                <div class="col-md-3">
                    <label class="form-label">
                        Kode Eksternal 2
                    </label>

                    <input type="text"
                           class="form-control"
                           id="ExternalCode2"
                           name="ExternalCode2">
                </div>

                <div class="col-md-3">
                    <label class="form-label">
                        Kode Eksternal 3
                    </label>

                    <input type="text"
                           class="form-control"
                           id="ExternalCode3"
                           name="ExternalCode3">
                </div>

                <div class="col-12">
                    <label class="form-label">
                        Nama Produk <span class="text-danger">*</span>
                    </label>

                    <input type="text"
                           class="form-control"
                           id="Name"
                           name="Name"
                           required>
                </div>
            </div> 

            <div class="section-title mt-3">
                <i class="bi bi-tags"></i>
                KLASIFIKASI
            </div>

            <div class="row g-2">

                <div class="col-md-3">
                    <label class="form-label">
                        Brand
                    </label>

                    <select class="form-select"
                            id="BrandId"
                            name="BrandId">

                        <option value="">-- Pilih --</option>
                         @foreach (var brand in (IEnumerable<DropdownItemViewModel>)ViewBag.Brands)
                        {
                            <option value="@brand.Id">
                                @brand.Name
                            </option>
                        }
                    </select>
                </div>

              <div class="col-md-3">
                <label class="form-label">Kategori</label>

                <select class="form-select"
                        id="CategoryId"
                        name="CategoryId">

                    <option value="">-- Pilih --</option>

                    @foreach (var category in
                        (IEnumerable<DropdownItemViewModel>)ViewBag.Categories)
                    {
                        <option value="@category.Id"
                                selected="@(Model.CategoryId == category.Id)">
                            @category.Name
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label">Sub-Kategori</label>

                <select class="form-select"
                        id="SubCategoryId"
                        name="SubCategoryId"
                        disabled>

                    <option value="">-- (tanpa sub) --</option>

                </select>

                <div class="form-text">
                    Pilih Kategori dulu; sub menyesuaikan.
                </div>
            </div>

                <div class="col-md-3">
                    <label class="form-label">
                        Jenis Produk <span class="text-danger">*</span>
                    </label>

                    <select class="form-select"
                            id="ProductType"
                            name="ProductType"
                            required>

                        <option value="RAW_MATERIAL">
                            Bahan Baku (RAW_MATERIAL)
                        </option>

                        <option value="FINISHED_GOOD">
                            Barang Jadi (FINISHED_GOOD)
                        </option>

                        @* <option value="SERVICE">
                            Jasa (SERVICE)
                        </option>*@

                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">
                        Unit <span class="text-danger">*</span>
                    </label>

                    <select class="form-select"
                            id="UnitId"
                            name="UnitId"
                            required>

                        <option value="">-- Pilih --</option>
                        @foreach (var unit in units)
                        {
                            <option value="@unit.Id">
                                @unit.Name
                            </option>
                        }
                    </select>
                </div>
            </div> 
            
            <div class="section-title mt-3">
                <i class="bi bi-rulers"></i>
                DIMENSI & HARGA
            </div>

            <div class="row g-2">
                <div class="col-md-4">
                    <label class="form-label">
                        Mode Dimensi
                        <small class="text-muted">(Qty transaksi)</small>
                    </label>

                    <select class="form-select"
                            id="DimMode"
                            name="DimMode">

                        <option value="none">
                            Tidak — qty per satuan (mis. per Lembar/Pcs)
                        </option>

                        <option value="length">
                            Panjang (P x jml)
                        </option>

                        <option value="area">
                            Luas (P x L x jml)
                        </option>

                        <option value="volume">
                            Volume (P x L x T x jml)
                        </option>
                    </select>

                    <small class="form-text">
                        "Tidak" = qty diisi jumlah satuan.
                        Lainnya = qty dari dimensi.
                    </small>
                </div>

                <div class="col-md-4">
                    <label class="form-label">
                        Mode Harga
                    </label>

                    <select class="form-select"
                            id="PriceMode"
                            name="PriceMode">

                        <option value="fixed">
                            Harga tetap (isi langsung)
                        </option>

                        <option value="volume">
                            Per kubikasi — volume × tarif m³
                        </option>
                    </select>
                </div>
            </div>

            <div id="cubicPriceSection"
                 class="cubic-price-section mt-3"
                 style="display: none;">

                 <div class="alert alert-warning cubic-warning mb-3">
                     <i class="bi bi-exclamation-triangle-fill"></i>
                     <strong>Mode harga kubikasi aktif</strong>
                        — Harga Beli/Jual dihitung otomatis dari
                        <strong>Panjang × Lebar × Tebal</strong>.
                        Pastikan ketiga dimensi (terutama Tebal) benar.
                 </div>

                 <div class="row g-2">
                      <div class="col-12">
                          <label class="form-label">
                              Dimensi per satuan
                              <small>(cm)</small>
                          </label>
                     </div>
             
                     <div class="col-md-4">
                         <input type="number" class="form-control cubic-input"
                            id="DefLength" name="DefLength" value="0"
                             min="0" step="0.01" placeholder="Panjang">
                     </div>

                      <div class="col-md-4">
                         <input type="number" class="form-control cubic-input"
                                id="DefWidth" name="DefWidth" value="0"
                                min="0" step="0.01" placeholder="Lebar">
                      </div>
                     
                      <div class="col-md-4">
                           <input type="number" class="form-control cubic-input"
                                id="DefHeight" name="DefHeight" value="0" min="0"
                                step="0.01" placeholder="Tebal">
 
                      </div>
                  </div>

                  <div class="row g-2 mt-1"> 
                       <div class="col-md-6"> 
                           <label class="form-label">
                                Tarif Beli / m³
                           </label>
                           <input type="number" class="form-control"
                                  id="CostPerM3" name="CostPerM3"
                                  value="0" min="0" step="0.01">
                                <small class="form-text" id="cubicCalculationResult"> 
                                    Volume/satuan = 0 m³ → Beli 0 / Jual 0 
                                </small> 
                       </div>
                       
                       <div class="col-md-6">
                            <label class="form-label">
                                Tarif Jual / m³
                            </label>
                            <input type="number"
                                   class="form-control"
                                   id="SellPerM3"
                                   name="SellPerM3"
                                   value="0"
                                   min="0"
                                   step="0.01">
                      </div> 
                </div>
             </div>

            <div id="normalPriceSection" class="mt-2">
                <div class="row g-2">

                    <div class="col-md-4">
                        <label class="form-label">
                            Harga Beli
                            <small class="text-muted">(per satuan)</small>
                        </label>

                        <input type="number"
                               class="form-control"
                               id="CostPrice"
                               name="CostPrice"
                               asp-for="CostPrice"
                               min="0"
                               step="0.01">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">
                            Harga Jual
                            <small class="text-muted">(per satuan)</small>
                        </label>

                        <input type="number"
                               class="form-control"
                               id="SellPrice"
                               name="SellPrice"
                               asp-for="SellPrice"
                               min="0"
                               step="0.01">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">
                            Min Stock
                        </label>

                        <input type="number"
                               class="form-control"
                               id="MinStock"
                               name="MinStock"
                               asp-for="MinStock"
                               min="0"
                               step="1">
                    </div>

                </div>
            </div>

                <div class="section-title mt-3">
                    <i class="bi bi-card-list"></i>
                    LAIN-LAIN
                </div>

                <div class="row g-2">

                    <div class="col-md-8">

                        <label class="form-label">
                            Deskripsi
                        </label>

                        <textarea class="form-control"
                                  id="Description"
                                  name="Description"
                                  rows="3"></textarea>

                    </div>

                    <div class="col-md-4">

                        <label class="form-label">
                            Gambar
                        </label>

                        <input type="file"
                               class="form-control"
                               id="ImageFile"
                               name="ImageFile"
                               accept="image/*">
                    <div class="form-text">
                        Format gambar yang didukung: JPG, JPEG, PNG.
                    </div>

                    </div>

                </div>

                <div class="d-flex gap-3 align-items-center mt-3">
                <div class="form-check form-switch">
                    <input class="form-check-input"
                           type="checkbox"
                           id="TrackStock"
                           name="TrackStock"
                           value="true"
                           checked>

                    <input type="hidden"
                           name="TrackStock"
                           value="false">

                    <label class="form-check-label" for="TrackStock">
                        Track Stock
                    </label>
                </div>

                <div class="form-check form-switch">
                    <input class="form-check-input"
                           type="checkbox"
                           id="TrackSerial"
                           name="TrackSerial"
                           value="true">

                    <input type="hidden"
                           name="TrackSerial"
                           value="false">

                    <label class="form-check-label" for="TrackSerial">
                        Lacak Serial
                        <small>(per unit)</small>
                    </label>
                </div>

                <div class="form-check form-switch">
                    <input class="form-check-input"
                           type="checkbox"
                           id="IsActive"
                           name="IsActive"
                           value="true"
                           checked>

                    <input type="hidden"
                           name="IsActive"
                           value="false">

                    <label class="form-check-label" for="IsActive">
                        Aktif
                    </label>
                </div>
                </div>

                <div class="row g-2 mt-2">
                    <div class="col-md-3">
                        <label class="form-label">
                            Garansi (bulan)
                        </label>

                        <input type="number"
                               class="form-control"
                               id="WarrantyMonths"
                               name="WarrantyMonths"
                               value="0"
                               min="0">

                        <div class="form-text">
                            Untuk produk ber-serial: masa garansi dihitung
                            sejak tanggal terjual (kirim SO).
                            0. = tanpa garansi.
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-3">
                    <button type="submit"
                            class="btn btn-primary">
                        <i class="bi bi-save"></i>
                        Simpan
                    </button>

                    <a href="/Products"
                       class="btn btn-secondary">
                        Batal
                    </a>

                </div>
            </form>
        </div>
    </div>

    
<script>
    document.addEventListener("DOMContentLoaded", function () {
         
        const categorySelect = document.getElementById("CategoryId");
        const subCategorySelect = document.getElementById("SubCategoryId"); 
        const priceMode = document.getElementById("PriceMode"); 
        const normalPriceSection = document.getElementById("normalPriceSection");
        const cubicPriceSection = document.getElementById("cubicPriceSection"); 

        const costPrice = document.getElementById("CostPrice");
        const sellPrice = document.getElementById("SellPrice"); 
        const costPerM3 = document.getElementById("CostPerM3");
        const sellPerM3 = document.getElementById("SellPerM3");

        const defLength = document.getElementById("DefLength");
        const defWidth = document.getElementById("DefWidth");
        const defHeight = document.getElementById("DefHeight");

        const calculationResult = document.getElementById("cubicCalculationResult");

        async function loadSubCategories(
            categoryId,
            selectedSubCategoryId = ""
        ) {

            subCategorySelect.innerHTML =
                '<option value="">-- (tanpa sub) --</option>';

            if (!categoryId) {
                subCategorySelect.disabled = true;
                return;
            }

            subCategorySelect.disabled = true;

            try {

                const response = await fetch(
                    `/Products/GetSubCategories?categoryId=${encodeURIComponent(categoryId)}`
                );

                if (!response.ok) {
                    throw new Error(
                        `Gagal mengambil Sub-Kategori. Status: ${response.status}`
                    );
                }

                const data = await response.json(); 
                data.forEach(item => {

                    const option = document.createElement("option"); 
                    option.value = item.id ?? item.Id;
                    option.textContent = item.name ?? item.Name;

                    if (
                        String(option.value) ===
                        String(selectedSubCategoryId)
                    ) {
                        option.selected = true;
                    }

                    subCategorySelect.appendChild(option);

                });

                subCategorySelect.disabled = false;

            } catch (error) { 
                console.error("Error memuat Sub-Kategori:", error); 
                subCategorySelect.disabled = true; 
                alert(
                    "Gagal memuat Sub-Kategori. Silakan periksa koneksi API."
                );

            }
        }


        categorySelect.addEventListener("change", function () { 
            loadSubCategories(this.value);

        });


        if (categorySelect.value) { 
            loadSubCategories(
                categorySelect.value,
                "@Model.SubCategoryId"
            );

        }

        function getInputValue(element) { 
            const value = parseFloat(element.value);
            return Number.isFinite(value) && value >= 0
                ? value
                : 0;
        }

        function formatNumber(value) { 
            return value.toLocaleString("id-ID", {
                minimumFractionDigits: 0,
                maximumFractionDigits: 2
            });

        }


        // ==========================================
        // PERHITUNGAN HARGA KUBIKASI
        function calculateCubicPrice() {

            if (priceMode.value !== "volume") {
                return;
            }
             
            const length = getInputValue(defLength);
            const width = getInputValue(defWidth);
            const height = getInputValue(defHeight);
             
            const buyRate = getInputValue(costPerM3);
            const sellRate = getInputValue(sellPerM3);


            // Konversi cm3 menjadi m3
            const volume = (length * width * height) / 1000000; 

            // Hitung harga per satuan
            const calculatedCost = volume * buyRate;
            const calculatedSell = volume * sellRate;


            // Masukkan hasil ke field harga
            costPrice.value = calculatedCost.toFixed(2);
            sellPrice.value = calculatedSell.toFixed(2);


            // Tampilkan informasi perhitungan
            if (calculationResult) {

                calculationResult.textContent =
                    `Volume/satuan = ${formatNumber(volume)} m³ ` +
                    `→ Beli ${formatNumber(calculatedCost)} ` +
                    `/ Jual ${formatNumber(calculatedSell)}`;

            }

        }

         
        function updatePriceMode() {

            if (!priceMode) {
                return;
            }

            const isVolume = priceMode.value === "volume";


            if (isVolume) {

                // Tampilkan input tarif dan dimensi
                cubicPriceSection.style.display = "block";

                // Harga tetap ditampilkan sebagai hasil kalkulasi
                normalPriceSection.style.display = "block";


                // Harga beli dan jual tidak bisa diedit manual
                costPrice.readOnly = true;
                sellPrice.readOnly = true;


                // Aktifkan validasi input kubikasi
                defLength.required = true;
                defWidth.required = true;
                defHeight.required = true;

                costPerM3.required = true;
                sellPerM3.required = true;


                // Hitung langsung ketika mode dipilih
                calculateCubicPrice();

            } else {

                // Sembunyikan input kubikasi
                cubicPriceSection.style.display = "none";

                // Tampilkan harga tetap
                normalPriceSection.style.display = "block";


                // Harga dapat diedit manual
                costPrice.readOnly = false;
                sellPrice.readOnly = false;


                // Nonaktifkan validasi kubikasi
                defLength.required = false;
                defWidth.required = false;
                defHeight.required = false;

                costPerM3.required = false;
                sellPerM3.required = false;

            }

        }
         
        [
            defLength,
            defWidth,
            defHeight,
            costPerM3,
            sellPerM3
        ].forEach(element => {

            element.addEventListener("input", calculateCubicPrice); 
            element.addEventListener("change", calculateCubicPrice);

        });

        // Perbarui tampilan ketika mode harga berubah
        priceMode.addEventListener("change", updatePriceMode);
        updatePriceMode();

    });
</script>