@model BrandViewModel

@{
    ViewData["Title"] = T["Tambah Brands"];
}

<div class="page-header">
    <h1>@T["Tambah Brands"]</h1>
</div>

<div class="brand-form-card">

    <div class="brand-form-header">
        <h3>@T["Tambah Brands"]</h3>
    </div>

    <form asp-action="Create" method="post">

        @Html.AntiForgeryToken()

        <div class="brand-form-body">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="mb-4">
                <label asp-for="Name" class="form-label">
                    Name <span class="text-danger">*</span>
                </label>

                <input asp-for="Name"
                       class="form-control" />

                <span asp-validation-for="Name"
                      class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Image" class="form-label">
                    Image
                </label>

                <input asp-for="Image"
                       class="form-control"
                       type="file" />

                <span asp-validation-for="Image"
                      class="text-danger"></span>
            </div>

            <div class="form-check form-switch">

    <input type="hidden"
           id="IsActive"
           name="IsActive"
           value="1" />

    <input type="checkbox"
           id="isActiveCheck"
           class="form-check-input"
           checked />

    <label for="isActiveCheck"
           class="form-check-label">
        Is Active
    </label>

</div>

        </div>

        <div class="brand-form-footer">

            <button type="submit"
                    class="btn btn-primary">
                @T["Simpan"]
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                @T["Batal"]
            </a>

        </div>

    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<style>

    .brand-form-card {
        width: 65%;
        max-width: 1050px;
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 12px;
        overflow: hidden;
    }

    .brand-form-header {
        padding: 18px 20px;
        border-bottom: 1px solid var(--card-border);
    }

    .brand-form-header h3 {
        margin: 0;
        font-size: 20px;
        color: var(--text-main);
    }

    .brand-form-body {
        padding: 24px 20px 35px;
    }

    .brand-form-body .form-label {
        color: var(--text-main);
        margin-bottom: 10px;
    }

    .brand-form-body .form-control {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        color: var(--text-main);
    }

    .brand-form-body .form-control:focus {
        background: var(--card-bg);
        color: var(--text-main);
        border-color: var(--primary);
        box-shadow: none;
    }

    .brand-form-footer {
        padding: 10px 20px;
        border-top: 1px solid var(--card-border);
        background: rgba(255,255,255,.03);
    }

    .brand-form-footer .btn {
        min-width: 90px;
        margin-right: 5px;
    }

</style>