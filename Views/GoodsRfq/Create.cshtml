@model ERP.Web.ViewModels.GoodsRfqViewModel
@using ERP.Web.Models

@{
   ViewData["Title"] = ViewBag.IsEdit == true ? "Edit RFQ Barang" : "Tambah RFQ Barang";

    var products = ViewBag.Products as List<GoodsRfqItemViewModel> ?? new List<GoodsRfqItemViewModel>(); 
    
var suppliers = ViewBag.Suppliers as IEnumerable<DropdownItemViewModel>
    ?? Enumerable.Empty<DropdownItemViewModel>();
    var units = ViewBag.Units as IEnumerable<DropdownItemViewModel> ?? Enumerable.Empty<DropdownItemViewModel>();

}

<style>
    .rfq-plain-readonly,
    .rfq-plain-readonly:read-only {
        background-color: transparent !important;
        opacity: 1;
    }
</style>

<div class="po-create-page">

  <div class="product-page-title">
    @(ViewBag.IsEdit == true ? "Edit RFQ Barang" : "Tambah RFQ Barang")
  </div>

    <!-- PANDUAN -->
    <div class="product-info-card">
        <div class="product-info-header"
             data-bs-toggle="collapse"
             data-bs-target="#productInfo">
            <div>
                <i class="bi bi-info-circle-fill me-2"></i>
                <strong>Panduan Pengisian - RFQ Barang</strong>
            </div>
            <i class="bi bi-chevron-down"></i>
        </div>

        <div id="productInfo" class="collapse show">
            <div class="product-info-body">
                <ol class="ps-3 mb-0">
                    <li>
                        <strong>RFQ (Request for Quotation)</strong> adalah permintaan
                        penawaran harga ke <strong>satu supplier</strong> — belum jadi pesanan.
                        Pilih <strong>Supplier</strong> dan <strong>Tanggal</strong> (wajib).
                        <i>Berlaku s/d</i> dan <i>Catatan</i> opsional.
                    </li>

                    <li>
                        Tambah item: cari <strong>Produk</strong>, isi <strong>Qty</strong>,
                        pilih <strong>Satuan</strong>, dan isi <strong>Est.Harga</strong> 
                        (perkiraan/target) sebagai acuan - <i>bukan</i> harga final.
                    </li>

                    <li>
                        Klik <strong>Simpan Draft</strong>. Selanjutnya:
                        <strong>Kirim ke Supplier</strong> →
                        <strong>Input Penawaran</strong> (harga dari supplier) →
                        <strong>Jadikan PO</strong>.
                    </li>

                    <li>
                        <strong>Stok tidak berubah</strong> pada tahap RFQ.
                    </li>
                </ol>

                <div class="product-info-tip">
                    <i class="bi bi-lightbulb"></i>
                    Tips: RFQ juga bisa dibuat dari PR yang disetujui (tombol "Buat RFQ" di halaman PR).
                </div>
            </div>
        </div>
    </div>

    <form asp-action="@(ViewBag.IsEdit == true ? "Edit" : "Create")"
          asp-route-id="@(ViewBag.IsEdit == true ? Model.Id : (long?)null)"
          method="post" id="goodsRfqForm">

          @Html.AntiForgeryToken()

        <!-- INFORMASI RFQ -->
        <div class="card po-detail-card">

        <div class="card-header">
          <strong>@(ViewBag.IsEdit == true ? "Edit RFQ Barang" : "Tambah RFQ Barang")</strong>
        </div>
    
            <div class="card-body">

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger mb-3">
                        <strong>Data belum dapat disimpan.</strong>
                        <ul class="mb-0 mt-2">
                            @foreach (var item in ViewData.ModelState)
                            {
                                @foreach (var error in item.Value.Errors)
                                {
                                    <li>
                                        @(string.IsNullOrWhiteSpace(error.ErrorMessage)
                                            ? error.Exception?.GetBaseException().Message
                                                ?? "Nilai yang dimasukkan tidak valid."
                                            : error.ErrorMessage)
                                    </li>
                                }
                            }
                        </ul>
                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">
                        <strong>Gagal menyimpan:</strong>
                        @TempData["Error"]
                    </div>
                }

                <div class="row g-2 mb-2">

                    <div class="col-md-4">
                        <label class="form-label">No. RFQ</label>
                        <input type="text"
                               class="form-control"
                               value="@(ViewBag.IsEdit == true ? Model.RfqNo: (ViewBag.NextRfqNo ?? "-"))"
                               readonly />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="SupplierId" class="form-label">
                            Supplier <span class="text-danger">*</span>
                        </label>
                        <select asp-for="SupplierId"
                                class="form-select"
                                required>
                            <option value="">-- Pilih Supplier --</option>

                            @foreach (var supplier in suppliers)
                            {
                                <option value="@supplier.Id">@supplier.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="RfqDate" class="form-label">
                            Tanggal RFQ <span class="text-danger">*</span>
                        </label>
                        <input asp-for="RfqDate"
                               type="date"
                               class="form-control"
                               value="@Model.RfqDate.ToString("yyyy-MM-dd")"
                               required />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="ValidUntil" class="form-label">Berlaku s/d</label>
                        <input asp-for="ValidUntil"
                               type="date"
                               class="form-control" />
                    </div>

                    <div class="col-md-8">
                        <label asp-for="Note" class="form-label">Catatan</label>
                        <input asp-for="Note"
                               type="text"
                               class="form-control"
                               placeholder="Catatan RFQ (opsional)" />
                    </div>

                </div>
            </div>
        </div>

        <!-- DETAIL ITEM -->
        <div class="card mt-2">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Detail Item</strong>

                <button type="button"
                        class="btn btn-sm btn-add-row"
                        id="addItemBtn">
                    <i class="bi bi-plus-lg"></i> Tambah Baris
                </button>
            </div>

            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0" id="itemsTable">
                    <thead>
                        <tr>
                            <th style="width:32px">#</th>
                            <th>PRODUK<span class="text-danger">*</span></th>
                            <th style="width:90px">QTY</th>
                            <th style="width:100px">SATUAN</th>
                            <th style="width:130px">EST. HARGA</th>
                            <th style="width:130px">SUBTOTAL</th>
                            <th style="width:35px"></th>
                        </tr>
                    </thead>

                    <tbody id="itemsBody">
                        @for (var i = 0; i < Model.Items.Count; i++)
                        {
                            <tr class="item-row">
                                <td class="row-number text-end">@(i + 1)</td>

                                <td>
                                    <select name="Items[@i].ProductId"
                                            class="form-select form-select-sm product-select"
                                            required>
                                        <option value="">-- Cari produk --</option>
                                        @foreach (var product in products)
                                        {
                                            <option value="@product.ProductId"
                                                    selected="@(Model.Items[i].ProductId == product.ProductId)"
                                                    data-unit-id="@(product.UnitId?.ToString() ?? "")"
                                                    data-cost-price="@(product.CostPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0")">
                                                @product.ProductName — @product.Sku
                                            </option>
                                        }
                                    </select>
                                </td>

                                <td>
                                    <input name="Items[@i].Quantity"
                                           type="number"
                                           class="form-control form-control-sm quantity-input"
                                           min="0.01"
                                           step="0.01"
                                           value="@Model.Items[i].Quantity.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                           required />
                                </td>

                                <td>
                                    <select name="Items[@i].UnitId"
                                            class="form-select form-select-sm unit-select">
                                        <option value="">-</option>
                                        @foreach (var unit in units.OrderBy(u => u.Code))
                                        {
                                            <option value="@unit.Id"
                                                    selected="@(Model.Items[i].UnitId == unit.Id)">
                                                @unit.Code
                                            </option>
                                        }
                                    </select>
                                </td>

                                <td>
                                    <input name="Items[@i].EstPrice"
                                           type="number"
                                           class="form-control form-control-sm price-input"
                                           min="0"
                                           step="0.01"
                                           value="@Model.Items[i].EstPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                           required />
                                </td>

                                <td>
                                    <input type="text"
                                           class="form-control form-control-sm text-end subtotal-display rfq-plain-readonly"
                                           value="0"
                                           readonly />
                                </td>

                                <td>
                                    <button type="button"
                                            class="btn btn-sm btn-danger btn-hapus remove-item"
                                            title="Hapus baris">
                                        ×
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
             <tfoot>
            <tr>
         
             <td colspan="5" class="text-end border-0">
                 <strong>Estimasi Total</strong>
                 </td>
            
              <td class="border-0">   
                  <input type="text"
                    id="totalDisplay"
                    class="form-control form-control-sm text-end fw-bold rfq-plain-readonly"
                    value="0"
                    readonly />
                 </td>
              <td class="border-0"></td>
            </tr>
         </tfoot>                      
        </table>
           </div>

                 <div class="po-summary-wrap">
                <div class="po-form-actions">
                    <button type="submit" class="btn po-btn-save">
                        <i class="bi bi-save"></i> Simpan Draft
                    </button>

                    <a asp-action="Index" class="btn po-btn-cancel">
                        Batal
                    </a>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {

<script>

    const itemsBody = document.getElementById('itemsBody');
    const addItemBtn = document.getElementById('addItemBtn');
    const totalDisplay = document.getElementById('totalDisplay');

    // Pilihan produk beserta harga dan satuan default
    const productOptions = `
        <option value="">-- Cari produk --</option>
        @foreach (var product in products)
        {
            <option value="@product.ProductId"
                    data-unit-id="@(product.UnitId?.ToString() ?? "")"
                    data-cost-price="@(product.CostPrice?.ToString(
                        System.Globalization.CultureInfo.InvariantCulture) ?? "0")">
                @Html.Raw(System.Text.Encodings.Web.HtmlEncoder.Default.Encode(
                    $"{product.ProductName} — {product.Sku}"))
            </option>
        }
    `;

    // Pilihan satuan (value = Id, tampil = Kode)
    const unitOptions = `
        <option value="">-</option>
        @foreach (var unit in units.OrderBy(u => u.Code))
        {
            <option value="@unit.Id">
                @Html.Raw(System.Text.Encodings.Web.HtmlEncoder.Default.Encode(unit.Code ?? ""))
            </option>
        }
    `;

    function formatNumber(value) {
        return new Intl.NumberFormat('id-ID', {
            minimumFractionDigits: 0,
            maximumFractionDigits: 2
        }).format(value);
    }

    // Hitung subtotal setiap baris dan total estimasi
    function calculateTotals() {
        let total = 0;

        itemsBody.querySelectorAll('.item-row').forEach(row => {
            const quantity =
                parseFloat(row.querySelector('.quantity-input').value) || 0;

            const price =
                parseFloat(row.querySelector('.price-input').value) || 0;

            const subtotal = quantity * price;

            row.querySelector('.subtotal-display').value =
                formatNumber(subtotal);

            total += subtotal;
        });

        totalDisplay.value = formatNumber(total);
    }

    // Perbarui nomor baris dan indeks nama input agar model binding Items berhasil
    function renumberItems() {
        itemsBody.querySelectorAll('.item-row').forEach((row, index) => {
            const numberCell = row.querySelector('.row-number');
            if (numberCell) numberCell.textContent = index + 1;

            row.querySelector('.product-select').name =
                `Items[${index}].ProductId`;

            row.querySelector('.unit-select').name =
                `Items[${index}].UnitId`;

            row.querySelector('.quantity-input').name =
                `Items[${index}].Quantity`;

            row.querySelector('.price-input').name =
                `Items[${index}].EstPrice`;
        });
    }

    // Ketika produk dipilih, isi harga dan satuan default
    function handleProductChange(row) {
        const productSelect = row.querySelector('.product-select');
        const selectedOption =
            productSelect.options[productSelect.selectedIndex];
        const unitSelect = row.querySelector('.unit-select');

        if (!selectedOption || !selectedOption.value) {
            row.querySelector('.price-input').value = 0;
            unitSelect.value = '';
            calculateTotals();
            return;
        }

        const costPrice =
            parseFloat(selectedOption.dataset.costPrice) || 0;

        const unitId = selectedOption.dataset.unitId;

        row.querySelector('.price-input').value = costPrice;
        unitSelect.value = unitId || '';

        calculateTotals();
    }

    // Tambah baris item baru
    function addItem() {
        const row = document.createElement('tr');
        row.className = 'item-row';

        row.innerHTML = `
            <td class="row-number text-end"></td>
            <td>
                <select class="form-select form-select-sm product-select" required>
                    ${productOptions}
                </select>
            </td>
            <td>
                <input type="number"
                       class="form-control form-control-sm quantity-input"
                       min="0.01" step="0.01"
                       value="1" required />
            </td>
            <td>
                <select class="form-select form-select-sm unit-select">
                    ${unitOptions}
                </select>
            </td>
            <td>
                <input type="number"
                       class="form-control form-control-sm price-input"
                       min="0" step="0.01"
                       value="0" required />
            </td>
            <td>
                <input type="text"
                       class="form-control form-control-sm text-end subtotal-display rfq-plain-readonly"
                       value="0" readonly />
            </td>
            <td>
                <button type="button"
                        class="btn btn-sm btn-danger btn-hapus remove-item"
                        title="Hapus baris">×</button>
            </td>
        `;

        itemsBody.appendChild(row);
        renumberItems();
        calculateTotals();
    }

    // Tombol tambah baris
    addItemBtn.addEventListener('click', addItem);

    // Hitung ulang saat quantity atau harga berubah
    itemsBody.addEventListener('input', event => {
        if (event.target.matches('.quantity-input, .price-input')) {
            calculateTotals();
        }
    });

    // Isi harga dan satuan saat produk dipilih
    itemsBody.addEventListener('change', event => {
        if (event.target.matches('.product-select')) {
            handleProductChange(event.target.closest('.item-row'));
        }
    });

    // Hapus baris
    itemsBody.addEventListener('click', event => {
        const button = event.target.closest('.remove-item');

        if (!button) return;

        const rows = itemsBody.querySelectorAll('.item-row');

        if (rows.length <= 1) {
            alert('Minimal harus ada satu baris item.');
            return;
        }

        button.closest('.item-row').remove();
        renumberItems();
        calculateTotals();
    });

    // Inisialisasi
    if (itemsBody.querySelectorAll('.item-row').length === 0) {
        addItem();
    }

    renumberItems();
    calculateTotals();

</script>
}
