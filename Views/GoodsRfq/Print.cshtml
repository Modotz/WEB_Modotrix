@using ERP.Web.Models
@using System.Globalization
@model ERP.Web.ViewModels.GoodsRfqViewModel

@{
    Layout = null;

    var rfq = Model;
    var culture = new CultureInfo("id-ID");
    var items = rfq.Items ?? new List<GoodsRfqItemViewModel>();

    string Rupiah(decimal? value) =>
        (value ?? 0).ToString("#,##0.##", culture);

    string Tanggal(DateTime? value) =>
        value?.ToString("dd-MM-yyyy") ?? "-";

    var status = (rfq.Status ?? "draft").Trim().ToLowerInvariant().Replace(" ", "_");

    var statusText = status switch
    {
        "draft" => "DRAFT",
        "sent" or "terkirim" => T["TERKIRIM"],
        "quoted" or "ditawar" => T["DITAWAR"],
        "converted" or "jadi_po" => T["JADI PO"],
        "cancelled" or "batal" => T["BATAL"],
        _ => (rfq.Status ?? "-").ToUpperInvariant()
    };

    var hasQuote = items.Any(i => i.QuotedPrice > 0);
    var estimateTotal = items.Sum(i => i.Quantity * i.EstPrice);
    var quoteTotal = items.Where(i => i.QuotedPrice > 0)
                          .Sum(i => i.Quantity * i.QuotedPrice);

    var grandLabel = hasQuote ? T["TOTAL PENAWARAN"] : T["ESTIMASI TOTAL"];
    var grandValue = hasQuote ? quoteTotal : estimateTotal;
}

<!DOCTYPE html>
<html lang="@T.Lang">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>@T["Cetak RFQ Barang"]</title>

        <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                padding: 26px;
                color: #172b49;
                background: #fff;
                font-family: Arial, Helvetica, sans-serif;
                font-size: 11px;
            }

            .print-container {
                width: 100%;
            }

            .toolbar {
                display: flex;
                gap: 8px;
                margin-bottom: 20px;
            }

            .toolbar button,
            .toolbar a {
                display: inline-block;
                padding: 9px 16px;
                border: 0;
                border-radius: 4px;
                color: #fff;
                background: #2864e8;
                font-size: 12px;
                text-decoration: none;
                cursor: pointer;
            }

            .toolbar .back {
                background: #64748b;
            }

            .header {
                display: flex;
                justify-content: space-between;
                align-items: flex-start;
                gap: 24px;
                padding-bottom: 20px;
                border-bottom: 3px solid #2864ff;
            }

            .company {
                max-width: 60%;
            }

            .logo {
                margin: 0 0 6px;
                color: #0878d1;
                font-size: 27px;
                font-weight: 800;
                letter-spacing: 1px;
            }

            .company-info {
                color: #52627a;
                font-size: 9px;
                line-height: 1.7;
            }

            .document-info {
                min-width: 270px;
                text-align: right;
            }

            .document-title {
                margin: 0 0 9px;
                color: #2864ff;
                font-size: 21px;
                font-weight: 700;
            }

            .info-row {
                display: flex;
                justify-content: flex-end;
                gap: 12px;
                margin: 5px 0;
            }

            .info-label {
                color: #64748b;
            }

            .info-value {
                min-width: 105px;
                font-weight: 700;
            }

            .doc-number {
                display: inline-block;
                padding: 4px 8px;
                border: 1px solid #b9d3ff;
                border-radius: 3px;
                color: #173c77;
                background: #f3f7ff;
            }

            .section {
                margin-top: 16px;
            }

            .section-title {
                margin-bottom: 7px;
                color: #64748b;
                font-size: 9px;
                font-weight: 700;
                text-transform: uppercase;
            }

            table {
                width: 100%;
                border-collapse: collapse;
                table-layout: fixed;
            }

            th {
                padding: 9px 7px;
                border: 1px solid #203d63;
                color: #fff;
                background: #203d63;
                font-size: 9px;
                text-align: left;
            }

            td {
                padding: 8px 7px;
                border: 1px solid #d8e1ed;
                overflow-wrap: anywhere;
                vertical-align: top;
            }

            tbody tr:nth-child(even) {
                background: #f7f9fc;
            }

            .text-center {
                text-align: center;
            }

            .text-right {
                text-align: right;
            }

            .muted {
                color: #64748b;
                font-size: 9px;
            }

            .bottom-section {
                display: grid;
                grid-template-columns: 1.2fr 1fr;
                gap: 18px;
                margin-top: 14px;
                align-items: start;
            }

            .note {
                min-height: 55px;
                padding: 10px;
                border-left: 3px solid #2864ff;
                background: #f5f8fc;
                color: #334155;
                line-height: 1.6;
                overflow-wrap: anywhere;
            }

            .totals {
                width: 100%;
                border-collapse: collapse;
            }

            .totals td {
                padding: 7px 9px;
                border: 0;
                border-bottom: 1px solid #dce4ef;
            }

            .totals .grand-total td {
                color: #fff;
                background: #203d63;
                font-size: 12px;
                font-weight: 700;
            }

            .signatures {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                gap: 18px;
                margin-top: 36px;
                page-break-inside: avoid;
            }

            .signature {
                text-align: center;
            }

            .signature-title {
                margin-bottom: 44px;
                font-weight: 700;
            }

            .signature-line {
                height: 1px;
                border-bottom: 1px solid #64748b;
            }

            .signature-name {
                margin-top: 5px;
                color: #64748b;
                font-size: 9px;
            }

            .footer {
                margin-top: 18px;
                padding-top: 10px;
                border-top: 1px solid #dce4ef;
                color: #94a3b8;
                font-size: 9px;
                text-align: center;
            }

            .empty {
                padding: 24px;
                color: #64748b;
                text-align: center;
            }

            @@media print {
                @@page {
                    size: A4 landscape;
                    margin: 10mm;
                }

                body {
                    padding: 0;
                    font-size: 9px;
                    -webkit-print-color-adjust: exact;
                    print-color-adjust: exact;
                }

                .toolbar {
                    display: none !important;
                }

                .header {
                    padding-bottom: 12px;
                }

                .logo {
                    font-size: 23px;
                }

                .document-title {
                    font-size: 17px;
                }

                th, td {
                    padding: 5px;
                }

                .section {
                    margin-top: 12px;
                }

                .signatures {
                    margin-top: 28px;
                }

                thead {
                    display: table-header-group;
                }

                tr {
                    page-break-inside: avoid;
                }
            }
        </style>
    </head>

    <body>
        <div class="print-container">

            <div class="toolbar">
                <button type="button" onclick="window.print()">
                    @T["Cetak"]
                </button>

                <button type="button"
                        class="back"
                        onclick="window.close()">
                    @T["Kembali"]
                </button>
            </div>

            <div class="header">
                <div class="company">
                    <h1 class="logo">ERPLITE</h1>

                    <div class="company-info">
                        Jl. Kran V No.20, RT.15/RW.3, Gn. Sahari Sel., Kec. Kemayoran,
                        Kota Jakarta Pusat, DKI Jakarta 10810<br />
                        Telp: 021-7875-2345<br />
                        Email: admin@erplite.com
                    </div>
                </div>

                <div class="document-info">
                    <h2 class="document-title">REQUEST FOR QUOTATION</h2>

                    <div class="info-row">
                        <span class="info-label">@T["Nomor"]</span>
                        <span class="info-value">
                            <span class="doc-number">@rfq.RfqNo</span>
                        </span>
                    </div>

                    <div class="info-row">
                        <span class="info-label">@T["Tanggal"]</span>
                        <span class="info-value">@Tanggal(rfq.RfqDate)</span>
                    </div>

                    <div class="info-row">
                        <span class="info-label">@T["Berlaku s/d"]</span>
                        <span class="info-value">@Tanggal(rfq.ValidUntil)</span>
                    </div>

                    <div class="info-row">
                        <span class="info-label">@T["Supplier"]</span>
                        <span class="info-value">@(rfq.SupplierName ?? "-")</span>
                    </div>

                    <div class="info-row">
                        <span class="info-label">@T["Status"]</span>
                        <span class="info-value">@statusText</span>
                    </div>
                </div>
            </div>

            <div class="section">
                <table>
                    <thead>
                        <tr>
                            <th style="width:4%" class="text-center">NO</th>
                            <th style="width:38%">@T["PRODUK"]</th>
                            <th style="width:12%" class="text-right">@T["QTY"]</th>
                            <th style="width:14%" class="text-right">@T["EST. HARGA"]</th>
                            <th style="width:16%" class="text-right">@T["HARGA PENAWARAN"]</th>
                            <th style="width:16%" class="text-right">@T["SUBTOTAL"]</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (items.Count > 0)
                        {
                            var no = 1;

                            @foreach (var item in items)
                            {
                                var quoted = item.QuotedPrice > 0;

                                <tr>
                                    <td class="text-center">@no</td>
                                    <td>
                                        @(string.IsNullOrWhiteSpace(item.ProductName) ? "-" : item.ProductName)
                                        @if (!string.IsNullOrWhiteSpace(item.Sku))
                                        {
                                            <div class="muted">@item.Sku</div>
                                        }
                                    </td>
                                    <td class="text-right">
                                        @item.Quantity.ToString("#,##0.###", culture) @item.UnitSymbol
                                    </td>
                                    <td class="text-right">
                                        @Rupiah(item.EstPrice)
                                    </td>
                                    <td class="text-right">
                                        @(quoted ? Rupiah(item.QuotedPrice) : "—")
                                    </td>
                                    <td class="text-right">
                                        @(quoted ? Rupiah(item.Quantity * item.QuotedPrice) : "—")
                                    </td>
                                </tr>

                                no++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="empty">
                                    @T["Detail barang tidak tersedia untuk RFQ ini."]
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="bottom-section">
                <div>
                    <div class="section-title">@T["Catatan"]</div>
                    <div class="note">
                        @(string.IsNullOrWhiteSpace(rfq.Note) ? "-" : rfq.Note)
                    </div>
                </div>

                <table class="totals">
                    <tr class="grand-total">
                        <td>@grandLabel</td>
                        <td class="text-right">Rp @Rupiah(grandValue)</td>
                    </tr>
                </table>
            </div>

            <div class="signatures">
                <div class="signature">
                    <div class="signature-title">@T["Dibuat oleh"]</div>
                    <div class="signature-line"></div>
                    <div class="signature-name">Administrator</div>
                </div>

                <div class="signature">
                    <div class="signature-title">@T["Supplier"]</div>
                    <div class="signature-line"></div>
                    <div class="signature-name">@T["(Nama & Tanda Tangan)"]</div>
                </div>
            </div>

            <div class="footer">
                &copy; @DateTime.Now.Year Modotz App ·
                @T["Dicetak"] @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
            </div>

        </div>
    </body>
</html>
