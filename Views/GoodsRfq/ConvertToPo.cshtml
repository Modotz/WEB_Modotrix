@model ERP.Web.ViewModels.GoodsRfqViewModel
@using ERP.Web.Models
@using System.Globalization

@{
    ViewData["Title"] = "Jadikan PO — RFQ " + Model.RfqNo;

    var culture = new CultureInfo("id-ID");
    var items = Model.Items ?? new List<GoodsRfqItemViewModel>();

    var warehouses = ViewBag.Warehouses as List<DropdownItemViewModel>
                     ?? new List<DropdownItemViewModel>();

    var total = items.Sum(i => i.Quantity * i.QuotedPrice);
    var no = 1;
}

<div class="po-create-page">

    <div class="product-page-title">
        Jadikan PO — RFQ @Model.RfqNo
    </div>

    <div class="card po-detail-card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>Jadikan PO — RFQ @Model.RfqNo</strong>

            <a asp-action="Details" asp-route-id="@Model.Id"
               class="btn btn-sm btn-secondary" title="Kembali">
                <i class="bi bi-arrow-left"></i>
            </a>
        </div>

        <div class="card-body">

            <p class="mb-3">
                Pilih gudang tujuan. Supplier &amp; harga penawaran RFQ akan disalin ke
                <strong>PO draft</strong> (masih bisa diubah saat edit/approve PO).
            </p>

            <form method="post" id="convertForm">

                <div class="row g-2 mb-3">
                    <div class="col-md-4">
                        <label class="form-label" for="WarehouseId">
                            Gudang Tujuan <span class="text-danger">*</span>
                        </label>

                        <select id="WarehouseId"
                                name="WarehouseId"
                                class="form-select"
                                required>
                            <option value="">-- Pilih --</option>

                            @foreach (var warehouse in warehouses)
                            {
                                <option value="@warehouse.Id">@warehouse.Name</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th style="width:32px">#</th>
                                <th>PRODUK</th>
                                <th class="text-end" style="width:100px">QTY</th>
                                <th class="text-end" style="width:150px">HARGA PENAWARAN</th>
                                <th class="text-end" style="width:140px">SUBTOTAL</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (items.Any())
                            {
                                foreach (var item in items)
                                {
                                    <tr>
                                        <td>@no</td>
                                        <td>
                                            @(string.IsNullOrWhiteSpace(item.ProductName) ? "-" : item.ProductName)
                                            @if (!string.IsNullOrWhiteSpace(item.Sku))
                                            {
                                                <span class="text-muted">— @item.Sku</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            @item.Quantity.ToString("0.##", culture)
                                            <span class="text-muted">@item.UnitSymbol</span>
                                        </td>
                                        <td class="text-end">
                                            @item.QuotedPrice.ToString("N0", culture)
                                        </td>
                                        <td class="text-end">
                                            @((item.Quantity * item.QuotedPrice).ToString("N0", culture))
                                        </td>
                                    </tr>

                                    no++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-3">
                                        Belum ada item.
                                    </td>
                                </tr>
                            }
                        </tbody>

                        <tfoot>
                            <tr>
                                <td colspan="4" class="text-end border-0">
                                    <strong>Total</strong>
                                </td>
                                <td class="text-end border-0">
                                    <strong>@total.ToString("N0", culture)</strong>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <div class="po-summary-wrap">
                    <div class="po-form-actions">

                        @* Tombol belum aktif: penyimpanan PO dibuat pada tahap berikutnya *@
                        <button type="submit"
                                class="btn btn-success"
                                disabled
                                title="Belum tersedia">
                            <i class="bi bi-arrow-right-circle"></i> Buat PO
                        </button>

                        <a asp-action="Details" asp-route-id="@Model.Id"
                           class="btn btn-secondary">
                            Batal
                        </a>
                    </div>
                </div>

            </form>
        </div>
    </div>
</div>
