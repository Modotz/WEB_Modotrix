@model ERP.Web.Models.ForgotPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = T["Lupa Password"];
    ViewData["Heading"] = T["Lupa password?"];
}

<p class="auth-help">
    @T["Masukkan email akun Anda. Kami akan mengirim tautan untuk membuat password baru."]
</p>

<form asp-action="ForgotPassword" asp-controller="Account" method="post" novalidate data-submit-text="@T["Mengirim..."]">
    <div class="mb-4">
        <label asp-for="Email" class="form-label">Email</label>
        <input asp-for="Email" class="form-control" placeholder="name@example.com" autocomplete="email" required autofocus />
        <span asp-validation-for="Email" class="field-error"></span>
    </div>

    <button type="submit" class="btn btn-submit">@T["Kirim tautan reset"]</button>
</form>

<div class="auth-footer">
    <a asp-action="Login"><i class="bi bi-arrow-left me-1"></i>@T["Kembali ke login"]</a>
</div>
