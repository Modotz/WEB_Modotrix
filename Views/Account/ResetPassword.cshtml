@model ERP.Web.Models.ResetPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = T["Reset Password"];
    ViewData["Heading"] = T["Buat password baru"];
}

<form asp-action="ResetPassword" asp-controller="Account" method="post" novalidate data-submit-text="@T["Menyimpan..."]">
    <input type="hidden" asp-for="Token" />

    <div class="mb-3">
        <label asp-for="Password" class="form-label">@T["Password baru"]</label>
        <div class="input-group">
            <input asp-for="Password" class="form-control" placeholder="@T["Minimal 6 karakter"]" autocomplete="new-password" required autofocus />
            <button class="btn btn-outline-secondary" type="button" data-toggle-password="Password" tabindex="-1" aria-label="@T["Tampilkan/sembunyikan password"]">
                <i class="bi bi-eye"></i>
            </button>
        </div>
        <span asp-validation-for="Password" class="field-error"></span>
    </div>

    <div class="mb-4">
        <label asp-for="PasswordConfirm" class="form-label">@T["Konfirmasi password"]</label>
        <input asp-for="PasswordConfirm" class="form-control" placeholder="@T["Ulangi password baru"]" autocomplete="new-password" required />
        <span asp-validation-for="PasswordConfirm" class="field-error"></span>
    </div>

    <button type="submit" class="btn btn-submit">@T["Simpan password"]</button>
</form>

<div class="auth-footer">
    <a asp-action="Login"><i class="bi bi-arrow-left me-1"></i>@T["Kembali ke login"]</a>
</div>
