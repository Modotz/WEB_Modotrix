@* Layout halaman autentikasi (login, lupa password, reset password). *@
@inject ERP.Web.Services.BrandingService Branding
@{
    var branding = await Branding.GetAsync();
}
<!DOCTYPE html>
<html lang="@T.Lang">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@branding.AppName - @ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body>

    <div class="login-card">
        <div class="text-center">
            <div class="brand-logo">
                <svg class="logo-icon" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M20 5L32 12V28L20 35L8 28V12L20 5Z" stroke="#38bdf8" stroke-width="3" stroke-linejoin="round" />
                    <path d="M20 12L28 16.5V25.5L20 30L12 25.5V16.5L20 12Z" fill="#2563eb" />
                </svg>
                <span class="brand-title">@branding.AppName</span>
            </div>
            <div class="brand-subtitle">Enterprise Resources Planning</div>
            <h1 class="card-title-main">@ViewData["Heading"]</h1>
        </div>

        <div class="text-center small mb-3 auth-lang">
            <i class="bi bi-translate me-1"></i>
            <a href="@Url.Action("Set", "Language", new { lang = "id", returnUrl = Context.Request.Path + Context.Request.QueryString })"
               class="text-decoration-none @(T.IsEnglish ? "text-secondary" : "fw-semibold")" title="Bahasa Indonesia">ID</a>
            <span class="text-secondary mx-1">|</span>
            <a href="@Url.Action("Set", "Language", new { lang = "en", returnUrl = Context.Request.Path + Context.Request.QueryString })"
               class="text-decoration-none @(T.IsEnglish ? "fw-semibold" : "text-secondary")" title="English">EN</a>
        </div>

        @if (ViewData["Error"] is string error && error.Length > 0)
        {
            <div class="login-alert login-alert-error"><i class="bi bi-exclamation-circle me-1"></i>@T[error]</div>
        }
        else if (TempData["Success"] is string success)
        {
            <div class="login-alert login-alert-success"><i class="bi bi-check-circle me-1"></i>@T[success]</div>
        }

        @RenderBody()
    </div>

    <script>
        // Tombol mata: tampilkan/sembunyikan isi input password.
        document.querySelectorAll('[data-toggle-password]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                const input = document.getElementById(btn.dataset.togglePassword);
                const icon = btn.querySelector('i');
                const show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                icon.classList.toggle('bi-eye', !show);
                icon.classList.toggle('bi-eye-slash', show);
            });
        });

        // Cegah submit ganda.
        document.querySelectorAll('form[data-submit-text]').forEach(function (form) {
            form.addEventListener('submit', function () {
                const btn = form.querySelector('.btn-submit');
                btn.innerText = form.dataset.submitText;
                btn.disabled = true;
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
