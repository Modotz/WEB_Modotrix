@model ERP.Web.Models.PriceListViewModel

@{
    ViewData["Title"] = "Edit Price List";

    var items = ViewBag.Items as List<ERP.Web.Models.PriceListItemViewModel>
                ?? new List<ERP.Web.Models.PriceListItemViewModel>();

    var products = ViewBag.Products as List<ERP.Web.Models.ProductViewModel>
                   ?? new List<ERP.Web.Models.ProductViewModel>();

    // Opsi filter diambil dari item yang sudah ada di list
    var categories = items.Select(i => i.CategoryName).Where(x => !string.IsNullOrEmpty(x)).Distinct().OrderBy(x => x).ToList();
    var brands     = items.Select(i => i.BrandName).Where(x => !string.IsNullOrEmpty(x)).Distinct().OrderBy(x => x).ToList();
    var types      = items.Select(i => i.ProductType).Where(x => !string.IsNullOrEmpty(x)).Distinct().OrderBy(x => x).ToList();
}

@* CSS tambahan: hanya untuk yang belum ada di Index Price List *@
<style>

/* Semua kotak di halaman Edit: tinggi seragam, sedikit lebih besar dari "sm" */
.pl-edit .form-control,
.pl-edit .form-select,
.pl-edit .input-group-text {
    height: 27px;
    min-height: 27px;
    padding-top: 3px;
    padding-bottom: 3px;
    font-size: 12px;
}

/* Tombol Tambah / Reset / Tambahkan Semua ikut tinggi yang sama */
.pl-edit #btnAddProduct,
.pl-edit #btnResetFilter,
.pl-edit #btnAddAll {
    height: 27px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}
    .pl-filter-bar {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr 1fr auto;
        gap: .5rem;
        margin-bottom: 1rem;
    }

    @@media (max-width: 991.98px) {
        .pl-filter-bar { grid-template-columns: 1fr 1fr; }
    }

    .pl-switch-row { min-height: 31px; }

    .pl-edit .input-group-text.pl-rp {
    background-color: #0b1220 !important;  /* samakan dengan warna kotak input */
    color: #fff;
    border: 1px solid transparent !important;
    border-right: 0 !important;
   }

   .pl-edit .pl-btn-cancel,
   .pl-edit .pl-btn-cancel:focus {
      background-color: #64748b !important;
      border-color: #64748b !important;
      color: #fff !important;
   }

  .pl-edit .pl-btn-cancel:hover {
    background-color: #55657a !important;
    border-color: #55657a !important;
   }

.pl-price-group { min-width: 200px; }

/* Switch "Incl. PPN" kondisi mati: warna sama dengan background kotak input */
.pl-edit .form-switch .form-check-input:not(:checked) {
    background-color: #0b1220 !important;
    border-color: var(--bs-border-color, #2b3548) !important;
}

/* Tombol ceklis di samping harga: warna sama dengan background kotak input */
.pl-edit .btn-save-item {
    background-color: #0b1220 !important;
    border-color: var(--bs-border-color, #2b3548) !important;
    color: #fff !important;
}

.pl-edit .btn-save-item:hover {
    background-color: #162033 !important;
}

</style>

<div class="page-heading supplier-page pl-edit">

    <h3 class="fw-bold mb-3">Edit Price List</h3>

    <!-- ================= CARD 1 : DATA PRICE LIST ================= -->
    <form asp-action="Edit" method="post" id="priceListForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Uid" />

        <div class="card supplier-card mb-4">

            <div class="card-header bg-transparent">
                <span class="fw-semibold">Edit Price List</span>
            </div>

            <div class="card-body">
                <div class="row g-3">

                    <div class="col-md-5">
                        <label asp-for="Code" class="form-label small mb-1">@T["Kode"] <span class="text-danger">*</span></label>
                        <input asp-for="Code" class="form-control form-control-sm" />
                        <span asp-validation-for="Code" class="text-danger"></span>
                    </div>

                    <div class="col-md-5">
                        <label asp-for="Name" class="form-label small mb-1">@T["Nama"] <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control form-control-sm" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="col-md-2 d-flex align-items-center">
                        <div class="form-check form-switch mt-md-4">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                            <label asp-for="IsActive" class="form-check-label">@T["Aktif"]</label>
                        </div>
                    </div>

                    <div class="col-12">
                        <label asp-for="Note" class="form-label small mb-1">@T["Catatan"]</label>
                        <input asp-for="Note" class="form-control form-control-sm" />
                    </div>

                </div>
            </div>

            <div class="card-footer bg-transparent d-flex gap-2">
                <button type="submit" class="btn btn-teal btn-custom-action">
                    <i class="bi bi-save"></i>
                    <span>@T["Simpan"]</span>
                </button>
                <a asp-action="Index" class="btn btn-danger btn-custom-action pl-btn-cancel">
                    <i class="bi bi-x-lg"></i>
                    <span>@T["Batal"]</span>
                </a>
            </div>
        </div>
    </form>


    <!-- ================= CARD 2 : HARGA PRODUK ================= -->
    <div class="card supplier-card supplier-table-card">

        <div class="card-header bg-transparent d-flex justify-content-between align-items-center">

            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-tag"></i>
                <span class="fw-bold">@T["Harga Produk"]</span>
                <span class="badge badge-count">@items.Count</span>
            </div>

            <button type="button" id="btnAddAll" class="btn btn-sm btn-outline-primary">
                <i class="bi bi-plus-square me-1"></i>@T["Tambahkan Semua Produk"]
            </button>
        </div>

        <div class="card-body">

            <p class="product-filter-help mb-3">
                @T["Harga di sini menggantikan harga default; diskon kelompok tetap berlaku di atasnya."]
            </p>

            <!-- FORM TAMBAH PRODUK (satu baris sejajar) -->
            <div class="row g-3 align-items-end mb-1">

                <div class="col-lg-5">
                    <label class="form-label small mb-1" for="productSelect">@T["Produk"]</label>
                    <select id="productSelect" class="form-select form-select-sm">
                        <option value=""></option>
                        @foreach (var product in products)
                        {
                            <option value="@product.Id"
                                    data-sell-price="@(product.SellPrice?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))">
                                @product.ProductNumber - @product.Name
                            </option>
                        }
                    </select>
                </div>

                <div class="col-lg-3 col-md-6">
                    <label class="form-label small mb-1" for="productPrice">@T["Harga"]</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text pl-rp">Rp</span>
                        <input type="number" id="productPrice" class="form-control form-control-sm"
                               min="0" step="0.01" placeholder="0" />
                    </div>
                </div>

                <div class="col-lg-2 col-md-3">
                    <label class="form-label small mb-1 d-block">@T["Incl. PPN?"]</label>
                    <div class="form-check form-switch d-inline-block">
                        <input class="form-check-input ms-0 mt-0" type="checkbox" role="switch" id="productTax" />
                        <label class="form-check-label" for="productTax">@T["Termasuk PPN"]</label>
                    </div>
                </div>

                <div class="col-lg-2 col-md-3">
                    <button type="button" id="btnAddProduct" class="btn btn-sm btn-success w-100 text-nowrap">
                        <i class="bi bi-plus-lg me-1"></i>@T["Tambah"]
                    </button>
                </div>

            </div>

            <!-- Teks bantuan: di baris sendiri supaya kontrol di atas tetap sejajar -->
            <div class="row g-3 mb-4">
                <div class="col-lg-5">
                    <div class="product-filter-help">@T["Produk yang sudah ada di list tidak muncul di sini."]</div>
                </div>
                <div class="col-lg-3">
                    <div class="product-filter-help">@T["Otomatis terisi harga default saat produk dipilih (bisa diubah)."]</div>
                </div>
            </div>

            <!-- FILTER TABEL -->
            <div class="pl-filter-bar">

                <input type="text" id="filterSearch" class="form-control form-control-sm"
                       placeholder="@T["Cari No. Produk / Nama / SKU..."]" />

                <select id="filterCategory" class="form-select form-select-sm">
                    <option value="">@T["Semua Kategori"]</option>
                    @foreach (var c in categories) { <option value="@c">@c</option> }
                </select>

                <select id="filterBrand" class="form-select form-select-sm">
                    <option value="">@T["Semua Brand"]</option>
                    @foreach (var b in brands) { <option value="@b">@b</option> }
                </select>

                <select id="filterType" class="form-select form-select-sm">
                    <option value="">@T["Semua Jenis"]</option>
                    @foreach (var t in types) { <option value="@t">@t</option> }
                </select>

                <button type="button" id="btnResetFilter" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-clockwise me-1"></i>@T["Reset"]
                </button>

            </div>   

             <button type="button" id="btnDeleteSelected" class="btn btn-sm btn-danger mb-2 d-none">
                 <i class="bi bi-trash me-1"></i>@T["Hapus Terpilih"] (<span id="selectedCount">0</span>)
             </button>

            <!-- TABEL PRODUK -->
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 supplier-table" id="priceListItemsTable">
                    <thead>
                        <tr>
                        
                        <th style="width:40px;" class="text-center">
                             <input type="checkbox" class="form-check-input" id="checkAll" title="@T["Pilih semua"]" />
                         </th>
                            <th>@T["NO."]</th>
                            <th>@T["NO. PRODUK"]</th>
                            <th>@T["PRODUK"]</th>
                            <th>SKU</th>
                            <th>@T["KATEGORI"]</th>
                            <th>BRAND</th>
                            <th>@T["JENIS"]</th>
                            <th>UNIT</th>
                            <th class="text-end">COST PRICE</th>
                            <th class="text-end">SELL PRICE</th>
                            <th style="width:220px;">@T["HARGA PRICE LIST"]</th>
                            <th class="text-center">@T["INCL. PPN"]</th>
                            <th class="text-center" style="width:80px;">@T["AKSI"]</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (items.Any())
                        {
                            var no = 1;
                            foreach (var item in items)
                            {
                                <tr data-item-uid="@item.Uid"
                                    data-category="@item.CategoryName"
                                    data-brand="@item.BrandName"
                                    data-type="@item.ProductType"
                                    data-search="@($"{item.ProductNumber} {item.ProductName} {item.Sku}".ToLower())">

                                    <td class="text-center">
                                        <input type="checkbox" class="form-check-input row-check" data-uid="@item.Uid" />
                                     </td>

                                    <td class="row-no">@no</td>
                                    <td>@item.ProductNumber</td>
                                    <td class="fw-semibold">@item.ProductName</td>
                                    <td>@item.Sku</td>
                                    <td>@item.CategoryName</td>
                                    <td>@item.BrandName</td>
                                    <td>@item.ProductType</td>
                                    <td>@item.UnitName</td>
                                    <td class="text-end">@($"Rp {item.CostPrice:N0}")</td>
                                    <td class="text-end">@($"Rp {item.SellPrice:N0}")</td>

                                    <td>
                                         <div class="input-group input-group-sm pl-price-group">
                                              <span class="input-group-text pl-rp">Rp</span>
                                              <input type="number"
                                                     class="form-control item-price"
                                                     value="@item.Price.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                                     min="0" step="0.01" />
                                              <button type="button" class="btn btn-success btn-save-item"
                                                      data-uid="@item.Uid" title="@T["Simpan"]">
                                                  <i class="bi bi-check-lg"></i>
                                              </button>
                                          </div>
                                       </td>

                                    <td class="text-center">
                                        <div class="form-check form-switch d-inline-block">
                                            <input class="form-check-input item-tax" type="checkbox" role="switch"
                                                   @(item.TaxInclusive == true ? "checked" : "") />
                                        </div>
                                    </td>

                                    <td class="text-center">
                                        <div class="row-actions">

                                            <button type="button" class="act-btn act-delete btn-delete-item"
                                                    data-uid="@item.Uid" title="@T["Hapus"]">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                no++;
                            }
                        }

                        <tr id="emptyRow" class="@(items.Any() ? "d-none" : "")">
                            <td colspan="14" class="text-center py-4">
                                <span class="menu-description">@T["Belum ada produk dalam Price List."]</span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

        </div>
    </div>

</div>

<div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="confirmModalTitle">@T["Konfirmasi"]</h5>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body" id="confirmModalBody"></div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@T["Batal"]</button>
                <button type="button" class="btn btn-danger" id="confirmModalOk">@T["Ya"]</button>
            </div>

        </div>
    </div>
</div>


@section Scripts {

    <script>
        // Identitas price list memakai uid (bukan id angka)
        const priceListUid = "@Model.Uid";

        const getToken = () =>
            document.querySelector('input[name="__RequestVerificationToken"]').value;

        async function postJson(url, data) {
            return fetch(url, {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "RequestVerificationToken": getToken()
                },
                body: JSON.stringify(data)
            });
        }

        // ---------- MODAL KONFIRMASI (Bootstrap) ----------
const confirmModalEl = document.getElementById("confirmModal");
const confirmModal = new bootstrap.Modal(confirmModalEl);

function confirmDialog(message, okText = @Json.Serialize(T["Ya"]), okClass = "btn-danger") {
    return new Promise(resolve => {
        document.getElementById("confirmModalBody").textContent = message;

        const okBtn = document.getElementById("confirmModalOk");
        okBtn.textContent = okText;
        okBtn.className = "btn " + okClass;

        let confirmed = false;

        const onOk = () => { confirmed = true; confirmModal.hide(); };
        const onHidden = () => {
            okBtn.removeEventListener("click", onOk);
            confirmModalEl.removeEventListener("hidden.bs.modal", onHidden);
            resolve(confirmed);
        };

        okBtn.addEventListener("click", onOk);
        confirmModalEl.addEventListener("hidden.bs.modal", onHidden);
        confirmModal.show();
    });
}

        // ---------- PILIH PRODUK -> isi harga default ----------
        document.getElementById("productSelect").addEventListener("change", function () {
            const opt = this.options[this.selectedIndex];
            document.getElementById("productPrice").value =
                opt && opt.value ? (opt.dataset.sellPrice || 0) : "";
        });

        // ---------- TAMBAH PRODUK ----------
        document.getElementById("btnAddProduct").addEventListener("click", async function () {
            const productId = document.getElementById("productSelect").value;
            const price = document.getElementById("productPrice").value;

            if (!productId) { alert(@Json.Serialize(T["Silakan pilih produk."])); return; }
            if (price === "" || Number(price) < 0) { alert(@Json.Serialize(T["Harga belum diisi."])); return; }

            const res = await postJson("/PriceLists/AddItem", {
                priceListUid: priceListUid,
                productId: Number(productId),
                price: Number(price),
                taxInclusive: document.getElementById("productTax").checked
            });

            if (!res.ok) { alert(await res.text()); return; }
            location.reload();
        });

        // ---------- TAMBAHKAN SEMUA PRODUK ----------
        document.getElementById("btnAddAll").addEventListener("click", async function () {

        const ok = await confirmDialog(
          @Json.Serialize(T["Tambahkan SEMUA produk yang belum ada ke price list ini (dengan harga default)?"]));

        if (!ok) return;

        const res = await postJson("/PriceLists/AddAllItems", { priceListUid: priceListUid });

        if (!res.ok) { alert(await res.text()); return; }
         location.reload();
     });

        // ---------- SIMPAN PERUBAHAN BARIS ----------
        document.querySelectorAll(".btn-save-item").forEach(btn => {
            btn.addEventListener("click", async function () {
                const row = this.closest("tr");

                const res = await postJson("/PriceLists/UpdateItem", {
                    uid: this.dataset.uid,
                    price: Number(row.querySelector(".item-price").value),
                    taxInclusive: row.querySelector(".item-tax").checked
                });

                alert(res.ok ? @Json.Serialize(T["Harga berhasil diubah."]) : @Json.Serialize(T["Gagal mengubah harga."]));
            });
        });

        // ---------- HAPUS BARIS ----------
        document.querySelectorAll(".btn-delete-item").forEach(btn => {
         btn.addEventListener("click", async function () {

        const ok = await confirmDialog(@Json.Serialize(T["Hapus produk ini dari Price List?"]));
        if (!ok) return;

        const res = await postJson("/PriceLists/DeleteItem", { uid: this.dataset.uid });

        if (!res.ok) { alert(@Json.Serialize(T["Gagal menghapus produk."])); return; }
        location.reload();
      });
    });

        // ---------- FILTER TABEL (client-side) ----------
        const fSearch = document.getElementById("filterSearch");
        const fCat    = document.getElementById("filterCategory");
        const fBrand  = document.getElementById("filterBrand");
        const fType   = document.getElementById("filterType");

        function applyFilter() {
            const q = fSearch.value.trim().toLowerCase();
            let visible = 0;

            document.querySelectorAll("#priceListItemsTable tbody tr[data-item-uid]").forEach(tr => {
                const ok =
                    (!q || tr.dataset.search.includes(q)) &&
                    (!fCat.value   || tr.dataset.category === fCat.value) &&
                    (!fBrand.value || tr.dataset.brand === fBrand.value) &&
                    (!fType.value  || tr.dataset.type === fType.value);

                tr.classList.toggle("d-none", !ok);
                if (ok) tr.querySelector(".row-no").textContent = ++visible;
            });

            document.getElementById("emptyRow")
                .classList.toggle("d-none", visible > 0);
        }

        [fSearch, fCat, fBrand, fType].forEach(el => {
            el.addEventListener(el.tagName === "INPUT" ? "input" : "change", applyFilter);
        });

        document.getElementById("btnResetFilter").addEventListener("click", () => {
            fSearch.value = fCat.value = fBrand.value = fType.value = "";
            applyFilter();
        });

 // ---------- CHECKBOX & HAPUS TERPILIH ----------
    const checkAll = document.getElementById("checkAll");
    const btnDeleteSelected = document.getElementById("btnDeleteSelected");
    const selectedCount = document.getElementById("selectedCount");

    function refreshSelection() {
        const all = [...document.querySelectorAll("#priceListItemsTable .row-check")];
        const checked = all.filter(c => c.checked);

    selectedCount.textContent = checked.length;
    btnDeleteSelected.classList.toggle("d-none", checked.length === 0);

    checkAll.checked = all.length > 0 && checked.length === all.length;
    checkAll.indeterminate = checked.length > 0 && checked.length < all.length;
  }

  checkAll.addEventListener("change", function () {
     document
        .querySelectorAll("#priceListItemsTable tbody tr[data-item-uid]:not(.d-none) .row-check")
        .forEach(c => c.checked = this.checked);
    refreshSelection();
   });

  document.querySelector("#priceListItemsTable tbody").addEventListener("change", function (e) {
    if (e.target.classList.contains("row-check")) refreshSelection();
 });

btnDeleteSelected.addEventListener("click", async function () {
    const uids = [...document.querySelectorAll("#priceListItemsTable .row-check:checked")]
        .map(c => c.dataset.uid);

    if (uids.length === 0) return;

    const ok = await confirmDialog(@(Json.Serialize(T["Hapus {0} produk dari Price List?"])).replace('{0}', uids.length));
    if (!ok) return;

    const res = await postJson("/PriceLists/DeleteItems", { uids: uids });

    if (!res.ok) { alert(await res.text()); return; }
    location.reload();
});

    </script>
}
