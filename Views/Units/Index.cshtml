@using ERP.Web.Models
@model PagedResult<UnitViewModel>

@{
    ViewData["Title"] = "Unit";

    var no = ((Model.Page - 1) * Model.PageSize);
}
<div class="attribute-page">
  <h3 class="fw-bold mb-4">Unit</h3>
    <!-- FILTER -->
    <div class="card attribute-filter-card">

        <div class="attribute-filter-header">
            <strong>
                <i class="bi bi-funnel me-1"></i>
                @T["Filter"]
            </strong>
            <i class="bi bi-chevron-down"></i>
        </div>

        <div class="attribute-filter-body">
            <form method="get" asp-action="Index">
                <div class="row g-2 align-items-end">

                    <!-- SEARCH -->
                    <div class="col-md-4">
                        <label class="form-label">
                            @T["Cari"]
                        </label>

                        <input type="text"
                               name="search"
                               value="@ViewBag.Search"
                               class="form-control"/>
                    </div>

                    <!-- PER HALAMAN -->
                    <div class="col-md-2">
                        <label class="form-label">
                            @T["Per Halaman"]
                        </label>

                        <select name="pageSize" class="form-select">
                            <option value="10" selected="@(Model.PageSize == 10 ? "selected" : null)">10</option>
                            <option value="25" selected="@(Model.PageSize == 25 ? "selected" : null)">25</option>
                            <option value="50" selected="@(Model.PageSize == 50 ? "selected" : null)">50</option>
                            <option value="100" selected="@(Model.PageSize == 100 ? "selected" : null)">100</option>
                        </select>
                    </div>

                    <!-- BUTTON -->
                    <div class="col-md-3">
                        <div class="attribute-filter-actions">

                            <button type="submit"
                                    class="btn attribute-apply-btn">
                                <i class="bi bi-search me-1"></i>
                                @T["Terapkan"]
                            </button>

                            <a asp-action="Index"
                               class="btn attribute-reset-btn"
                               title="@T["Reset"]">
                                <i class="bi bi-arrow-counterclockwise"></i>
                            </a>

                        </div>
                    </div>

                </div>

            </form>

        </div>
    </div>
 
<!-- Data Table Card -->
<div class="card unit-card">

    <!-- HEADER -->
    <div class="card-header bg-transparent d-flex justify-content-between align-items-center py-3">

        <div class="d-flex align-items-center gap-2">

            <span class="fw-bold fs-5">@T["Satuan"]</span>

            <span class="badge badge-count">
                @Model.TotalCount
            </span>

            <span class="menu-description small ms-1">
                @T["Kelola satuan produk"]
            </span>

        </div>

        <div class="d-flex align-items-center gap-2">

            <!-- Export PDF -->
            <a asp-action="ExportPdf"
               asp-controller="Units"
               class="btn btn-light btn-custom-square text-danger"
               title="Export PDF">

                <i class="bi bi-file-earmark-pdf-fill"></i>

            </a>

            <!-- Export Excel -->
            <a asp-action="ExportExcel"
               asp-controller="Units"
               class="btn btn-light btn-custom-square text-success"
               title="Export Excel">

                <i class="bi bi-file-earmark-excel-fill"></i>

            </a>

            <!-- Print -->
            <a asp-action="Print"
               asp-controller="Units"
               class="btn btn-light btn-custom-square text-secondary"
               title="@T["Cetak"]"
               target="_blank">

                <i class="bi bi-printer-fill"></i>

            </a>

            <!-- Refresh Data -->
            <button type="button"
                    class="btn btn-light btn-custom-square"
                    title="Refresh Data"
                    onclick="loadUnits()">

                <i class="bi bi-arrow-clockwise"></i>

            </button>

            <!-- Expand / Collapse -->
            <button type="button"
                    class="btn btn-light btn-custom-square"
                    title="Toggle">

                <i class="bi bi-chevron-up"></i>

            </button>

            <!-- Tambah Unit -->
            <button data-perm="create" type="button"
                    class="btn btn-teal btn-custom-action"
                    id="btnAddUnit"
                    onclick="openCreateModal()">

                <i class="bi bi-plus-circle"></i>
                <span>@T["Tambah Satuan"]</span>

            </button>

        </div>

    </div>

    <!-- TABLE BODY -->
    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead>
                    <tr>
                        <th class="ps-4" style="width: 50px;">#</th>
                        <th style="width: 100px;">CODE</th>
                        <th style="width: 215px;">NAME</th>
                        <th style="width: 100px;">@T["SIMBOL"]</th>
                        <th>@T["DESKRIPSI"]</th>
                        <th class="text-center" style="width: 110px;">@T["AKSI"]</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Data != null && Model.Data.Any())
                    {
                        foreach (var item in Model.Data)
                        {
                            <tr>

                                <td class="ps-4">
                                    @(++no)
                                </td>

                                <td>
                                    @item.Code
                                </td>

                                <td>
                                    @item.Name
                                </td>

                                <td>
                                    @item.Symbol
                                </td>

                                <td>
                                    @item.Description
                                </td>

                                <td class="text-center">
                                    <div class="row-actions">

                                        <button data-perm="update" type="button"
                                                class="act-btn act-edit"
                                                title="@T["Edit"]"
                                                onclick="openEditModal(
                                                    '@item.Uid',
                                                    '@item.Code',
                                                    '@item.Name',
                                                    '@item.Symbol',
                                                    '@item.Description'
                                                )">

                                            <i class="bi bi-pencil"></i>

                                        </button>

                                        <form data-perm="delete" method="post"
                                              asp-action="Delete"
                                              class="d-inline"
                                              onsubmit="return confirmDeleteUnit();">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="uid"
                                                   value="@item.Uid" />

                                            <button type="submit"
                                                    class="act-btn act-delete"
                                                    title="@T["Nonaktifkan"]">

                                                <i class="bi bi-trash"></i>

                                            </button>

                                        </form>
                                        @* <button type="button"
                                                class="act-btn act-delete"
                                                title="Hapus"
                                                onclick="confirmDeleteUnit('@item.Uid')">

                                            <i class="bi bi-trash"></i>

                                        </button>*@

                                    </div>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4">
                                <p class="menu-description mb-0">
                                    @T["Belum ada data satuan."]
                                </p>
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <!-- FOOTER / PAGINATION -->
        <div class="card-footer bg-transparent border-top-0 d-flex justify-content-between align-items-center py-3">

            @{
                var startItem = Model.TotalCount == 0
                    ? 0
                    : ((Model.Page - 1) * Model.PageSize) + 1;

                var endItem = Math.Min(
                    Model.Page * Model.PageSize,
                    Model.TotalCount
                );
            }

            <span class="menu-description small">
                @T["Menampilkan"]
                <strong>@startItem – @endItem</strong>
                @T["dari"]
                <strong>@Model.TotalCount</strong>
                @T["data"]
            </span>

            @{
                var currentPage = Model.Page;
                var totalPages = Model.TotalPage;
            }

            <nav aria-label="Pagination">

                <ul class="pagination">

                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">

                        <a class="page-link"
                           href="@Url.Action("Index", new {
                               page = currentPage - 1,
                               pageSize = Model.PageSize
                           })">

                            @T["Sebelumnya"]

                        </a>

                    </li>

                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">

                            <a class="page-link"
                               href="@Url.Action("Index", new {
                                   page = i,
                                   pageSize = Model.PageSize
                               })">

                                @i

                            </a>

                        </li>
                    }

                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">

                        <a class="page-link"
                           href="@Url.Action("Index", new {
                               page = currentPage + 1,
                               pageSize = Model.PageSize
                           })">

                            @T["Berikutnya"]

                        </a>

                    </li>

                </ul>

            </nav>

        </div>

    </div>
   <div class="modal fade" id="unitModal" tabindex="-1" aria-labelledby="modalTitle" aria-hidden="true"> 
    <div class="modal-dialog modal-dialog-centered modal-lg"> 
        <div class="modal-content menu-modal-content"> 
            <form method="post" id="unitForm"> 
                @Html.AntiForgeryToken() 

                <!-- HEADER -->
                <div class="modal-header menu-modal-header"> 
                    <h5 class="modal-title fw-semibold menu-modal-title" id="modalTitle">@T["Tambah Unit"]</h5> 
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button> 
                </div> 

                <!-- BODY -->
                <div class="modal-body py-3"> 
                    <input type="hidden" id="Uid" name="Uid" disabled />

                    <div class="row g-3"> 
                        <!-- CODE -->
                        <div class="col-12"> 
                            <label for="Code" class="form-label fw-medium">
                                Code <span class="text-danger">*</span>
                            </label> 
                            <input type="text" class="form-control bg-transparent text-white border-secondary" id="Code" name="Code" required /> 
                        </div> 

                        <!-- NAME -->
                        <div class="col-12"> 
                            <label for="Name" class="form-label fw-medium">
                                Name <span class="text-danger">*</span>
                            </label> 
                            <input type="text" class="form-control bg-transparent text-white border-secondary" id="Name" name="Name" required /> 
                        </div> 

                        <!-- SYMBOL -->
                        <div class="col-12"> 
                            <label for="Symbol" class="form-label fw-medium">@T["Simbol"]</label> 
                            <input type="text" class="form-control bg-transparent text-white border-secondary" id="Symbol" name="Symbol" placeholder="@T["mis. kg, cm, m³, pcs"]" /> 
                        </div> 

                        <!-- DESCRIPTION -->
                        <div class="col-12"> 
                            <label for="Description" class="form-label fw-medium">@T["Deskripsi"]</label> 
                            <textarea class="form-control bg-transparent text-white border-secondary" id="Description" name="Description" rows="3" placeholder="@T["Keterangan satuan (opsional)"]"></textarea> 
                        </div> 
                    </div> 
                </div> 

                <!-- FOOTER -->
                <div class="modal-footer menu-modal-footer"> 
                    <button type="submit" class="btn btn-primary px-3"> 
                        <i class="bi bi-box-arrow-down me-2"></i>@T["Simpan"] 
                    </button> 
                    <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal"> 
                        @T["Batal"] 
                    </button> 
                </div> 
            </form> 
        </div> 
    </div> 
</div>
  </div>

  @* modal-delete *@
  <div class="modal fade" id="deleteConfirmModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content delete-modal">

            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-trash3 me-2"></i>
                    @T["Konfirmasi Hapus"]
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">

                <div id="deleteWarning"
                     class="alert alert-warning d-none">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <span id="deleteWarningMessage"></span>
                </div>

                <p id="deleteConfirmMessage"
                   class="mb-0">
                    @T["Apakah Anda yakin ingin menghapus data ini?"]
                </p>

                <div id="deleteRelations"
                     class="mt-3 d-none">
                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    @T["Batal"]
                </button>

                <button type="button"
                        id="btnConfirmDelete"
                        class="btn btn-danger">
                    <i class="bi bi-trash3 me-1"></i>
                    @T["Hapus"]
                </button>

            </div>

        </div>
    </div>
</div>



@section Scripts {
    <script>
        const unitModal = new bootstrap.Modal(
            document.getElementById('unitModal')
        );

        function loadUnits() {
            location.reload();
         }
         
        //create
        function openCreateModal() {

            document.getElementById('modalTitle').innerText = @Json.Serialize(T["Tambah Unit"]);
            document.getElementById('unitForm').action = '@Url.Action("Create", "Units")';
            const idInput = document.getElementById('Uid');

            idInput.value = '';
            idInput.disabled = true;
            // document.getElementById('Id').value = '';
            document.getElementById('Code').value = '';
            document.getElementById('Name').value = '';
            document.getElementById('Symbol').value = '';
            document.getElementById('Description').value = '';
            unitModal.show();
        }


        // edit
        function openEditModal(
            uid,
            code,
            name,
            symbol,
            description
        ) {

            document.getElementById('modalTitle').innerText = 'Edit Unit';
            document.getElementById('unitForm').action = '@Url.Action("Edit", "Units")';
            const idInput = document.getElementById('Uid');

            idInput.value = uid;
            idInput.disabled = false;
            // document.getElementById('Id').value = id;
            document.getElementById('Code').value = code || '';
            document.getElementById('Name').value = name || '';
            document.getElementById('Symbol').value = symbol || '';
            document.getElementById('Description').value = description || '';
            unitModal.show();
        }


        // soft-delete
        // function confirmDeleteUnit() {

        //     return confirm(
        //         "Hapus satuan ini?"
        //     );
        // }

        let deleteId = null;

        // Catatan: belum dipanggil di mana pun, dan endpoint cek relasi di Web belum ada.
        async function confirmDelete(uid) {

        deleteId = id;

        const warning = document.getElementById("deleteWarning");
        const warningMessage = document.getElementById("deleteWarningMessage");
        const confirmMessage = document.getElementById("deleteConfirmMessage");
        const relations = document.getElementById("deleteRelations");

        // Reset
        warning.classList.add("d-none");
        relations.classList.add("d-none");

        confirmMessage.textContent =
            @Json.Serialize(T["Apakah Anda yakin ingin menghapus data ini?"]);

        try {

            const response = await fetch(
                `/Products/DeleteCheck?uid=${encodeURIComponent(uid)}`
            );

            if (!response.ok) {
                throw new Error(@Json.Serialize(T["Gagal memeriksa relasi data."]));
            }

            const result = await response.json();

            if (result.hasRelation) {

                confirmMessage.textContent =
                    @Json.Serialize(T["Data ini masih digunakan oleh data lain. Apakah Anda tetap ingin menghapusnya?"]);

                warningMessage.textContent =
                    result.message ||
                    @Json.Serialize(T["Data ini memiliki relasi dengan data lain."]);

                warning.classList.remove("d-none");

                if (result.relations &&
                    result.relations.length > 0) {

                    relations.innerHTML = `
                        <strong>${@Json.Serialize(T["Digunakan oleh:"])}</strong>
                        <ul class="mb-0 mt-2">
                            ${result.relations
                                .map(x => `<li>${x}</li>`)
                                .join("")}
                        </ul>
                    `;

                    relations.classList.remove("d-none");
                }
            }

            const modal =
                new bootstrap.Modal(
                    document.getElementById("deleteConfirmModal")
                );

            modal.show();

            } catch (error) {

                console.error(error);

                // Tetap gunakan Bootstrap UI,
                // bukan alert()
                warningMessage.textContent =
                    @Json.Serialize(T["Gagal memeriksa penggunaan data."]);

                warning.classList.remove("d-none");

                const modal =
                    new bootstrap.Modal(
                        document.getElementById("deleteConfirmModal")
                    );

                modal.show();
            }
        }

    </script>
}



