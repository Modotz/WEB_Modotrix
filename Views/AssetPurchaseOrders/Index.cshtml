@model ERP.Web.Models.AssetPurchaseIndexViewModel<ERP.Web.Models.AssetPurchaseOrderViewModel>
@{
    ViewData["Title"] = T["PO Aset"];
    var f = Model.Filter;
    var list = Model.Rows;
    var query = f.ToQueryString();
    var qs = query.Length > 0 ? "?" + query : "";
    var header = new ListHeaderModel
    {
        Title = T["Purchase Order Aset"],
        Count = list.TotalCount,
        Description = T["Daftar pesanan pembelian aset, persetujuan & penerimaan"],
        PdfUrl = Url.Action("ExportPdf") + qs,
        ExcelUrl = Url.Action("ExportExcel") + qs,
        PrintUrl = Url.Action("PrintList") + qs,
        AddUrl = Url.Action("Create"),
        AddText = T["Tambah PO Aset"]
    };
    string PageUrl(int p) => Url.Action("Index") + "?" + (query.Length > 0 ? query + "&" : "") + $"page={p}&pageSize={f.PageSize}";
}

<div class="page-heading supplier-page">

    <h3 class="fw-bold mb-3">@T["PO Aset"]</h3>

    <!-- FILTER CARD -->
    <div class="card supplier-card supplier-filter">
        <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-funnel"></i>
                <span class="fw-semibold">@T["Filter"]</span>
            </div>
            <button class="btn btn-sm text-muted p-0" type="button" data-bs-toggle="collapse" data-bs-target="#filterCollapse" aria-expanded="true" aria-controls="filterCollapse">
                <i class="bi bi-chevron-down"></i>
            </button>
        </div>
        <div class="collapse show" id="filterCollapse">
            <div class="card-body">
                <form method="get" asp-action="Index" class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label" for="q">@T["Cari"]</label>
                        <input type="text" class="form-control" id="q" name="q" value="@f.Q" placeholder="@T["No. PO, catatan"]" />
                    </div>
                    <div class="col-md">
                        <label class="form-label" for="supplierUid">@T["Supplier"]</label>
                        <select class="form-select" id="supplierUid" name="supplierUid">
                            <option value="">@T["Semua"]</option>
                            @foreach (var s in Model.Suppliers)
                            {
                                <option value="@s.Uid" selected="@(s.Uid == f.SupplierUid)">@s.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md">
                        <label class="form-label" for="status">@T["Status"]</label>
                        <select class="form-select" id="status" name="status">
                            <option value="">@T["Semua"]</option>
                            @foreach (var (value, label) in AssetPurchaseLabels.OrderStatuses)
                            {
                                <option value="@value" selected="@(value == f.Status)">@T[label]</option>
                            }
                        </select>
                    </div>
                    <div class="col-md">
                        <label class="form-label" for="pageSize">@T["Per Halaman"]</label>
                        <select class="form-select" id="pageSize" name="pageSize">
                            @foreach (var size in new[] { 10, 25, 50, 100 })
                            {
                                <option value="@size" selected="@(f.PageSize == size)">@size</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-auto d-flex gap-2">
                        <button type="submit" class="btn btn-primary d-flex align-items-center gap-2">
                            <i class="bi bi-search"></i>
                            @T["Terapkan"]
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary" title="@T["Reset Filter"]">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- DATA TABLE CARD -->
    <div class="card supplier-card supplier-table-card">
        <partial name="_ListHeader" model="header" />

        <div class="collapse show" id="listBody">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 supplier-table first-left">
                <thead>
                    <tr>
                        <th class="ps-4 text-start">@T["NO. PO"]</th>
                        <th>@T["TANGGAL"]</th>
                        <th>@T["SUPPLIER"]</th>
                        <th>@T["ASAL"]</th>
                        <th class="text-end">@T["DITERIMA"]</th>
                        <th class="text-end">@T["TOTAL"]</th>
                        <th>@T["STATUS"]</th>
                        <th class="text-center" style="width: 70px;">@T["AKSI"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (list.Data.Count == 0)
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">@T["Belum ada PO Aset."]</td></tr>
                    }
                    @foreach (var o in list.Data)
                    {
                        <tr>
                            <td class="ps-4 text-start"><a asp-action="Details" asp-route-uid="@o.Uid" class="text-info text-decoration-none">@o.ApoNo</a></td>
                            <td class="text-white small">@Acc.Date(o.ApoDate)</td>
                            <td class="text-white">@(o.SupplierName ?? "-")</td>
                            <td class="text-white small">@(o.Rfq?.No ?? o.Request?.No ?? "-")</td>
                            <td class="text-end text-white">@o.UnitsReceived / @o.UnitsOrdered</td>
                            <td class="text-end text-white">@Acc.Money(o.TotalAmount)</td>
                            <td>
                                <span class="badge @AssetPurchaseLabels.Css(o.Status)">@T[AssetPurchaseLabels.Label(AssetPurchaseLabels.OrderStatuses, o.Status)]</span>
                                @if (o.CancelPending)
                                {
                                    <span class="badge bg-warning text-dark">@T["Pembatalan menunggu persetujuan"]</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="row-actions">
                                    <a asp-action="Details" asp-route-uid="@o.Uid" class="act-btn act-view" title="@T["Lihat"]"><i class="bi bi-eye"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_ListPagination" model="new ListPaginationModel { Page = list.Page, PageSize = list.PageSize, TotalCount = list.TotalCount, PageUrl = PageUrl }" />
        </div>
    </div>
</div>
