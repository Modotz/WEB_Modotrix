@model ERP.Web.Models.DoubtfulReceivablesViewModel
@{
    ViewData["Title"] = T["Cadangan Kerugian Piutang"];
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var today = DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd");
}

<div class="page-heading supplier-page">

    <h3 class="fw-bold mb-3">@T["Cadangan Kerugian Piutang"]</h3>

    <form method="get" class="d-flex flex-wrap gap-2 mb-3 align-items-end">
        <div>
            <label class="form-label text-white small mb-1" for="fAsOf">@T["Per tanggal"]</label>
            <input type="date" class="form-control form-control-sm" name="asOf" id="fAsOf" value="@Model.AsOf.ToString("yyyy-MM-dd")" />
        </div>
        <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-search me-1"></i>@T["Terapkan"]</button>
        <a asp-controller="ArAging" asp-action="Index" class="btn btn-outline-info btn-sm ms-auto"><i class="bi bi-hourglass-split me-1"></i>@T["Umur Piutang"]</a>
    </form>

    <div class="row g-3 mb-3">
        <div class="col-lg-5">
            <div class="card supplier-card h-100">
                <div class="card-body py-3 px-4">
                    <div class="fw-semibold text-white mb-2">@T["Piutang bersih per {0}", Acc.Date(Model.AsOf)]</div>
                    <div class="d-flex justify-content-between small"><span class="text-white-50">1-1200 @T["Piutang Usaha"]</span><span class="text-white">@Acc.Money(Model.ReceivableBalance)</span></div>
                    <div class="d-flex justify-content-between small">
                        <span class="text-white-50">− 1-1210 @T["Cadangan Kerugian Piutang"]</span>
                        <span class="@(Model.AllowanceBalance < 0 ? "text-warning fw-semibold" : "text-white")">@Acc.Money(Model.AllowanceBalance)</span>
                    </div>
                    <div class="d-flex justify-content-between border-top border-secondary mt-2 pt-2"><span class="text-white">@T["Piutang bersih (nilai yang diharapkan tertagih)"]</span><span class="text-white fw-bold">@Acc.Money(Model.NetReceivable)</span></div>
                    @if (Model.AllowanceBalance < 0)
                    {
                        <div class="small text-warning mt-2"><i class="bi bi-exclamation-triangle me-1"></i>@T["Cadangan bersaldo debit: write-off via cadangan melebihi estimasi. Wajar sementara — tambah estimasi pada akhir periode."]</div>
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-7">
            <div class="card supplier-card h-100">
                <div class="table-responsive">
                    <table class="table align-middle mb-0 supplier-table first-left small">
                        <thead>
                            <tr>
                                <th class="ps-4"></th>
                                <th>@T["Via cadangan"]</th>
                                <th class="pe-4">@T["Langsung (direct)"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td class="ps-4 text-white-50">@T["Jurnal"]</td><td class="text-white">D 1-1210 / K 1-1200</td><td class="text-white pe-4">D 5-8000 / K 1-1200</td></tr>
                            <tr><td class="ps-4 text-white-50">@T["Beban diakui"]</td><td class="text-white">@T["saat estimasi"]</td><td class="text-white pe-4">@T["saat write-off"]</td></tr>
                            <tr><td class="ps-4 text-white-50">@T["Laba rugi saat write-off"]</td><td class="text-white">@T["tidak berubah"]</td><td class="text-white pe-4">@T["turun"]</td></tr>
                            <tr><td class="ps-4 text-white-50">@T["Piutang bersih saat write-off"]</td><td class="text-white">@T["tidak berubah"]</td><td class="text-white pe-4">@T["turun"]</td></tr>
                            <tr><td class="ps-4 text-white-50">@T["Total write-off"]</td><td class="text-white fw-semibold">@Acc.Money(Model.WriteOffAllowanceTotal)</td><td class="text-white fw-semibold pe-4">@Acc.Money(Model.WriteOffDirectTotal)</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-lg-5">
            <div class="card supplier-card h-100">
                <div class="card-header bg-transparent py-3 px-4"><span class="fw-semibold text-white">@T["Estimasi cadangan"]</span></div>
                <div class="card-body px-4">
                    <form method="post" asp-action="Estimate" class="row g-2 align-items-end" data-perm="create">
                        <div class="col-sm-5">
                            <label class="form-label text-white small mb-1" for="eDate">@T["Tanggal"]</label>
                            <input type="date" class="form-control form-control-sm" name="date" id="eDate" value="@today" required />
                        </div>
                        <div class="col-sm-7">
                            <label class="form-label text-white small mb-1" for="eAmount">@T["Nominal"]</label>
                            <input type="number" step="0.01" min="0.01" class="form-control form-control-sm text-end" name="amount" id="eAmount" required />
                        </div>
                        <div class="col-12">
                            <input type="text" class="form-control form-control-sm" name="note" maxlength="255" placeholder="@T["Keterangan (mis. estimasi 5% piutang > 90 hari)"]" />
                        </div>
                        <div class="col-12 d-flex align-items-center gap-2">
                            <span class="small text-white-50 me-auto">D 5-8000 / K 1-1210</span>
                            <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>@T["Catat Estimasi"]</button>
                        </div>
                    </form>
                    <div class="form-text small text-white-50 mt-2">@T["Nominal ditentukan sendiri (tanpa kalkulator aging) — lihat Umur Piutang sebagai acuan."]</div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 supplier-table first-left small">
                        <tbody>
                            @if (Model.Estimates.Count == 0)
                            {
                                <tr><td class="text-center text-muted py-3">@T["Belum ada estimasi."]</td></tr>
                            }
                            @foreach (var e in Model.Estimates)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <a asp-controller="Journals" asp-action="Details" asp-route-uid="@e.Uid" class="text-info text-nowrap">@e.JournalNo</a>
                                        <span class="text-white-50 ms-1">@Acc.Date(e.Date)</span>
                                        <div class="text-white-50" style="white-space: normal">@e.Description</div>
                                    </td>
                                    <td class="pe-4 text-end text-nowrap">
                                        <div class="@(e.IsReversed ? "text-decoration-line-through text-white-50" : "text-white")">@Acc.Money(e.Amount)</div>
                                        @if (e.IsReversed)
                                        {
                                            <span class="badge bg-danger">@T["Dibatalkan"]</span>
                                            <a asp-controller="Journals" asp-action="Details" asp-route-uid="@e.ReversalUid" class="text-info">@e.ReversalNo</a>
                                        }
                                        else
                                        {
                                            <form method="post" asp-action="ReverseEstimate" class="d-inline" data-perm="delete"
                                                  onsubmit='const r = prompt(@Json.Serialize(T["Alasan pembatalan estimasi {0}:", e.JournalNo])); if (!r) return false; this.reason.value = r; return true;'>
                                                <input type="hidden" name="uid" value="@e.Uid" />
                                                <input type="hidden" name="reason" />
                                                <button type="submit" class="btn btn-link btn-sm p-0 text-danger" title="@T["Batalkan"]"><i class="bi bi-x-circle"></i></button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card supplier-card h-100">
                <div class="card-header bg-transparent py-3 px-4"><span class="fw-semibold text-white">@T["Write-off piutang"]</span></div>
                <div class="card-body px-4">
                    @if (Model.OpenInvoices.Count == 0)
                    {
                        <div class="text-muted small">@T["Tidak ada faktur penjualan IDR yang masih bersisa."]</div>
                    }
                    else
                    {
                        <form method="post" asp-action="WriteOff" class="row g-2 align-items-end" data-perm="create" id="writeOffForm">
                            <div class="col-12">
                                <label class="form-label text-white small mb-1" for="wInvoice">@T["Faktur penjualan"]</label>
                                <select class="form-select form-select-sm" name="invoiceUid" id="wInvoice" required>
                                    @foreach (var o in Model.OpenInvoices)
                                    {
                                        <option value="@o.Uid" data-outstanding="@o.Outstanding.ToString(inv)">@o.InvoiceNo — @o.CustomerName — @T["sisa"] @Acc.Money(o.Outstanding) (@T["{0} hari lewat jatuh tempo", o.DaysOverdue])</option>
                                    }
                                </select>
                            </div>
                            <div class="col-sm-4">
                                <label class="form-label text-white small mb-1" for="wDate">@T["Tanggal"]</label>
                                <input type="date" class="form-control form-control-sm" name="date" id="wDate" value="@today" required />
                            </div>
                            <div class="col-sm-4">
                                <label class="form-label text-white small mb-1" for="wAmount">@T["Nominal"]</label>
                                <input type="number" step="0.01" min="0.01" class="form-control form-control-sm text-end" name="amount" id="wAmount" required />
                            </div>
                            <div class="col-sm-4">
                                <label class="form-label text-white small mb-1" for="wReason">@T["Alasan"]</label>
                                <input type="text" class="form-control form-control-sm" name="reason" id="wReason" maxlength="255" placeholder="@T["mis. customer pailit"]" required />
                            </div>
                            <div class="col-12 d-flex flex-wrap gap-2 justify-content-end">
                                <button type="submit" name="method" value="allowance" class="btn btn-warning btn-sm"><i class="bi bi-shield-minus me-1"></i>@T["Write-off via Cadangan"]</button>
                                <button type="submit" name="method" value="direct" class="btn btn-outline-warning btn-sm"><i class="bi bi-lightning me-1"></i>@T["Write-off Langsung"]</button>
                            </div>
                        </form>
                    }
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 supplier-table first-left small">
                        <thead>
                            <tr>
                                <th class="ps-4">@T["NO."]</th>
                                <th>@T["FAKTUR"]</th>
                                <th>@T["METODE"]</th>
                                <th class="text-end">@T["NOMINAL"]</th>
                                <th class="pe-4"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.WriteOffs.Count == 0)
                            {
                                <tr><td colspan="5" class="text-center text-muted py-3">@T["Belum ada write-off."]</td></tr>
                            }
                            @foreach (var w in Model.WriteOffs)
                            {
                                <tr>
                                    <td class="ps-4 text-nowrap">
                                        <a asp-controller="Journals" asp-action="Details" asp-route-uid="@w.JournalUid" class="text-info">@w.WriteOffNo</a>
                                        <div class="text-white-50">@Acc.Date(w.WriteOffDate)</div>
                                    </td>
                                    <td class="text-white">
                                        <a asp-controller="SalesInvoices" asp-action="Details" asp-route-uid="@w.InvoiceUid" class="text-info text-nowrap">@w.InvoiceNo</a> · @w.CustomerName
                                        <div class="text-white-50">@w.Reason</div>
                                    </td>
                                    <td><span class="badge @(w.Method == "allowance" ? "bg-warning text-dark" : "bg-secondary")">@T[ERP.Web.Models.WriteOffViewModel.MethodLabel(w.Method)]</span></td>
                                    <td class="text-end text-white @(w.Status == "void" ? "text-decoration-line-through text-white-50" : "")">@Acc.Money(w.Amount)</td>
                                    <td class="pe-4 text-end">
                                        @if (w.Status == "void")
                                        {
                                            <span class="badge bg-danger" title="@w.VoidReason">@T["Dibatalkan"]</span>
                                        }
                                        else
                                        {
                                            <form method="post" asp-action="VoidWriteOff" class="d-inline" data-perm="delete"
                                                  onsubmit='const r = prompt(@Json.Serialize(T["Alasan pembatalan write-off {0}:", w.WriteOffNo])); if (!r) return false; this.reason.value = r; return true;'>
                                                <input type="hidden" name="uid" value="@w.Uid" />
                                                <input type="hidden" name="reason" />
                                                <button type="submit" class="btn btn-link btn-sm p-0 text-danger" title="@T["Batalkan"]"><i class="bi bi-x-circle"></i></button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const sel = document.getElementById('wInvoice'), amount = document.getElementById('wAmount');
            if (!sel) return;
            const fill = () => { amount.value = sel.selectedOptions[0]?.dataset.outstanding ?? ''; };
            sel.addEventListener('change', fill);
            fill();
        })();
    </script>
}
