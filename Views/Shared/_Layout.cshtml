<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - ERP Net 9</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

<div class="app-shell">
    <aside class="sidebar" id="sidebar">

        <div class="brand">
            <div class="brand-icon">
                <i class="bi bi-boxes"></i>
            </div>

            <div class="brand-text">
                <strong>ERP NET 9</strong>
                <small>Enterprise System</small>
            </div>
        </div>

        <nav class="sidebar-menu">

            <!-- DASHBOARD -->
                <button class="nav-group"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#"
                        aria-expanded="true">
                    <span>
                <i class="bi bi-speedometer2"></i>
                Dashboard</span>
            </button>

            <!-- ALUR PROSES -->
                <button class="nav-group"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#"
                        aria-expanded="true">
                    <span>
                <i class="bi bi-diagram-3"></i>
               Alur Proses</span>
            </button>


            <!-- MASTER DATA -->
            <button class="nav-group"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#masterDataMenu"
                    aria-expanded="true">

                <span>
                    <i class="bi bi-folder2"></i>
                    Master Data
                </span>

                <i class="bi bi-chevron-down"></i>
            </button>

            <div class="collapse show"
                 id="masterDataMenu">

                <a asp-controller="Users"
                   asp-action="Index"
                   class="nav-sub">
                    <i class="bi bi-people"></i>
                    Users
                </a>

                <a asp-controller="Menus"
                   asp-action="Index"
                   class="nav-sub">
                    <i class="bi bi-list-ul"></i>
                    Menu
                </a>

                <a asp-controller="Roles"
                   asp-action="Index"
                   class="nav-sub">
                    <i class="bi bi-shield-lock"></i>
                    Roles
                </a>

                <a href="#" class="nav-sub">
                    <i class="bi bi-key"></i>
                    Hak Akses
                </a>
            </div>


            <!-- PENGATURAN -->
            <button class="nav-group"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#settingMenu">

                <span>
                    <i class="bi bi-gear"></i>
                    Pengaturan
                </span>

                <i class="bi bi-chevron-down"></i>
            </button>

            <div class="collapse"
                 id="settingMenu">

                <a href="#" class="nav-sub">
                    <i class="bi bi-sliders"></i>
                    App Settings
                </a>

                <a href="#" class="nav-sub">
                    <i class="bi bi-clock-history"></i>
                    Log Audit
                </a>

                <a asp-controller="Msfields"
                   asp-action="Index" class="nav-sub">
                  <i class="bi bi-table"></i>
                   Msfield
                </a>

                <a href="#" class="nav-sub">
                    <i class="bi bi-magic"></i>
                    Code Generator
                </a>

                <a href="#" class="nav-sub">
                    <i class="bi bi-trash3"></i>
                    Reset Data
                </a>

                <a href="#" class="nav-sub">
                    <i class="bi bi-diagram-2"></i>
                    Peta Data
                </a>
            </div>


            <!-- INVENTORY -->
            <button class="nav-group"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#inventoryMenu">

                <span>
                    <i class="bi bi-box-seam"></i>
                    Inventory
                </span>

                <i class="bi bi-chevron-down"></i>
            </button>

            <div class="collapse"
                 id="inventoryMenu">

                <a asp-controller="Products"
                   asp-action="Index"
                   class="nav-sub">
                   <i class="bi bi-box"></i>
                   Produk
                </a>

                <a asp-controller="ProductCategories"
                   asp-action="Index" class="nav-sub">
                   <i class="bi bi-tags"></i>
                   Kategori Produk
                </a>

                <a asp-controller="ProductAttributes"
                   asp-action="Index" class="nav-sub">
                   <i class="bi bi-palette"></i>
                   Atribut & Varian
                </a>

                <a href="#" class="nav-sub">Stok per Gudang</a>
                <a href="#" class="nav-sub">Material Request</a>

                <a asp-controller="GoodsReceipts"
                   asp-action="Index"
                   class="nav-sub">
                   <i class="bi bi-box-arrow-in-down"></i>
                   Penerimaan
                </a>

                <a href="#" class="nav-sub">Pengeluaran</a>
                <a href="#" class="nav-sub">Transfer Gudang</a>
                <a href="#" class="nav-sub">Penyesuaian</a>
                <a href="#" class="nav-sub">Serial Unit</a>

                 <a asp-controller="Units"
                   asp-action="Index"
                   class="nav-sub">
                   <i class="bi bi-rulers"></i>
                   Satuan
                </a>

                <a asp-controller="Brands"
                   asp-action="Index" class="nav-sub">
                  <i class="bi bi-table"></i>
                   Brands
                </a>

                <a asp-controller="Warehouse"
                   asp-action="Index" class="nav-sub">
                  <i class="bi bi-building"></i>
                   Gudang
                </a>
            </div>


            <!-- PURCHASE REQUEST -->
            <button class="nav-group"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#purchaseRequestMenu">

                <span>
                    <i class="bi bi-bag-check"></i>
                    Purchase Request
                </span>

                <i class="bi bi-chevron-down"></i>
            </button>

            <div class="collapse"
                 id="purchaseRequestMenu">

                <a href="#" class="nav-sub">PR Barang</a>
                <a href="#" class="nav-sub">PR Jasa</a>
                <a href="#" class="nav-sub">PR Aset</a>
            </div>


            <!-- PEMBELIAN -->
            <button class="nav-group"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#pembelianMenu">

                <span>
                    <i class="bi bi-cart3"></i>
                    Pembelian
                </span>

                <i class="bi bi-chevron-down"></i>
            </button>

            <div class="collapse"
                 id="pembelianMenu"> 
                 <a asp-controller="GoodsRfq"
                       asp-action="Index"
                       class="nav-sub">
                        <i class="bi bi-envelope-paper"></i>
                        RFQ Barang
                </a>
                <a href="#" class="nav-sub">RFQ Jasa</a>
                <a href="#" class="nav-sub">RFQ Aset</a>

                <a asp-controller="GoodsPurchaseOrders"
                   asp-action="Index"
                   class="nav-sub">
                    <i class="bi bi-file-earmark-text"></i>
                    PO Barang
                </a>
                <a href="#" class="nav-sub">PO Jasa</a>
                <a href="#" class="nav-sub">PO Aset</a>

                <a asp-controller="GoodsPurchaseOrders"
                       asp-action="ReceivingQueue"
                       class="nav-sub">
                        <i class="bi bi-box-arrow-in-down"></i>
                        Antrian Penerimaan
                </a>

                <a href="#" class="nav-sub">Retur Barang</a>
                <a href="#" class="nav-sub">Retur Aset</a>

                <a asp-controller="Suppliers"
                       asp-action="Index"
                       class="nav-sub">
                        <i class="bi bi-truck"></i>
                        Supplier
                    </a>
             </div>

            <!-- PENJUALAN -->
            <button class="nav-group"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#penjualanMenu">

                <span>
                    <i class="bi bi-receipt"></i>
                    Penjualan
                </span>

                <i class="bi bi-chevron-down"></i>
            </button>

            <div class="collapse"
                 id="penjualanMenu">

                <a href="#" class="nav-sub">SO Barang</a>
                <a href="#" class="nav-sub">SO Jasa</a>
                <a href="#" class="nav-sub">Retur Penjualan</a>
                    <a asp-controller="Customers"
                       asp-action="Index"
                       class="nav-sub">
                        <i class="bi bi-people"></i>
                        Customer
                    </a>

                <a asp-controller="CustomerGroups"
                   asp-action="Index"
                   class="nav-sub">
                    <i class="bi bi-people"></i>
                    Group Customer
                </a>

                 <a asp-controller="SalesForces"
                       asp-action="Index"
                       class="nav-sub">
                        <i class="bi bi-person-badge"></i>
                        Sales Force
                    </a>
                 <a asp-controller="PriceLists"
                       asp-action="Index"
                       class="nav-sub">
                        <i class="bi bi-tags"></i>
                        Price List
                    </a>
                    <a asp-controller="ShippingAreas"
                       asp-action="Index"
                       class="nav-sub">
                        <i class="bi bi-truck"></i>
                        Area Pengiriman
                    </a>
            </div>


            <!-- LAPORAN -->
            <button class="nav-group"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#laporanMenu">

                <span>
                    <i class="bi bi-bar-chart"></i>
                    Laporan
                </span>

                <i class="bi bi-chevron-down"></i>
            </button>

            <div class="collapse"
                 id="laporanMenu">

                <a href="#" class="nav-sub">Laporan Pembelian</a>
                <a href="#" class="nav-sub">Laporan Penjualan</a>
                <a href="#" class="nav-sub">Laporan Mutasi Stok</a>
                <a href="#" class="nav-sub">Laba Kotor</a>
                <a href="#" class="nav-sub">Kartu Stok</a>
                
                <a href="#" class="nav-sub">Kategori Produk</a>
                <a href="#" class="nav-sub">Umur Stok</a>
                <a href="#" class="nav-sub">Outstanding PO</a>
                <a href="#" class="nav-sub">Outstanding SO</a>
                <a href="#" class="nav-sub">Matriks Stok/Gudang</a>
            </div>


            <!-- PRODUKSI -->
            <button class="nav-group"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#produksiMenu">

                <span>
                    <i class="bi bi-gear-wide-connected"></i>
                    Produksi
                </span>

                <i class="bi bi-chevron-down"></i>
            </button>

            <div class="collapse"
                 id="produksiMenu">

                <a href="#" class="nav-sub">Bill of Materials</a>
                <a href="#" class="nav-sub">Production Order</a>
                <a asp-controller="WorkCenters"
                   asp-action="Index" class="nav-sub">
                     <i class="bi bi-pc-display"></i>
                    Work Center
                </a>
                <a href="#" class="nav-sub">Work Order</a>
                <a href="#" class="nav-sub">Katalog Produk</a>
            </div>


            <!-- MANAJEMEN ASET -->
            <button class="nav-group"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#assetMenu">

                <span>
                    <i class="bi bi-building"></i>
                    Manajemen Aset
                </span>

                <i class="bi bi-chevron-down"></i>
            </button>

            <div class="collapse"
                 id="assetMenu">

                <a href="#" class="nav-sub">Daftar Aset</a>
                <a href="#" class="nav-sub">Serah Terima</a>
                <a href="#" class="nav-sub">Penyusutan</a>
                <a href="#" class="nav-sub">Maintenance</a>
                <a href="#" class="nav-sub">Kategori Aset</a>
                <a href="#" class="nav-sub">Nilai Buku Aset</a>
            </div>


            <!-- AKUNTANSI -->
            <button class="nav-group"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#accountingMenu">

                <span>
                    <i class="bi bi-calculator"></i>
                    Akuntansi
                </span>

                <i class="bi bi-chevron-down"></i>
            </button>

            <div class="collapse"
                 id="accountingMenu">

                <a href="#" class="nav-sub">Bagan Akun</a>
                <a href="#" class="nav-sub">Periode Akuntansi</a>
                <a href="#" class="nav-sub">Kas &amp; Bank</a>
                <a href="#" class="nav-sub">Saldo Awal</a>
                <a href="#" class="nav-sub">Jurnal Umum</a>
                <a href="#" class="nav-sub">Transaksi Kas &amp; Bank</a>
                <a href="#" class="nav-sub">Faktur Pembelian</a>
                <a href="#" class="nav-sub">Faktur Penjualan</a>
                <a href="#" class="nav-sub">Pembayaran Hutang</a>
                <a href="#" class="nav-sub">Penerimaan Piutang</a>
                <a href="#" class="nav-sub">Umur Hutang</a>
                <a href="#" class="nav-sub">Umur Piutang</a>
                <a href="#" class="nav-sub">Buku Besar</a>
                <a href="#" class="nav-sub">Neraca Saldo</a>
                <a href="#" class="nav-sub">Laba Rugi</a>
                <a href="#" class="nav-sub">Neraca</a>
                <a href="#" class="nav-sub">Arus Kas</a>
                <a href="#" class="nav-sub">Rekap PPN</a>
                <a href="#" class="nav-sub">Kartu Hutang</a>
                <a href="#" class="nav-sub">Kartu Piutang</a>
                <a href="#" class="nav-sub">Perubahan Ekuitas</a>
                <a href="#" class="nav-sub">Tutup Buku</a>
            </div>


            <!-- PERSETUJUAN -->
            <button class="nav-group"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#approvalMenu">

                <span>
                    <i class="bi bi-check2-square"></i>
                    Persetujuan
                </span>

                <i class="bi bi-chevron-down"></i>
            </button>

            <div class="collapse"
                 id="approvalMenu">

                <a href="#" class="nav-sub">Kotak Persetujuan</a>
                <a href="#" class="nav-sub">Alur Persetujuan</a>
            </div>


            <!-- TOKO ONLINE -->
            <button class="nav-group"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#onlineMenu">

                <span>
                    <i class="bi bi-shop"></i>
                    Toko Online
                </span>

                <i class="bi bi-chevron-down"></i>
            </button>

            <div class="collapse"
                 id="onlineMenu">

                <a href="#" class="nav-sub">Pesanan Online</a>
            </div>

        </nav>

    </aside>


    <!-- ==================================================
         MAIN CONTENT
         ================================================== -->
    <section class="main-content">

        <header class="topbar">

            <button type="button"
                    class="btn sidebar-toggle"
                    id="sidebarToggle">
                <i class="bi bi-list"></i>
            </button>

            <div class="topbar-spacer"></div>

            <div class="user-box">
                <div class="user-avatar">
                    A
                </div>

                <div class="user-info">
                    <strong>Administrator</strong>
                    <small>System Admin</small>
                </div>
            </div>

        </header>


        <div class="page-content">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    @TempData["Success"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    @TempData["Error"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()

        </div>

    </section>

</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

<script>
    document.getElementById('sidebarToggle')
        ?.addEventListener('click', function () {

            document.body.classList.toggle('sidebar-collapsed');

        });
</script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
