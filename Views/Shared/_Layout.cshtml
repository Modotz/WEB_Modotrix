@using ERP.Web.Controllers
@using ERP.Web.Security
@inject ERP.Web.Services.BrandingService Branding
@{
    var branding = await Branding.GetAsync();
    var logoUrl = Branding.AssetUrl(branding.Logo);
    var displayName = User.FindFirst(AccountController.DisplayNameClaim)?.Value ?? User.Identity?.Name ?? string.Empty;
    var roleName = User.FindFirst(AccountController.RoleNameClaim)?.Value ?? string.Empty;

    // Sembunyikan tombol aksi (data-perm) yang tidak diizinkan untuk halaman ini.
    var hiddenActionsCss = await Access.BuildHiddenActionsCssAsync(MenuRegistry.ResolveMenuUrl(
        ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty,
        ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty));
}
<!DOCTYPE html>
<html lang="@T.Lang" data-theme="dark">
<head>
    <meta charset="utf-8" />

    <script>
        // Terapkan tema tersimpan sebelum halaman dirender (tanpa kedip).
        (function () {
            var theme = "dark";
            try { theme = localStorage.getItem("erp-theme") === "light" ? "light" : "dark"; } catch (e) { }
            document.documentElement.setAttribute("data-theme", theme);
        })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - @branding.AppName</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme-light.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme-light-overrides.css" asp-append-version="true" />

    @if (hiddenActionsCss.Length > 0)
    {
        <style>
            @Html.Raw(hiddenActionsCss)
        </style>
    }
</head>

<body>

<div class="app-shell">
    <aside class="sidebar" id="sidebar">

        <div class="brand">
            <div class="brand-icon">
                @if (logoUrl != null)
                {
                    <img src="@logoUrl" alt="" class="brand-logo-img"
                         onerror="this.replaceWith(Object.assign(document.createElement(&quot;i&quot;), { className: &quot;bi bi-boxes&quot; }))" />
                }
                else
                {
                    <i class="bi bi-boxes"></i>
                }
            </div>

            <div class="brand-text">
                <strong>@branding.AppName</strong>
                <small>Enterprise System</small>
            </div>
        </div>

        @await Component.InvokeAsync("Sidebar")

    </aside>


    <!-- ==================================================
         MAIN CONTENT
         ================================================== -->
    <section class="main-content">

        <header class="topbar">

            <button type="button"
                    class="btn sidebar-toggle"
                    id="sidebarToggle">
                <i class="bi bi-list"></i>
            </button>

            <div class="topbar-spacer"></div>

            <div class="dropdown me-1">
                <button type="button" class="btn theme-toggle lang-toggle" data-bs-toggle="dropdown" aria-expanded="false" title="@T["Bahasa"]">
                    <span class="fw-semibold small">@T.Lang.ToUpperInvariant()</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow">
                    <li><a class="dropdown-item @(T.IsEnglish ? "" : "active")" href="@Url.Action("Set", "Language", new { lang = "id", returnUrl = Context.Request.Path + Context.Request.QueryString })">🇮🇩 Bahasa Indonesia</a></li>
                    <li><a class="dropdown-item @(T.IsEnglish ? "active" : "")" href="@Url.Action("Set", "Language", new { lang = "en", returnUrl = Context.Request.Path + Context.Request.QueryString })">🇬🇧 English</a></li>
                </ul>
            </div>

            <button type="button" class="btn theme-toggle me-2" id="themeToggle" title="@T["Ganti tema terang/gelap"]">
                <i class="bi bi-sun"></i>
            </button>

            <div class="user-box dropdown">
                <button class="dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <div class="user-avatar">
                        @(string.IsNullOrEmpty(displayName) ? "?" : displayName.Substring(0, 1).ToUpperInvariant())
                    </div>

                    <div class="user-info">
                        <strong>@displayName</strong>
                        <small>@roleName</small>
                    </div>
                </button>

                <ul class="dropdown-menu dropdown-menu-end shadow">
                    <li><h6 class="dropdown-header">@User.Identity?.Name</h6></li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="dropdown-item text-danger">
                                <i class="bi bi-box-arrow-right me-2"></i>@T["Logout"]
                            </button>
                        </form>
                    </li>
                </ul>
            </div>

        </header>


        <div class="page-content">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    @T[TempData["Success"]?.ToString()]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    @T[TempData["Error"]?.ToString()]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()

        </div>

    </section>

</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

<script>
    document.getElementById('sidebarToggle')
        ?.addEventListener('click', function () {

            document.body.classList.toggle('sidebar-collapsed');

        });

    // Tema terang/gelap (disimpan per browser).
    (function () {
        const btn = document.getElementById('themeToggle');
        const icon = btn?.querySelector('i');
        const sync = () => {
            const light = document.documentElement.getAttribute('data-theme') === 'light';
            if (icon) icon.className = light ? 'bi bi-moon-stars' : 'bi bi-sun';
            btn?.setAttribute('title', light ? '@T["Ganti ke tema gelap"]' : '@T["Ganti ke tema terang"]');
        };
        btn?.addEventListener('click', () => {
            const next = document.documentElement.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
            document.documentElement.setAttribute('data-theme', next);
            try { localStorage.setItem('erp-theme', next); } catch (e) { }
            sync();
        });
        sync();
    })();
</script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
