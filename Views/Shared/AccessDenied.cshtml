@{
    ViewData["Title"] = T["Akses Ditolak"];
}

<div class="px-2">
    <div class="card custom-card mx-auto mt-4" style="max-width: 560px;">
        <div class="card-body text-center p-5">
            <i class="bi bi-shield-lock text-danger" style="font-size: 3.5rem;"></i>
            <h4 class="fw-semibold text-white mt-3">@T["Akses ditolak"]</h4>
            <p class="text-white-50 mb-4">
                @T["Role Anda tidak memiliki izin untuk membuka halaman atau melakukan aksi ini."]
                @T["Hubungi Administrator bila Anda memerlukan akses."]
            </p>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary btn-sm px-3">
                <i class="bi bi-house me-1"></i>@T["Kembali ke Dashboard"]
            </a>
        </div>
    </div>
</div>
