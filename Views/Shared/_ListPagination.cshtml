@model ERP.Web.Models.ListPaginationModel
@* Footer pagination standar — pola menu Gudang (nomor halaman dipadatkan bila banyak). *@
@{
    var start = Model.TotalCount == 0 ? 0 : ((Model.Page - 1) * Model.PageSize) + 1;
    var end = Math.Min(Model.Page * Model.PageSize, Model.TotalCount);
    var current = Model.Page;
    var total = Model.TotalPage;

    var pages = new SortedSet<int> { 1, total };
    for (var p = Math.Max(1, current - 2); p <= Math.Min(total, current + 2); p++)
        pages.Add(p);
}
<div class="card-footer bg-transparent border-top-0 d-flex flex-wrap justify-content-between align-items-center gap-2 py-3">
    <span class="menu-description small">
        @T["Menampilkan"] <strong>@start – @end</strong> @T["dari"] <strong>@Model.TotalCount.ToString("N0", ERP.Web.Models.Acc.Culture)</strong> @T["data"]
    </span>

    @if (total > 1)
    {
        <nav aria-label="Pagination">
            <ul class="pagination mb-0">
                <li class="page-item @(current <= 1 ? "disabled" : "")">
                    <a class="page-link" href="@Model.PageUrl(Math.Max(1, current - 1))">@T["Sebelumnya"]</a>
                </li>
                @{ var prev = 0; }
                @foreach (var p in pages)
                {
                    if (prev != 0 && p - prev > 1)
                    {
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                    }
                    <li class="page-item @(p == current ? "active" : "")">
                        <a class="page-link" href="@Model.PageUrl(p)">@p</a>
                    </li>
                    prev = p;
                }
                <li class="page-item @(current >= total ? "disabled" : "")">
                    <a class="page-link" href="@Model.PageUrl(Math.Min(total, current + 1))">@T["Berikutnya"]</a>
                </li>
            </ul>
        </nav>
    }
</div>
