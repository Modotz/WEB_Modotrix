@model ERP.Web.Models.ApprovalWorkflowFormViewModel
@{
    var isEdit = Model.Uid != null;
    ViewData["Title"] = isEdit ? T["Ubah Alur Persetujuan"] : T["Buat Alur Persetujuan"];
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var users = Model.Options.Users.Select(u => new { id = u.Id, name = u.Name, role = u.RoleName });
    var roles = Model.Options.Roles.Select(r => new { id = r.Id, name = r.Name, members = r.Members });
    var others = Model.Existing.Data.Where(w => w.Uid != Model.Uid)
        .Select(w => new { name = w.Name, docType = w.DocType, min = w.MinAmount, max = w.MaxAmount, priority = w.Priority, active = w.IsActive });
    var i18n = new Dictionary<string, string>
    {
        ["level"] = T["Level"],
        ["levelName"] = T["Nama level"],
        ["quorum"] = T["Quorum"],
        ["count"] = T["Jumlah"],
        ["approvers"] = T["Approver"],
        ["addUser"] = T["+ User"],
        ["addRole"] = T["+ Role"],
        ["removeLevel"] = T["Hapus level"],
        ["chooseUser"] = T["— pilih user —"],
        ["chooseRole"] = T["— pilih role —"],
        ["role"] = T["role"],
        ["members"] = T["{0} user aktif"],
        ["pool"] = T["Pool saat ini: {0} user"],
        ["warnEmpty"] = T["Level {0}: belum ada approver."],
        ["warnPoolEmpty"] = T["Level {0}: pool approver belum punya user aktif — pengajuan akan ditolak."],
        ["warnCountMin"] = T["Level {0}: jumlah COUNT minimal 1."],
        ["warnCountPool"] = T["Level {0}: quorum {1} melebihi ukuran pool saat ini ({2} user) — tidak akan terpenuhi."],
        ["warnCountEq"] = T["Level {0}: quorum {1} sama dengan ukuran pool; bila pembuat/pengaju termasuk pool, pengajuan ditolak."],
        ["warnNoLevel"] = T["Minimal satu level persetujuan."],
        ["warnRange"] = T["Nominal maksimum harus lebih besar dari minimum."],
        ["warnOverlap"] = T["Rentang tumpang-tindih dengan alur aktif \"{0}\" (prioritas sama) — penyimpanan akan ditolak."],
        ["gapTitle"] = T["Celah cakupan jenis dokumen ini (tidak melalui persetujuan):"],
        ["inf"] = T["tak terbatas"],
        ["start"] = T["Mulai"],
        ["end"] = T["Selesai"],
        ["reject"] = T["Tolak"],
        ["approve"] = T["Setuju"],
        ["rejectBack"] = T["Ditolak → kembali ke Draft (boleh diajukan ulang)"],
        ["empty"] = T["(kosong)"],
        ["all"] = T["ALL — semua approver"],
        ["any"] = T["ANY — cukup 1 orang"],
        ["countN"] = T["COUNT — n orang"]
    };
}
<div class="px-2">
    <div class="mb-3 d-flex flex-wrap align-items-center gap-2">
        <h3 class="fw-semibold text-white mb-0 me-auto">@ViewData["Title"]</h3>
        <a asp-action="Index" class="btn btn-secondary btn-sm" title="@T["Kembali"]"><i class="bi bi-arrow-left"></i></a>
    </div>

    @if (Model.UsedCount > 0)
    {
        <div class="alert alert-info small py-2">
            <i class="bi bi-info-circle me-1"></i>@T["Alur ini sudah dipakai {0} pengajuan. Perubahan hanya berlaku untuk pengajuan baru (pengajuan berjalan memakai snapshot); alur tidak dapat dihapus, hanya dinonaktifkan.", Model.UsedCount]
        </div>
    }

    <form method="post" asp-action="@(isEdit ? "Update" : "Create")" id="wfForm">
        <input type="hidden" name="Uid" value="@Model.Uid" />
        <input type="hidden" name="LevelsJson" id="levelsJson" value="@Model.LevelsJson" />
        <div class="row g-3">
            <div class="col-lg-4">
                <div class="card custom-card h-100">
                    <div class="card-header custom-card-header py-3 px-4"><span class="fw-semibold text-white"><i class="bi bi-diagram-2 me-1"></i>@T["Alur"]</span></div>
                    <div class="card-body px-4 py-3">
                        <div class="mb-3">
                            <label class="form-label text-white small" for="Name">@T["Nama alur"]</label>
                            <input type="text" class="form-control" id="Name" name="Name" value="@Model.Name" maxlength="120" placeholder="@T["mis. Approval PO Barang ≥ 10 juta"]" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-white small" for="DocType">@T["Jenis dokumen"] <span class="text-danger">*</span></label>
                            <select class="form-select" id="DocType" name="DocType" required>
                                <option value="">@T["— Pilih —"]</option>
                                @foreach (var d in Model.Options.DocTypes)
                                {
                                    <option value="@d.DocType" selected="@(d.DocType == Model.DocType)">@T[d.Label]@(d.Available ? "" : " — " + T["modul belum tersedia di .NET"])</option>
                                }
                            </select>
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label text-white small" for="MinAmount">@T["Nominal min (≥)"]</label>
                                <input type="number" class="form-control text-end" id="MinAmount" name="MinAmount" min="0" step="0.01" value="@Model.MinAmount.ToString(inv)" />
                            </div>
                            <div class="col-6">
                                <label class="form-label text-white small" for="MaxAmount">@T["Nominal maks (<)"]</label>
                                <input type="number" class="form-control text-end" id="MaxAmount" name="MaxAmount" min="0" step="0.01" value="@Model.MaxAmount?.ToString(inv)" placeholder="@T["tak terbatas"]" />
                            </div>
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label text-white small" for="Priority">@T["Prioritas"]</label>
                                <input type="number" class="form-control" id="Priority" name="Priority" step="1" value="@Model.Priority" />
                            </div>
                            <div class="col-6 d-flex align-items-end">
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input" type="checkbox" id="IsActive" name="IsActive" value="true" checked="@Model.IsActive" />
                                    <input type="hidden" name="IsActive" value="false" />
                                    <label class="form-check-label text-white" for="IsActive">@T["Aktif"]</label>
                                </div>
                            </div>
                        </div>
                        <div class="small text-white-50 mb-3">@T["Alur dipakai bila min ≤ nominal < maks. Bila beberapa alur cocok, prioritas tertinggi menang. Tanpa alur yang cocok, dokumen langsung diproses tanpa persetujuan."]</div>
                        <div class="mb-2">
                            <label class="form-label text-white small" for="Description">@T["Keterangan"]</label>
                            <textarea class="form-control" id="Description" name="Description" rows="2" maxlength="255">@Model.Description</textarea>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-8">
                <div class="card custom-card h-100">
                    <div class="card-header custom-card-header d-flex align-items-center py-3 px-4">
                        <span class="fw-semibold text-white"><i class="bi bi-people me-1"></i>@T["Level & Approver"]</span>
                        <button type="button" class="btn btn-success btn-sm ms-auto" id="addLevel"><i class="bi bi-plus-lg me-1"></i>@T["Tambah Level"]</button>
                    </div>
                    <div class="card-body px-4 py-3">
                        <div id="levels"></div>
                        <div class="small text-white-50">@T["Level berjalan berurutan (level 2 baru aktif setelah level 1 terpenuhi). Approver bisa user tertentu atau role (semua user aktif di role itu, di-resolve saat pengajuan)."]</div>
                        <div id="warnings" class="mt-3"></div>
                    </div>
                    <div class="card-footer d-flex gap-2 py-3 px-4">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>@T["Simpan Alur"]</button>
                        <a asp-action="Index" class="btn btn-secondary">@T["Batal"]</a>
                    </div>
                </div>
            </div>
        </div>
    </form>

    <div class="card custom-card mt-3">
        <div class="card-header custom-card-header d-flex align-items-center py-3 px-4">
            <span class="fw-semibold text-white"><i class="bi bi-diagram-3 me-1"></i>@T["Diagram Alur"]</span>
            <span class="ms-auto small text-white-50">@T["Otomatis mengikuti level & approver di atas"]</span>
        </div>
        <div class="card-body px-4 py-3">
            <div style="overflow-x: auto"><svg id="flowSvg" xmlns="http://www.w3.org/2000/svg"></svg></div>
            <div class="small text-white-50 mt-2">
                <span class="me-3"><i class="bi bi-circle"></i> @T["Mulai/Selesai"]</span>
                <span class="me-3"><i class="bi bi-app"></i> @T["Tugas approver"]</span>
                <span class="me-3">◇ <strong>+</strong> @T["ALL: semua wajib"]</span>
                <span class="me-3">◇ <strong>○</strong> @T["ANY: cukup satu"]</span>
                <span class="me-3">◇ <strong>n</strong> @T["COUNT: n orang"]</span>
                <span class="me-3">◇ <strong>✕</strong> @T["Keputusan (Setuju/Tolak)"]</span>
                <span class="me-3" style="color:#dc3545">╌╌▶ @T["Ditolak → kembali ke Draft (boleh diajukan ulang)"]</span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const USERS = @Json.Serialize(users);
            const ROLES = @Json.Serialize(roles);
            const OTHERS = @Json.Serialize(others);
            const L = @Json.Serialize(i18n);
            const fmt = (s, ...a) => String(s).replace(/\{(\d+)\}/g, (m, i) => a[i] ?? '');
            const esc = s => String(s ?? '').replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
            const money = v => Number(v).toLocaleString('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

            let levels = [];
            try { levels = JSON.parse(document.getElementById('levelsJson').value || '[]'); } catch (e) { levels = []; }
            levels = levels.map(l => ({ name: l.name || '', quorumType: l.quorumType || 'all', quorumCount: l.quorumCount || null, approvers: (l.approvers || []).map(a => ({ type: a.type === 'role' ? 'role' : 'user', id: Number(a.id) || 0 })) }));
            if (!levels.length) levels.push({ name: 'Level 1', quorumType: 'any', quorumCount: null, approvers: [] });

            const box = document.getElementById('levels');

            function poolOf(l) {
                let roleMembers = 0;
                l.approvers.forEach(a => {
                    if (a.id && a.type === 'role') { const r = ROLES.find(x => x.id === a.id); roleMembers += r ? r.members : 0; }
                });
                // Perkiraan: user langsung + anggota role (user yang juga anggota role bisa terhitung dua kali).
                return l.approvers.filter(a => a.type === 'user' && a.id).length + roleMembers;
            }

            function approverOptions(a) {
                if (a.type === 'role')
                    return `<option value="">${esc(L.chooseRole)}</option>` + ROLES.map(r => `<option value="${r.id}" ${r.id === a.id ? 'selected' : ''}>${esc(r.name)} (${esc(fmt(L.members, r.members))})</option>`).join('');
                return `<option value="">${esc(L.chooseUser)}</option>` + USERS.map(u => `<option value="${u.id}" ${u.id === a.id ? 'selected' : ''}>${esc(u.name)}${u.role ? ' — ' + esc(u.role) : ''}</option>`).join('');
            }

            function renderLevels() {
                box.innerHTML = levels.map((l, i) => `
                    <div class="border border-secondary rounded p-3 mb-3" data-i="${i}">
                        <div class="row g-2 align-items-end mb-2">
                            <div class="col-md-1 text-white fw-semibold">${esc(L.level)} ${i + 1}</div>
                            <div class="col-md-4"><label class="form-label small text-white-50 mb-0">${esc(L.levelName)}</label>
                                <input type="text" class="form-control form-control-sm js-name" maxlength="100" value="${esc(l.name)}"></div>
                            <div class="col-md-4"><label class="form-label small text-white-50 mb-0">${esc(L.quorum)}</label>
                                <select class="form-select form-select-sm js-quorum">
                                    <option value="all" ${l.quorumType === 'all' ? 'selected' : ''}>${esc(L.all)}</option>
                                    <option value="any" ${l.quorumType === 'any' ? 'selected' : ''}>${esc(L.any)}</option>
                                    <option value="count" ${l.quorumType === 'count' ? 'selected' : ''}>${esc(L.countN)}</option>
                                </select></div>
                            <div class="col-md-2 ${l.quorumType === 'count' ? '' : 'd-none'}"><label class="form-label small text-white-50 mb-0">${esc(L.count)}</label>
                                <input type="number" min="1" step="1" class="form-control form-control-sm js-count" value="${l.quorumCount ?? ''}"></div>
                            <div class="col-md-1 ms-auto text-end"><button type="button" class="btn btn-sm btn-outline-danger js-rmlevel" title="${esc(L.removeLevel)}" ${levels.length < 2 ? 'disabled' : ''}><i class="bi bi-trash3"></i></button></div>
                        </div>
                        <div class="small text-white-50 mb-1">${esc(L.approvers)} · ${esc(fmt(L.pool, poolOf(l)))}</div>
                        ${l.approvers.map((a, j) => `
                            <div class="input-group input-group-sm mb-1" data-j="${j}">
                                <span class="input-group-text">${a.type === 'role' ? '<i class="bi bi-people"></i>' : '<i class="bi bi-person"></i>'}</span>
                                <select class="form-select js-approver">${approverOptions(a)}</select>
                                <button type="button" class="btn btn-outline-danger js-rmapprover"><i class="bi bi-x-lg"></i></button>
                            </div>`).join('')}
                        <div class="mt-1">
                            <button type="button" class="btn btn-sm btn-outline-light js-adduser">${esc(L.addUser)}</button>
                            <button type="button" class="btn btn-sm btn-outline-light js-addrole">${esc(L.addRole)}</button>
                        </div>
                    </div>`).join('');
                refresh();
            }

            function refresh() {
                document.getElementById('levelsJson').value = JSON.stringify(levels.map(l => ({
                    name: l.name, quorumType: l.quorumType, quorumCount: l.quorumType === 'count' ? (Number(l.quorumCount) || null) : null,
                    approvers: l.approvers.filter(a => a.id)
                })));
                renderWarnings();
                renderDiagram();
            }

            function renderWarnings() {
                const w = [];
                if (!levels.length) w.push(L.warnNoLevel);
                levels.forEach((l, i) => {
                    const n = i + 1, pool = poolOf(l), cnt = Number(l.quorumCount) || 0;
                    if (!l.approvers.some(a => a.id)) w.push(fmt(L.warnEmpty, n));
                    else if (pool === 0) w.push(fmt(L.warnPoolEmpty, n));
                    if (l.quorumType === 'count') {
                        if (cnt < 1) w.push(fmt(L.warnCountMin, n));
                        else if (cnt > pool) w.push(fmt(L.warnCountPool, n, cnt, pool));
                        else if (cnt === pool) w.push(fmt(L.warnCountEq, n, cnt));
                    }
                });

                const docType = document.getElementById('DocType').value;
                const min = Number(document.getElementById('MinAmount').value) || 0;
                const maxRaw = document.getElementById('MaxAmount').value;
                const max = maxRaw === '' ? null : Number(maxRaw);
                const prio = Number(document.getElementById('Priority').value) || 0;
                const active = document.getElementById('IsActive').checked;
                if (max !== null && max <= min) w.push(L.warnRange);

                const same = OTHERS.filter(o => o.docType === docType && o.active);
                if (active) {
                    const ov = same.find(o => o.priority === prio && (o.max === null || min < o.max) && (max === null || o.min < max));
                    if (ov) w.push(fmt(L.warnOverlap, ov.name));
                }

                // Celah cakupan bila alur ini (aktif) ikut dihitung.
                let gapHtml = '';
                if (docType) {
                    const ranges = same.map(o => ({ min: o.min, max: o.max }));
                    if (active) ranges.push({ min, max });
                    ranges.sort((a, b) => a.min - b.min);
                    const gaps = []; let cur = 0, open = false;
                    for (const r of ranges) {
                        if (r.min > cur) gaps.push([cur, r.min]);
                        if (r.max === null) { open = true; break; }
                        cur = Math.max(cur, r.max);
                    }
                    if (!open) gaps.push([cur, null]);
                    if (ranges.length && gaps.length)
                        gapHtml = `<div class="alert alert-secondary small py-2 mb-2"><i class="bi bi-rulers me-1"></i>${esc(L.gapTitle)} `
                            + gaps.map(g => `${money(g[0])} – ${g[1] === null ? esc(L.inf) : '&lt; ' + money(g[1])}`).join('; ') + '</div>';
                }

                document.getElementById('warnings').innerHTML = gapHtml + w.map(t => `<div class="alert alert-warning small py-2 mb-2"><i class="bi bi-exclamation-triangle me-1"></i>${esc(t)}</div>`).join('');
            }

            // ---- Diagram alur (SVG murni, adaptif tema) — port dari form PHP, + simbol quorum ----
            function renderDiagram() {
                const svg = document.getElementById('flowSvg');
                // Warna mengikuti tema aplikasi (judul .text-white & latar kartu sudah dipetakan untuk tema terang/gelap).
                const FG = getComputedStyle(document.querySelector('h3.text-white') || document.body).color;
                const BG = getComputedStyle(svg.closest('.custom-card') || document.body).backgroundColor;
                const stages = levels.map((l, i) => ({
                    quorum: l.quorumType, count: Number(l.quorumCount) || 0, name: l.name || (L.level + ' ' + (i + 1)),
                    tasks: l.approvers.filter(a => a.id).map(a => {
                        if (a.type === 'role') { const r = ROLES.find(x => x.id === a.id); return { name: r ? r.name : '?', sub: L.role + ' · ' + fmt(L.members, r ? r.members : 0), filled: true }; }
                        const u = USERS.find(x => x.id === a.id); return { name: u ? u.name : '?', sub: u && u.role ? u.role : '', filled: true };
                    })
                }));
                const R = 16, TW = 158, TH = 52, GW = 36, GAP = 42, LANE = 86, PAD = 26, TOP = 64;
                const maxLanes = Math.max(1, ...stages.map(g => Math.max(1, g.tasks.length)));
                const contentH = (maxLanes - 1) * LANE + TH;
                const height = TOP + contentH + PAD;
                const midY = TOP + contentH / 2;
                const rejectY = 20;
                const half = n => n.type === 'task' ? TW / 2 : ((n.type === 'gw' || n.type === 'xor') ? GW / 2 : R);
                const trunc = (s, n) => s.length > n ? s.slice(0, n - 1) + '…' : s;
                const sym = st => st.quorum === 'any' ? '○' : st.quorum === 'count' ? String(st.count || 'n') : '+';

                const nodes = [], edges = [], labels = [];
                const push = n => { nodes.push(n); return n; };
                let x = PAD;
                const start = push({ type: 'start', x: x + R, y: midY });
                x = start.x + R + GAP;
                let prev = start;

                stages.forEach(st => {
                    const stageX = x;
                    let out;
                    const tasks = st.tasks.length ? st.tasks : [{ name: L.empty, sub: '', filled: false }];
                    if (tasks.length === 1) {
                        const t = push({ type: 'task', x: x + TW / 2, y: midY, label: tasks[0] });
                        edges.push([prev, t]); x = t.x + TW / 2 + GAP; out = t;
                    } else {
                        const split = push({ type: 'gw', x: x + GW / 2, y: midY, sym: sym(st) });
                        edges.push([prev, split]);
                        const tx = split.x + GW / 2 + GAP + TW / 2;
                        const ts = tasks.map((s, j) => {
                            const t = push({ type: 'task', x: tx, y: midY + (j - (tasks.length - 1) / 2) * LANE, label: s });
                            edges.push([split, t]); return t;
                        });
                        const join = push({ type: 'gw', x: tx + TW / 2 + GAP + GW / 2, y: midY, sym: sym(st) });
                        ts.forEach(t => edges.push([t, join]));
                        x = join.x + GW / 2 + GAP; out = join;
                    }
                    const xg = push({ type: 'xor', x: x + GW / 2, y: midY });
                    edges.push([out, xg]);
                    labels.push({ x: (stageX + xg.x) / 2, text: trunc(st.name, 26) + ' · ' + (st.quorum === 'any' ? 'ANY' : st.quorum === 'count' ? 'COUNT ' + (st.count || 'n') : 'ALL') });
                    prev = xg; x = xg.x + GW / 2 + GAP;
                });
                const end = push({ type: 'end', x: x + R, y: midY });
                edges.push([prev, end]);
                const width = end.x + R + PAD;

                const eSvg = edges.map(([a, b]) => {
                    const x1 = a.x + half(a), y1 = a.y, x2 = b.x - half(b), y2 = b.y;
                    const d = Math.abs(y1 - y2) < 0.5 ? `M ${x1} ${y1} L ${x2} ${y2}` : `M ${x1} ${y1} H ${(x1 + x2) / 2} V ${y2} H ${x2}`;
                    return `<path d="${d}" fill="none" stroke="currentColor" stroke-width="1.5" marker-end="url(#arw)"/>`;
                }).join('');

                const nSvg = nodes.map(n => {
                    if (n.type === 'start' || n.type === 'end') {
                        return `<circle cx="${n.x}" cy="${n.y}" r="${R}" fill="${BG}" stroke="currentColor" stroke-width="${n.type === 'end' ? 3 : 2}"/>`
                            + `<text x="${n.x}" y="${n.y + R + 15}" text-anchor="middle" font-size="11" fill="currentColor" opacity="0.7">${esc(n.type === 'start' ? L.start : L.end)}</text>`;
                    }
                    if (n.type === 'gw' || n.type === 'xor') {
                        const p = `${n.x},${n.y - GW / 2} ${n.x + GW / 2},${n.y} ${n.x},${n.y + GW / 2} ${n.x - GW / 2},${n.y}`;
                        const s = n.type === 'gw' ? n.sym : '✕';
                        return `<polygon points="${p}" fill="${BG}" stroke="currentColor" stroke-width="1.5"/>`
                            + `<text x="${n.x}" y="${n.y + 5}" text-anchor="middle" font-size="${n.type === 'gw' ? 15 : 13}" fill="currentColor">${esc(s)}</text>`;
                    }
                    const rx = n.x - TW / 2, ry = n.y - TH / 2;
                    const name = trunc(n.label.name, 20), sub = n.label.sub ? trunc(n.label.sub, 24) : '';
                    return `<rect x="${rx}" y="${ry}" width="${TW}" height="${TH}" rx="8" fill="${BG}" stroke="${n.label.filled ? 'currentColor' : '#dc3545'}" stroke-width="1.5"/>`
                        + `<circle cx="${rx + 15}" cy="${ry + 14}" r="6" fill="none" stroke="currentColor" stroke-width="1.2"/>`
                        + `<path d="M ${rx + 11} ${ry + 25} q 4 -5 8 0" fill="none" stroke="currentColor" stroke-width="1.2"/>`
                        + `<text x="${n.x + 8}" y="${n.y + (sub ? -3 : 4)}" text-anchor="middle" font-size="12" font-weight="600" fill="currentColor">${esc(name)}</text>`
                        + (sub ? `<text x="${n.x + 8}" y="${n.y + 15}" text-anchor="middle" font-size="10" fill="currentColor" opacity="0.6">${esc(sub)}</text>` : '');
                }).join('');

                const lSvg = labels.map(l => `<text x="${l.x}" y="${TOP - 10}" text-anchor="middle" font-size="11" fill="currentColor" opacity="0.75">${esc(l.text)}</text>`).join('');

                const xors = nodes.filter(n => n.type === 'xor');
                let rSvg = '';
                if (xors.length) {
                    const rightX = Math.max(...xors.map(n => n.x)), leftX = start.x;
                    const rj = 'stroke="#dc3545" stroke-width="1.4" stroke-dasharray="5 4" fill="none"';
                    rSvg += `<path d="M ${rightX} ${rejectY} H ${leftX}" ${rj}/>`;
                    xors.forEach(n => {
                        rSvg += `<path d="M ${n.x} ${n.y - GW / 2} V ${rejectY}" ${rj}/>`;
                        rSvg += `<text x="${n.x + 6}" y="${n.y - GW / 2 - 4}" font-size="9" fill="#dc3545">${esc(L.reject)}</text>`;
                        rSvg += `<text x="${n.x + GW / 2 + 3}" y="${midY - 5}" font-size="9" fill="#198754">${esc(L.approve)}</text>`;
                    });
                    rSvg += `<path d="M ${leftX} ${rejectY} V ${start.y - R}" ${rj} marker-end="url(#arwR)"/>`;
                    rSvg += `<text x="${(leftX + rightX) / 2}" y="${rejectY - 6}" text-anchor="middle" font-size="11" fill="#dc3545">${esc(L.rejectBack)}</text>`;
                }

                const defs = '<defs>'
                    + '<marker id="arw" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="currentColor"/></marker>'
                    + '<marker id="arwR" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#dc3545"/></marker>'
                    + '</defs>';
                svg.style.color = FG;
                svg.setAttribute('width', width);
                svg.setAttribute('height', height);
                svg.setAttribute('viewBox', `0 0 ${width} ${height}`);
                svg.innerHTML = defs + rSvg + lSvg + eSvg + nSvg;
            }

            // ---- event ----
            const idx = el => Number(el.closest('[data-i]').dataset.i);
            box.addEventListener('input', e => {
                const l = levels[idx(e.target)];
                if (e.target.classList.contains('js-name')) l.name = e.target.value;
                if (e.target.classList.contains('js-count')) l.quorumCount = Number(e.target.value) || null;
                refresh();
            });
            box.addEventListener('change', e => {
                const l = levels[idx(e.target)];
                if (e.target.classList.contains('js-quorum')) { l.quorumType = e.target.value; renderLevels(); return; }
                if (e.target.classList.contains('js-approver')) {
                    const j = Number(e.target.closest('[data-j]').dataset.j);
                    l.approvers[j].id = Number(e.target.value) || 0;
                    renderLevels(); return;
                }
            });
            box.addEventListener('click', e => {
                const b = e.target.closest('button');
                if (!b) return;
                const i = idx(b), l = levels[i];
                if (b.classList.contains('js-rmlevel')) levels.splice(i, 1);
                else if (b.classList.contains('js-adduser')) l.approvers.push({ type: 'user', id: 0 });
                else if (b.classList.contains('js-addrole')) l.approvers.push({ type: 'role', id: 0 });
                else if (b.classList.contains('js-rmapprover')) l.approvers.splice(Number(b.closest('[data-j]').dataset.j), 1);
                else return;
                renderLevels();
            });
            document.getElementById('addLevel').addEventListener('click', () => {
                levels.push({ name: L.level + ' ' + (levels.length + 1), quorumType: 'any', quorumCount: null, approvers: [] });
                renderLevels();
            });
            ['DocType', 'MinAmount', 'MaxAmount', 'Priority', 'IsActive'].forEach(id => {
                document.getElementById(id).addEventListener('input', renderWarnings);
                document.getElementById(id).addEventListener('change', renderWarnings);
            });
            document.getElementById('wfForm').addEventListener('submit', refresh);

            renderLevels();
        })();
    </script>
}
