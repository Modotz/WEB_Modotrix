@model List<ERP.Web.Models.TaxRateViewModel>
@{
    ViewData["Title"] = T["Tarif Pajak"];
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var header = new ListHeaderModel
    {
        Title = T["Tarif PPN"],
        Count = Model.Count,
        Description = T["Tarif historis per tanggal berlaku"],
        PdfUrl = Url.Action("ExportPdf"),
        ExcelUrl = Url.Action("ExportExcel"),
        PrintUrl = Url.Action("PrintList"),
        AddOnClick = "openTaxModal()",
        AddText = T["Tambah Tarif"]
    };
}

<div class="page-heading supplier-page">

    <h3 class="fw-bold mb-3">@T["Tarif Pajak"]</h3>

    <div class="alert alert-info small">
        <i class="bi bi-info-circle me-1"></i>
        @T["PPN = DPP Nilai Lain × tarif nominal. Barang/jasa non-mewah: 12% × DPP 11/12 = efektif 11%; barang mewah 12% penuh. Ekspor 0% tetap kreditabel, Dibebaskan 0% tidak kreditabel — PPN Masukan tidak kreditabel dicatat sebagai bagian biaya/aset, bukan ke akun PPN Masukan."]
        <strong>@T["Tarif tidak pernah diedit saat kebijakan berubah:"]</strong>
        @T["isi \"berlaku sampai\" pada tarif lama lalu tambahkan tarif baru, supaya faktur lama tetap memakai tarifnya. \"Aktif\" hanya mengatur tampil di pilihan faktur."]
    </div>

    <div class="card supplier-card supplier-table-card">
        <partial name="_ListHeader" model="header" />

        <div class="collapse show" id="listBody">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 supplier-table first-left">
                <thead>
                    <tr>
                        <th class="ps-4">@T["NAMA"]</th>
                        <th class="text-end" style="width: 130px;">@T["TARIF"]</th>
                        <th class="text-end" style="width: 110px;">@T["EFEKTIF"]</th>
                        <th style="width: 140px;">@T["PPN MASUKAN"]</th>
                        <th style="width: 200px;">@T["BERLAKU"]</th>
                        <th class="text-end" style="width: 90px;">@T["DIPAKAI"]</th>
                        <th class="text-center" style="width: 100px;">@T["AKSI"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">@T["Belum ada tarif."]</td></tr>
                    }
                    @foreach (var r in Model)
                    {
                        var today = DateOnly.FromDateTime(DateTime.Today);
                        var inForce = r.ValidFrom <= today && (r.ValidTo == null || r.ValidTo >= today);
                        <tr class="@(r.IsActive ? "" : "opacity-50")">
                            <td class="ps-4 text-white">
                                @r.Name
                                @if (!r.IsActive)
                                {
                                    <span class="badge bg-dark ms-1">@T["Nonaktif"]</span>
                                }
                                @if (!string.IsNullOrEmpty(r.Note))
                                {
                                    <div class="text-white-50 small">@r.Note</div>
                                }
                            </td>
                            <td class="text-end text-white">@r.Formula</td>
                            <td class="text-end text-white fw-semibold">@r.EffectiveRate.ToString("0.##", Acc.Culture)%</td>
                            <td>
                                @if (r.IsInputCreditable)
                                {
                                    <span class="badge bg-success">@T["Kreditabel"]</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">@T["Tidak kreditabel"]</span>
                                }
                            </td>
                            <td class="small @(inForce ? "text-white" : "text-white-50")">
                                @r.ValidityLabel
                                @if (!inForce)
                                {
                                    <div class="text-white-50">@(r.ValidFrom > today ? T["belum berlaku"] : T["sudah berakhir"])</div>
                                }
                            </td>
                            <td class="text-end text-white-50 small">@(r.UsageCount == 0 ? "-" : r.UsageCount.ToString())</td>
                            <td class="text-center text-nowrap">
                                <div class="row-actions">
                                    <button type="button" class="act-btn act-edit btn-edit-tax" data-perm="update" title="@T["Ubah"]"
                                            data-tax="@System.Text.Json.JsonSerializer.Serialize(r)"><i class="bi bi-pencil"></i></button>
                                    @if (!r.IsUsed)
                                    {
                                        <form method="post" asp-action="Delete" asp-route-uid="@r.Uid" data-perm="delete"
                                              onsubmit='return confirm(@Json.Serialize(T["Hapus tarif {0}?", r.Name]));'>
                                            <button type="submit" class="act-btn act-delete" title="@T["Hapus"]"><i class="bi bi-trash"></i></button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        </div>
    </div>
</div>

<div class="modal fade" id="taxModal" tabindex="-1">
    <div class="modal-dialog">
        <form method="post" asp-action="Create" class="modal-content" id="taxForm">
            <input type="hidden" name="Uid" id="tUid" />
            <div class="modal-header">
                <h5 class="modal-title" id="taxTitle">@T["Tambah Tarif"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning small d-none" id="tLockedNote">@T["Tarif sudah dipakai faktur: tarif, pengali DPP, status kreditabel dan tanggal mulai terkunci."]</div>
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label" for="tName">@T["Nama"]</label>
                        <input type="text" class="form-control" name="Name" id="tName" maxlength="80" required />
                    </div>
                    <div class="col-4">
                        <label class="form-label" for="tNominal">@T["Tarif nominal (%)"]</label>
                        <input type="number" step="0.01" min="0" max="100" class="form-control text-end lockable" name="NominalRate" id="tNominal" required />
                    </div>
                    <div class="col-4">
                        <label class="form-label" for="tNum">@T["Pengali DPP"]</label>
                        <div class="input-group">
                            <input type="number" min="1" class="form-control text-end lockable" name="DppNumerator" id="tNum" required />
                            <span class="input-group-text">/</span>
                            <input type="number" min="1" class="form-control lockable" name="DppDenominator" id="tDen" required />
                        </div>
                    </div>
                    <div class="col-4">
                        <label class="form-label">@T["Tarif efektif"]</label>
                        <div class="form-control-plaintext text-white fw-semibold" id="tEffective">-</div>
                    </div>
                    <div class="col-6">
                        <label class="form-label" for="tFrom">@T["Berlaku dari"]</label>
                        <input type="date" class="form-control lockable" name="ValidFrom" id="tFrom" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label" for="tTo">@T["Berlaku sampai"]</label>
                        <input type="date" class="form-control" name="ValidTo" id="tTo" />
                    </div>
                    <div class="col-12">
                        <div class="form-check">
                            <input class="form-check-input lockable" type="checkbox" name="IsInputCreditable" value="true" id="tCreditable" checked />
                            <input type="hidden" name="IsInputCreditable" value="false" />
                            <label class="form-check-label" for="tCreditable">@T["PPN Masukan kreditabel (bisa dikreditkan dengan PPN Keluaran)"]</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="tActive" checked />
                            <input type="hidden" name="IsActive" value="false" />
                            <label class="form-check-label" for="tActive">@T["Aktif (tampil di pilihan faktur)"]</label>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="tNote">@T["Catatan"]</label>
                        <input type="text" class="form-control" name="Note" id="tNote" maxlength="255" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@T["Batal"]</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>@T["Simpan"]</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const $ = (id) => document.getElementById(id);
            const modal = new bootstrap.Modal($('taxModal'));
            const createUrl = '@Url.Action("Create")', updateUrl = '@Url.Action("Update")';
            const txtAdd = @Json.Serialize(T["Tambah Tarif"]), txtEdit = @Json.Serialize(T["Ubah Tarif"]);
            const today = '@DateTime.Today.ToString("yyyy-MM-dd")';

            function effective() {
                const n = parseFloat($('tNominal').value) || 0, a = parseInt($('tNum').value) || 1, b = parseInt($('tDen').value) || 1;
                $('tEffective').textContent = (Math.round(n * a / b * 100) / 100).toLocaleString('id-ID') + '%';
            }

            function open(r) {
                $('taxForm').action = r ? updateUrl : createUrl;
                $('taxTitle').textContent = r ? `${txtEdit} ${r.Name}` : txtAdd;
                $('tUid').value = r?.Uid ?? '';
                $('tName').value = r?.Name ?? '';
                $('tNominal').value = r?.NominalRate ?? 12;
                $('tNum').value = r?.DppNumerator ?? 1;
                $('tDen').value = r?.DppDenominator ?? 1;
                $('tFrom').value = r?.ValidFrom ?? today;
                $('tTo').value = r?.ValidTo ?? '';
                $('tCreditable').checked = r ? r.IsInputCreditable : true;
                $('tActive').checked = r ? r.IsActive : true;
                $('tNote').value = r?.Note ?? '';
                // Tarif yang sudah dipakai: komponen tarif terkunci (readonly, tetap terkirim).
                const locked = !!(r && r.IsUsed);
                document.querySelectorAll('#taxForm .lockable').forEach(el => {
                    if (el.type === 'checkbox') el.onclick = locked ? () => false : null; else el.readOnly = locked;
                });
                $('tLockedNote').classList.toggle('d-none', !locked);
                effective();
                modal.show();
            }

            ['tNominal', 'tNum', 'tDen'].forEach(id => $(id).addEventListener('input', effective));
            window.openTaxModal = () => open(null);
            document.querySelectorAll('.btn-edit-tax').forEach(b => b.addEventListener('click', () => open(JSON.parse(b.dataset.tax))));
        })();
    </script>
}
