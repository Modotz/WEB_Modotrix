@model ERP.Web.Models.BalanceSheetViewModel
@{
    ViewData["Title"] = T["Neraca"];
    var qs = $"?asOf={Model.AsOf:yyyy-MM-dd}";
    var header = new ListHeaderModel
    {
        Title = T["Per {0}", Acc.Date(Model.AsOf)],
        Description = T["Laba tahun berjalan = laba yang belum ditutup buku ke Laba Ditahan."],
        PdfUrl = Url.Action("ExportPdf") + qs,
        ExcelUrl = Url.Action("ExportExcel") + qs,
        PrintUrl = Url.Action("Print") + qs
    };
}

<div class="page-heading supplier-page">

    <h3 class="fw-bold mb-3">@T["Neraca"]</h3>

    <!-- FILTER CARD -->
    <div class="card supplier-card supplier-filter">
        <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-funnel"></i>
                <span class="fw-semibold">@T["Filter"]</span>
            </div>
            <button class="btn btn-sm text-muted p-0" type="button" data-bs-toggle="collapse" data-bs-target="#filterCollapse" aria-expanded="true" aria-controls="filterCollapse">
                <i class="bi bi-chevron-down"></i>
            </button>
        </div>
        <div class="collapse show" id="filterCollapse">
            <div class="card-body">
                <form method="get" asp-action="Index" class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label" for="asOf">@T["Per tanggal"]</label>
                        <input type="date" class="form-control" id="asOf" name="asOf" value="@Model.AsOf.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-auto d-flex gap-2">
                        <button type="submit" class="btn btn-primary d-flex align-items-center gap-2">
                            <i class="bi bi-search"></i>
                            @T["Terapkan"]
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary" title="@T["Reset Filter"]">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @if (Model.IsBalanced)
    {
        <div class="alert alert-success small py-2"><i class="bi bi-check-circle me-1"></i>@T["Seimbang: Aset = Liabilitas + Ekuitas."]</div>
    }
    else
    {
        <div class="alert alert-danger small py-2">
            <i class="bi bi-exclamation-octagon me-1"></i>@T["Tidak seimbang: selisih {0}. Data jurnal perlu diperiksa.", Acc.Money(Model.TotalAssets - Model.TotalLiabilitiesAndEquity)]
        </div>
    }

    <!-- DATA TABLE CARD -->
    <div class="card supplier-card supplier-table-card">
        <partial name="_ListHeader" model="header" />

        <div class="collapse show" id="listBody">
            <div class="table-responsive">
                <partial name="_Body" model="Model" />
            </div>
        </div>
    </div>
</div>
