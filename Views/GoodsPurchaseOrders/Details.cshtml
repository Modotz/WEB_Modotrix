@using ERP.Web.Models
@model GoodsPurchaseOrderViewModel

@{
    ViewData["Title"] = $"PO {Model.PONo}";

    var details = Model.Details ?? new List<GoodsPurchaseOrderItemViewModel>();
    var subtotal = details.Sum(x => x.Subtotal);

    var status = (Model.Status ?? "draft").Trim().ToLowerInvariant();
    var isDraft = status == "draft";
    var isCancelled = status == "cancelled" || status == "canceled";
    var statusText = status.Replace("_", " ");
    var approval = ViewData["Approval"] as ApprovalDocumentViewModel;
    var needsApproval = approval?.RequiresApproval == true;
    var isPendingApproval = status == "pending_approval";
      
    var statusClass = (status == "draft" || status == "pending")
    ? "product-badge-unit"
    : status == "partial"
        ? "product-badge-serial"
        : status == "received"
            ? "product-badge-stock"
            : "product-badge-no-stock";
    var no = 1;

}



<div class="po-view-page">
     
    <h1 class="po-view-title">PO @Model.PONo</h1> 
    <section class="po-view-card po-info-card"> 
        <div class="po-view-card-header po-info-header">

            <div class="po-info-heading">
                <strong>PO @Model.PONo</strong>

                <span class="po-status-badge @statusClass">
                    @statusText
                </span>
            </div>

            <div class="po-actions">

                @if (isDraft)
                {
                    <a asp-controller="GoodsPurchaseOrders"
                       asp-action="Edit"
                       asp-route-uid="@Model.Uid"
                       data-perm="update"
                       class="btn btn-warning btn-sm">
                        <i class="bi bi-pencil"></i> @T["Edit"]
                    </a>

                    <form asp-action="Approve"
                          asp-route-uid="@Model.Uid"
                          method="post"
                          data-perm="update"
                          class="po-action-form">
                        @Html.AntiForgeryToken()

                        <button type="button"
                                class="btn btn-primary btn-sm"
                                data-bs-toggle="modal"
                                data-bs-target="#approvePOModal">
                            @if (needsApproval)
                            {
                                <i class="bi bi-send"></i> @T["Ajukan Persetujuan"]
                            }
                            else
                            {
                                <i class="bi bi-check2-circle"></i> @T["Setujui"]
                            }
                        </button>
                    </form>

                    <button type="button"
                            class="btn btn-outline-danger btn-sm"
                            data-perm="update"
                            data-bs-toggle="modal"
                            data-bs-target="#cancelPOModal">
                        <i class="bi bi-x-circle"></i> @T["Batalkan"]
                    </button>
                }

                @if (status == "ordered" || status == "partial")
                {
                    <a asp-controller="GoodsReceipts"
                       asp-action="Create"
                       asp-route-poUid="@Model.Uid"
                       data-perm="goods-receipts:create"
                       class="btn btn-success btn-sm d-inline-flex">
                        <i class="bi bi-box-arrow-in-down"></i> @T["Terima Barang"]
                    </a>

                    <button type="button"
                            class="btn btn-outline-danger btn-sm"
                            data-perm="update"
                            onclick='alert(@Json.Serialize(T["Fitur pengajuan pembatalan akan dibuat berikutnya."]));'>
                        <i class="bi bi-x-circle"></i> @T["Ajukan Pembatalan"]
                    </button>
                }

                @if (isCancelled || status == "received")
                {
                    <form asp-action="Delete"
                          asp-route-uid="@Model.Uid"
                          method="post"
                          data-perm="delete"
                          class="po-action-form"
                          onsubmit='return confirm(@Json.Serialize(T["Yakin ingin menghapus Purchase Order ini?"]));'>
                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-outline-danger btn-sm"
                                title="@T["Hapus PO"]">
                            <i class="bi bi-trash"></i>
                        </button>
                    </form>
                }

                <a asp-controller="GoodsPurchaseOrders"
                   asp-action="Print"
                   asp-route-uid="@Model.Uid"
                   target="_blank"
                   class="btn btn-light btn-sm">
                    <i class="bi bi-printer"></i> @T["Cetak"]
                </a>

                <a asp-controller="GoodsPurchaseOrders"
                   asp-action="ExportPdf"
                   asp-route-uid="@Model.Uid"
                   class="btn btn-danger btn-sm">
                    <i class="bi bi-file-pdf"></i> PDF
                </a>

                <a asp-action="Index"
                   class="btn btn-secondary btn-sm"
                   title="@T["Kembali"]">
                    <i class="bi bi-arrow-left"></i>
                </a>

            </div>

        </div>

       
        <div class="po-info-grid">

            <div class="po-info-column">

                <div class="po-info-row">
                    <strong>@T["Tanggal PO"]</strong>
                    <span>@Model.PODate.ToString("yyyy-MM-dd")</span>
                </div>

                <div class="po-info-row">
                    <strong>@T["Supplier"]</strong>
                    <span>@(Model.SupplierName ?? "-")</span>
                </div>

                <div class="po-info-row">
                    <strong>@T["Catatan"]</strong>
                    <span>
                        @(string.IsNullOrWhiteSpace(Model.Note)
                            ? "-"
                            : Model.Note)
                    </span>
                </div>

            </div>

            <div class="po-info-column">

                <div class="po-info-row">
                    <strong>@T["Perkiraan Terima"]</strong>
                    <span>
                        @(Model.ExpectedDate?.ToString("yyyy-MM-dd") ?? "-")
                    </span>
                </div>

                <div class="po-info-row">
                    <strong>@T["Gudang Tujuan"]</strong>
                    <span>@(Model.WarehouseName ?? "-")</span>
                </div>

            </div>

        </div>
    </section>

    @if (isPendingApproval)
    {
        <div class="alert alert-warning small mt-3 mb-0">
            <i class="bi bi-hourglass-split me-1"></i>@T["PO ini sedang menunggu persetujuan; tidak dapat diubah, dihapus, atau dibatalkan sampai diputuskan atau pengajuannya ditarik."]
        </div>
    }

    @if (approval != null)
    {
        approval.ReturnUrl = Url.Action("Details", new { uid = Model.Uid });
        <partial name="_ApprovalPanel" model="approval" />
    }

    <!-- ITEM PURCHASE ORDER -->
    <section class="po-view-card po-items-card">

        <div class="po-view-card-header">
            <strong>@T["Item"]</strong>
        </div>

        <div class="po-table-wrapper">
            <table class="table po-items-table">

                <thead>
                    <tr>
                        <th class="po-number-col">#</th>
                        <th class="text-start">@T["Produk"]</th>
                        <th class="text-start">@T["Satuan"]</th>
                        <th>@T["Qty Pesan"]</th>
                        <th>@T["Diterima"]</th>
                        <th>@T["Sisa"]</th>
                        <th>@T["Harga"]</th>
                        <th>@T["Disk%"]</th>
                        <th class="text-end">@T["Subtotal"]</th>
                    </tr>
                </thead>

                <tbody>
                    @if (details.Any())
                    {
                        no = 1;

                        foreach (var item in details)
                        {
                            var remainingQty = item.Qty - item.ReceivedQty;

                            <tr>
                                <td class="po-number-col">@no</td>

                                <td class="text-start po-product-cell">
                                    <div class="po-product-name">
                                        @item.ProductName
                                    </div>

                                    <small class="po-muted">
                                        input: @item.Qty.ToString("N0") @item.UnitCode
                                    </small>
                                </td>

                                <td class="text-start">
                                    @item.UnitCode
                                </td>

                                <td class="text-end">
                                    @item.Qty.ToString("N0")
                                </td>

                                <td class="text-end">
                                    @item.ReceivedQty.ToString("N0")
                                </td>

                                <td class="text-end">
                                    <span class="po-remaining-value @(remainingQty > 0 ? "has-remaining" : "fully-received")">
                                        @remainingQty.ToString("N0")
                                    </span>
                                </td>

                                <td class="text-end">
                                    @item.UnitPrice.ToString("N0", new System.Globalization.CultureInfo("id-ID"))
                                </td>

                                <td class="text-end">
                                    @((item.DiscPercent ?? 0).ToString("N0"))
                                </td>

                                <td class="text-end po-money">
                                    @item.Subtotal.ToString("N0", new System.Globalization.CultureInfo("id-ID"))
                                </td>
                            </tr>

                            no++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="po-empty">
                                <i class="bi bi-inbox"></i>
                                @T["Belum ada item Purchase Order."]
                            </td>
                        </tr>
                    }
                </tbody>

                <tfoot>
                    <tr class="po-subtotal-row">
                        <td colspan="8" class="text-end">@T["Subtotal"]</td>
                        <td class="text-end po-money">
                            @subtotal.ToString("N0",  new System.Globalization.CultureInfo("id-ID"))
                        </td>
                    </tr>

                    <tr class="po-subtotal-row">
                        <td colspan="8" class="text-end">@T["Diskon"]</td>
                        <td class="text-end po-money">
                           - @Model.DiscountAmount.ToString("N0", new System.Globalization.CultureInfo("id-ID"))
                        </td>
                    </tr>

                    <tr class="po-subtotal-row">
                        <td colspan="8" class="text-end">
                            @(T["Pajak"])(@Model.TaxPercent.ToString("N0", new System.Globalization.CultureInfo("id-ID"))%)
                        </td>
                        <td class="text-end po-money">
                            @Model.TaxAmount.ToString("N0", new System.Globalization.CultureInfo("id-ID"))
                        </td>
                    </tr>

                    <tr class="po-total-row">
                        <td colspan="8" class="text-end">@T["Total"]</td>
                        <td class="text-end po-money">
                            @Model.TotalAmount.ToString("N0", new System.Globalization.CultureInfo("id-ID"))
                        </td>
                    </tr>
                </tfoot>

            </table>
        </div>
    </section>

    <!-- PENERIMAAN TERKAIT -->
    <div class="po-receipt-grid">

        <!-- DAFTAR PENERIMAAN -->
        <section class="po-view-card po-related-card">

            <div class="po-view-card-header">
                <strong>@T["Penerimaan Terkait"]</strong>
            </div>

            <div class="po-table-wrapper">
                <table class="table po-related-table">

                    <thead>
                        <tr>
                            <th>@T["No. Penerimaan"]</th>
                            <th>@T["Tanggal"]</th>
                            <th>@T["Faktur"]</th>
                        </tr>
                    </thead>

                    <tbody>
                        <tr>
                            <td colspan="3" class="po-empty">
                                @T["Belum ada penerimaan."]
                            </td>
                        </tr>
                    </tbody>

                </table>
            </div>
        </section>

        <!-- DETAIL PENERIMAAN -->
        <section class="po-view-card po-related-detail-card">

            <div class="po-view-card-header">
                <strong>@T["Detail Penerimaan Terkait"]</strong>
            </div>

            <div class="po-table-wrapper">
                <table class="table po-related-table">

                    <thead>
                        <tr>
                            <th class="po-number-col">#</th>
                            <th class="text-start">@T["Produk"]</th>
                            <th>@T["Qty (Satuan)"]</th>
                            <th>@T["Qty Dasar"]</th>
                            <th>@T["Harga"]</th>
                            <th class="text-end">@T["Subtotal"]</th>
                        </tr>
                    </thead>

                    <tbody>
                        <tr>
                            <td colspan="6" class="po-empty">
                                <i class="bi bi-arrow-left"></i>
                                @T["Klik ikon"] <i class="bi bi-eye"></i>
                                @T["pada daftar penerimaan untuk melihat detailnya di sini."]
                            </td>
                        </tr>
                    </tbody>

                </table>
            </div>
        </section>

    </div>

</div>

@* modal pesan*@
 
@if (isDraft)
{
    <div class="modal fade"
         id="cancelPOModal"
         tabindex="-1"
         aria-labelledby="cancelPOModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="cancelPOModalLabel">
                        @T["Konfirmasi Pembatalan PO"]
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="@T["Tutup"]">
                    </button>
                </div>

                <div class="modal-body">
                    @T["Apakah kamu yakin ingin membatalkan Purchase Order"]
                    <strong>@Model.PONo</strong>?
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary btn-sm"
                            data-bs-dismiss="modal">
                        @T["Tidak"]
                    </button>

                    <form asp-action="Cancel"
                          asp-route-uid="@Model.Uid"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-danger btn-sm">
                            @T["Ya, batalkan"]
                        </button>
                    </form>
                </div>

            </div>
        </div>
    </div>

    
@if (isDraft)
{
    <div class="modal fade"
         id="approvePOModal"
         tabindex="-1"
         aria-labelledby="approvePOModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="approvePOModalLabel">
                        @T["Konfirmasi Persetujuan PO"]
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="@T["Tutup"]">
                    </button>
                </div>

                <div class="modal-body">
                    @if (needsApproval)
                    {
                        <text>@T["PO ini memerlukan persetujuan sesuai alur"] <strong>@approval!.Preview.WorkflowName</strong>. @T["Ajukan Purchase Order"] <strong>@Model.PONo</strong>?</text>
                    }
                    else
                    {
                        <text>@T["Apakah kamu yakin ingin menyetujui Purchase Order"] <strong>@Model.PONo</strong>?</text>
                    }
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary btn-sm"
                            data-bs-dismiss="modal">
                        @T["Tidak"]
                    </button>

                    <form asp-action="Approve"
                          asp-route-uid="@Model.Uid"
                          method="post">
                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-primary btn-sm">
                            <i class="bi bi-check2-circle"></i>
                            @(needsApproval ? T["Ya, ajukan"] : T["Ya, setujui"])
                        </button>
                    </form>
                </div>

            </div>
        </div>
    </div>
}

}
