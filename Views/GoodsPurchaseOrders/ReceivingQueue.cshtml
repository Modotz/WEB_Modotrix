@using ERP.Web.Models
@model PagedResult<GoodsPurchaseOrderViewModel> 

@{
    ViewData["Title"] = T["Antrian Penerimaan"];

    @*var culture = new CultureInfo("id-ID");*@
    var no = (Model.Page - 1) * Model.PageSize;

    var search = Context.Request.Query["search"].ToString();
    var suppliers = ViewBag.Suppliers as IEnumerable<DropdownItemViewModel> ?? Enumerable.Empty<DropdownItemViewModel>();
    var warehouses = ViewBag.Warehouses as IEnumerable<DropdownItemViewModel> ?? Enumerable.Empty<DropdownItemViewModel>();
    var selectedStatus = Context.Request.Query["status"].ToString();
}

<div class="product-page-title">
    @T["Antrian Penerimaan"]
</div>


<div class="product-info-card">
    <div class="product-info-header"
         data-bs-toggle="collapse"
         data-bs-target="#productInfo">
        <div class="text-small"> 
            <i class="bi bi-box-arrow-in-down"></i><strong> @T["Antrian Penerimaan"]</strong> —  @T["PO Barang yang sudah dipesan & masih ada sisa untuk diterima. Urut dari yang paling lama."] 
            @Html.Raw(T["Klik <strong>Terima</strong> untuk memproses penerimaan."])
        </div>
    </div>
</div>


<div class="product-filter-card">

    <div class="product-filter-header"
         data-bs-toggle="collapse"
         data-bs-target="#productFilter">

        <div class="product-filter-title">
            <i class="bi bi-funnel"></i>
            <span>@T["Filter"]</span>
        </div>

        <i class="bi bi-chevron-down"></i>

    </div>


    <div id="productFilter"
         class="collapse show">

        <div class="product-filter-body">

            <form method="get"
                  asp-action="Index"
                  asp-controller="GoodsPurchaseOrders">

                <div class="product-filter-row">
                    <div>
                        <label class="product-filter-label">
                            @T["Cari (No. PO)"]
                        </label>

                        <input type="text" class="form-control"
                               id="search"
                               name="search"
                               value="@Context.Request.Query["search"]"
                        />
                    </div>
                 
                    <div>
                        <label class="product-filter-label">
                            @T["Supplier"]
                        </label>

                        <select name="supplierId" class="form-select">
                            <option value="">@T["-- Semua --"]</option> 
                            @foreach (var supplier in suppliers)
                            {
                                <option value="@supplier.Id"
                                        selected="@(Context.Request.Query["supplierId"] == supplier.Id.ToString())">
                                    @supplier.Name
                                </option>
                            }
                        </select>
                    </div> 
                 
                    <div>
                        <label class="product-filter-label">
                            @T["Gudang"]
                        </label>

                        <select name="warehouseId" class="form-select">
                            <option value="">@T["-- Semua --"]</option> 
                            @foreach (var warehouse in warehouses)
                            {
                                <option value="@warehouse.Id"
                                        selected="@(Context.Request.Query["warehouseId"] == warehouse.Id.ToString())">
                                    @warehouse.Name
                                </option>
                            }
                        </select>
                    </div> 
                    <div>

                        <label class="product-filter-label">
                            @T["Per Halaman"]
                        </label>
                        <select name="pageSize"
                                class="form-select"
                                onchange="this.form.submit()">

                            <option value="10" selected="@(Model.PageSize == 10)">10</option>
                            <option value="25" selected="@(Model.PageSize == 25)">25</option>
                            <option value="50" selected="@(Model.PageSize == 50)">50</option>
                            <option value="100" selected="@(Model.PageSize == 100)">100</option>

                        </select>
                    </div>
                    
                        <div class="product-filter-actions mt-4"> 
                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="bi bi-search me-1"></i>
                                @T["Terapkan"]

                            </button>


                            <a asp-action="Index"
                               asp-controller="Products"
                               class="btn filter-reset-btn">
                                <i class="bi bi-arrow-counterclockwise"></i>
                                @T["Reset"]
                            </a>

                        </div> 
                   </div> 
            </form>
        </div>
    </div>
</div>

<div class="product-table-card">
    <div class="product-table-header">
        <div class="product-table-heading">

            <span class="product-table-title"> @T["PO Siap Terima"] </span>
            <span class="badge badge-count"> @Model.TotalCount </span> 
        </div>

         <div class="d-flex align-items-center gap-2">
            <!-- Refresh Data -->
            <button type="button"
                    class="btn btn-light p-1 px-2 btn-custom-square"
                    title="@T["Refresh Data"]"
                    onclick="loadProducts()">
                <i class="bi bi-arrow-clockwise"></i>
            </button>

            <!-- Expand / Collapse -->
            <button type="button" 
                    class="btn btn-light p-1 px-2 btn-custom-square "
                    title="Toggle">
                <i class="bi bi-chevron-up"></i>
            </button> 
          </div>
    </div>


    <!-- TABLE -->

    <div id="productTableBody"
         class="collapse show">
        <div class="product-table-wrapper">
            <table class="table product-table">
                <thead>
                    <tr>
                        <th class="text-center" >#</th> 
                        <th class="text-start" >@T["NO. PO"]</th>
                        <th class="text-start" >@T["TANGGAL"]</th>
                        <th class="text-start" >@T["SUPPLIER"]</th>
                        <th class="text-start" >@T["GUDANG"]</th>
                        <th class="text-start" >@T["SISA QTY"]</th>
                        <th class="text-start" >@T["STATUS"]</th>
                        <th class="text-center">@T["AKSI"]</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Data != null && Model.Data.Any())
                    {
                        foreach (var item in Model.Data)
                        {
                            no++;

                            var status = (item.Status ?? "draft")
                                .Trim()
                                .ToLowerInvariant();

                            var statusText = status switch
                            {
                                "draft" => T["Draft"],
                                "pending" => T["Menunggu Persetujuan"],
                                "ordered" => "Ordered",
                                "partial" => "Partial",
                                "received" => "Received",
                                "cancelled" => "Cancelled", 
                                _ => item.Status
                            };

                            var statusClass = status switch
                            {
                                "draft" or "pending" => "product-badge-unit", 
                                "partial"  => "product-badge-serial", 
                                "received"  => "product-badge-stock", 
                                "cancelled"  => "product-badge-no-stock",
                                  
                                _ => "product-badge-type"
                            };

                            <tr>
                                <td class="text-center">
                                    @no
                                </td>

                                <td class="text-start">
                                    <span class="product-number ">
                                        @item.PONo
                                    </span>
                                </td>

                                <td class="text-start" >
                                    @item.PODate.ToString("dd MMM yyyy")
                                </td>

                                <td class="text-start">
                                   @if (!string.IsNullOrWhiteSpace(item.SupplierName))
                                    {
                                        <span class="product-badge">
                                            @item.SupplierName
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-description">
                                            -
                                        </span>
                                    } 
                                </td>
                                 

                                <td class="text-start">
                                   @if (!string.IsNullOrWhiteSpace(item.WarehouseName))
                                    {
                                        <span class="product-badge product-badge-brand">
                                            @item.WarehouseName
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-description">
                                            -
                                        </span>
                                    } 
                                </td>

                                <td class="text-start">
                                    <span class="product-badge">
                                        @* @item.ReceivedQuantity.ToString("N0", new System.Globalization.CultureInfo("id-ID")) *@
                                    </span>
                                </td> 

                                <td class="text-start">
                                    <span class="product-badge @statusClass">
                                        @statusText
                                    </span>
                                </td>
  
                                <td class="text-center">
                                    <div class="row-actions">
                                        <a asp-controller="GoodsReceipts"
                                           asp-action="Create"
                                           asp-route-poUid="@item.Uid"
                                           data-perm="goods-receipts:create"
                                           class="act-btn act-other"
                                           title="@T["Terima Barang"]">
                                            <i class="bi bi-box-arrow-in-down"></i>
                                        </a>

                                        <a asp-controller="GoodsPurchaseOrders"
                                           asp-action="Details"
                                           asp-route-uid="@item.Uid"
                                           class="act-btn act-view"
                                           title="@T["Detail PO"]">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="product-empty">
                                <i class="bi bi-inbox"></i>
                                @T["Tidak ada data Antrian Penerimaan Barang."]
                            </td>
                        </tr>
                    }

                </tbody>

            </table>
        </div>

        <!-- Footer / Pagination !-->
        <div class="card-footer bg-transparent border-top-0 d-flex justify-content-between align-items-center py-3">
         @{
             var startItem = Model.TotalCount == 0 ? 0 : ((Model.Page - 1) * Model.PageSize) + 1;
             var endItem = Math.Min(Model.Page * Model.PageSize, Model.TotalCount);
          }
          <span class="menu-description small"> @T["Menampilkan"] <strong>@startItem – @endItem</strong> @T["dari"] <strong>@Model.TotalCount</strong> @T["data"] </span>
          @{
             var currentPage = Model.Page;
             var totalPages = Model.TotalPage;
           }
              <nav aria-label="Pagination">
                 <ul class="pagination">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                       <a class="page-link" href="@Url.Action("Index", new
                            {
                                page = currentPage - 1,
                                pageSize = Model.PageSize,
                                search = Context.Request.Query["search"].ToString(),
                                brandId = Context.Request.Query["brandId"].ToString(),
                                categoryId = Context.Request.Query["categoryId"].ToString(),
                                subCategoryId = Context.Request.Query["subCategoryId"].ToString(),
                                productType = Context.Request.Query["productType"].ToString(),
                                unitId = Context.Request.Query["unitId"].ToString(),
                                trackStock = Context.Request.Query["trackStock"].ToString(),
                                isActive = Context.Request.Query["isActive"].ToString(),
                                showVariant = Context.Request.Query["showVariant"].ToString()
                            })">
                             @T["Sebelumnya"]
                       </a>
                    </li>

                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">

                            <a class="page-link"
                               href="@Url.Action("Index", new
                               {
                                   page = i,
                                   pageSize = Model.PageSize,
                                   search = Context.Request.Query["search"].ToString(),
                                   brandId = Context.Request.Query["brandId"].ToString(),
                                   categoryId = Context.Request.Query["categoryId"].ToString(),
                                   subCategoryId = Context.Request.Query["subCategoryId"].ToString(),
                                   productType = Context.Request.Query["productType"].ToString(),
                                   unitId = Context.Request.Query["unitId"].ToString(),
                                   trackStock = Context.Request.Query["trackStock"].ToString(),
                                   isActive = Context.Request.Query["isActive"].ToString(),
                                   showVariant = Context.Request.Query["showVariant"].ToString()
                               })">

                                @i

                            </a>

                        </li>
                    }
                       <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">

                            <a class="page-link"
                               href="@Url.Action("Index", new
                               {
                                   page = currentPage + 1,
                                   pageSize = Model.PageSize,
                                   search = Context.Request.Query["search"].ToString(),
                                   brandId = Context.Request.Query["brandId"].ToString(),
                                   categoryId = Context.Request.Query["categoryId"].ToString(),
                                   subCategoryId = Context.Request.Query["subCategoryId"].ToString(),
                                   productType = Context.Request.Query["productType"].ToString(),
                                   unitId = Context.Request.Query["unitId"].ToString(),
                                   trackStock = Context.Request.Query["trackStock"].ToString(),
                                   isActive = Context.Request.Query["isActive"].ToString(),
                                   showVariant = Context.Request.Query["showVariant"].ToString()
                               })">

                                @T["Berikutnya"]

                            </a>

                        </li>
                   </ul>
              </nav>
        </div>  
    </div>
</div> 