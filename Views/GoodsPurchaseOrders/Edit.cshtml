@using System.Text.Json
@using ERP.Web.Models
@using System.Globalization
@model GoodsPurchaseOrderViewModel

@{
    ViewData["Title"] = "Edit PO Barang";
    var idCulture = new CultureInfo("id-ID"); 
    string FormatRupiah(decimal? value)
    {
        var nominal = value ?? 0m; 
        return nominal.ToString(
            nominal % 1m == 0m ? "N0" : "N2", idCulture
        );
    }
    

    string FormatAngka(decimal? value)
    {
        return (value ?? 0m).ToString(
            "0.##", CultureInfo.InvariantCulture
        );
    }

    var suppliers = ViewBag.Suppliers as IEnumerable<SupplierViewModel> ?? Enumerable.Empty<SupplierViewModel>(); 
    var warehouses = ViewBag.Warehouses as IEnumerable<WarehouseViewModel> ?? Enumerable.Empty<WarehouseViewModel>(); 
    var products = ViewBag.Products as IEnumerable<ProductViewModel> ?? Enumerable.Empty<ProductViewModel>(); 
    var units = ViewBag.Units as IEnumerable<DropdownItemViewModel> ?? Enumerable.Empty<DropdownItemViewModel>();

    var orderedProducts = products
        .OrderBy(p => string.IsNullOrWhiteSpace(p.CategoryName) ? 0 : 1)
        .ThenBy(p => p.CategoryName)
        .ThenBy(p => p.Name)
        .ToList();

    var productOptions = products.Select(p => new
    {
        id = p.Id,
        name = p.Name,
        sku = p.Sku,
        categoryName = p.CategoryName,
        unitId = p.UnitId,
        unitName = p.UnitName,
        costPrice = p.CostPrice
    }).ToList();

    var unitOptions = units.Select(u => new
    {
        id = u.Id,
        code = u.Code,
        name = u.Name
    }).ToList();

    var productsJson = JsonSerializer.Serialize(productOptions);
    var unitsJson = JsonSerializer.Serialize(unitOptions);

}

 <div class="po-create-page">
     <div class="product-page-title">
            Edit PO Barang
     </div>

      <div class="product-info-card">
            <div class="product-info-header"
                 data-bs-toggle="collapse"
                 data-bs-target="#productInfo">
                <div>
                    <i class="bi bi-info-circle-fill me-2"></i>
                    <strong>Panduan Pengisian - PO Barang </strong>
                </div>
                <i class="bi bi-chevron-down"></i>
            </div>

            <div id="productInfo"
                 class="collapse show">

                <div class="product-info-body">
                    <ol class="ps-3 mb-0">
                        <li>
                            Isi <strong> Tanggal PO </strong>, pilih <strong>Supplier</strong> dan <strong>Gudang Tujuan.</strong>
                            <i> Perkiraan Terima & Catatan opsional.</i>
                        </li>

                        <li>
                            Klik <strong> Tambah Baris, </strong> lalu pada kolom  <strong> Produk </strong> ketik nama/kode untuk mencari. Isi <strong>Qty,</strong>
                            pilih <strong>Satuan, </strong>dan isi <strong>Harga</strong>
                        </li>

                        <li>
                            Bila perlu, isi <strong> Disk % </strong> dan <strong> Pajak % </strong> per baris - <i>Subtotal </i> dihitung otomatis.
                        </li>

                        <li>
                            Di bagian bawah bisa menambah <stong>Diskon Nota (Rp) </stong>dan <strong>Pajak (%) </strong>tingkat nota untuk memperoleh Total.
                        </li>

                        <li>
                            Klik <strong>Simpan Draft </strong>untuk menyimpan PO. <strong>Stok belum berubah</strong> di tahap ini — stok bertambah nanti saat barang diterima lewat menu
                            <strong> Penerimaan.</strong>
                        </li>

                    </ol>

                    <div class="product-info-tip">
                        <i class="bi bi-lightbulb"></i>
                        Tips : gunakan tombol <span class="required-mark"> x </span> untuk menghapus baris. Panel ini bisa ditutup dengan mengklik judulnya.
                    </div>

              </div>
         
         </div>
     </div>

    <form method="post"
          asp-controller="GoodsPurchaseOrders"
          asp-action="Update">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="PRId" />
        <input type="hidden" asp-for="RFQId" />
            <!-- FORM PURCHASE ORDER -->
            <div class="card po-detail-card">
                <div class="card-header">
                    <strong>Edit Purchase Order</strong>
                </div>

                <div class="card-body">
                    @Html.AntiForgeryToken()

                     @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger mb-3">
                                <strong>Data belum dapat disimpan.</strong>

                                <ul class="mb-0 mt-2">
                                    @foreach (var item in ViewData.ModelState)
                                    {
                                        @foreach (var error in item.Value.Errors)
                                        {
                                            <li>
                                                @*<strong>
                                                    @(string.IsNullOrWhiteSpace(item.Key)
                                                        ? "Form"
                                                        : item.Key)
                                                </strong>:*@

                                                @(string.IsNullOrWhiteSpace(error.ErrorMessage)
                                                    ? error.Exception?.GetBaseException().Message
                                                        ?? "Nilai yang dimasukkan tidak valid."
                                                    : error.ErrorMessage)
                                            </li>
                                        }
                                    }
                                </ul>
                            </div>
                        }

                        @if (TempData["Error"] != null)
                        {
                            <div class="alert alert-danger">
                                <strong>Gagal menyimpan:</strong>
                                @TempData["Error"]
                            </div>
                        }

                    <!-- INFORMASI PO -->
                    <div class="row g-2 mb-2">
                        <div class="col-md-4">
                            <label class="form-label">No. PO</label>
                            <input type="text"
                                   class="form-control"
                                   id="PONo"
                                   name="PONo"
                                   value="@Model?.PONo"
                                   placeholder="Nomor PO"
                                   readonly />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">
                                Tanggal PO <span class="text-danger">*</span>
                            </label>

                            <input type="date"
                                   class="form-control"
                                   id="PODate"
                                   name="PODate"
                                   value="@((Model?.PODate ?? DateOnly.FromDateTime(DateTime.Today)).ToString("yyyy-MM-dd"))"
                                   required />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Perkiraan Terima</label>

                            <input type="date"
                                   class="form-control"
                                   id="ExpectedDate"
                                   name="ExpectedDate"
                                   value="@(Model?.ExpectedDate?.ToString("yyyy-MM-dd") ?? "")" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">
                                Supplier <span class="text-danger">*</span>
                            </label>
                            <select class="form-select"
                                    id="SupplierId"
                                    name="SupplierId"
                                    required>
                                <option value="">-- Pilih Supplier --</option>

                                @foreach (var supplier in suppliers)
                                {
                                <option value="@supplier.Id"
                                        selected="@(Model?.SupplierId == supplier.Id)">
                                    @supplier.Name
                                </option>
                                }
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">
                                Gudang Tujuan <span class="text-danger">*</span>
                            </label>
                            <select class="form-select"
                                    id="WarehouseId"
                                    name="WarehouseId"
                                    required>
                                <option value="">-- Pilih Gudang --</option>

                                @foreach (var warehouse in warehouses)
                                {
                                <option value="@warehouse.Id"
                                        selected="@(Model?.WarehouseId == warehouse.Id)">
                                    @warehouse.Name
                                </option>
                                }
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Catatan</label>
                            <input type="text"
                                   class="form-control"
                                   id="Note"
                                   name="Note"
                                   value="@Model?.Note" />
                        </div>
                    </div>
                </div>

            </div>

            <!-- DETAIL ITEM -->
            <div class="card mt-2">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Detail Item</strong>
                    <button type="button"
                            class="btn btn-sm btn-add-row"
                            id="btnTambahBaris">
                        <i class="bi bi-plus-lg"></i> Tambah Baris
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0"
                           id="tableDetail">
                        <thead>
                            <tr>
                                <th style="width:32px">#</th>
                                <th>PRODUK<span class="text-danger">*</span></th>
                                <th style="width:80px">QTY</th>
                                <th style="width:85px">SATUAN</th>
                                <th style="width:100px">HARGA</th>
                                <th style="width:65px">DISK %</th>
                                <th style="width:65px">PAJAK %</th>
                                <th style="width:110px">SUBTOTAL</th>
                                <th style="width:35px"></th>
                            </tr>
                        </thead>
                       <tbody id="detailBody">
                            @if (Model.Details != null && Model.Details.Any())
                            {
                                for (var i = 0; i < Model.Details.Count; i++)
                                {
                                    var detail = Model.Details[i];

                                    <tr>
                                        <td class="row-number text-end">@(i + 1)</td>

                                    <td>
                                        <select class="form-select form-select-sm product-select"
                                                name="Details[@i].ProductId"
                                                required>
                                            <option value="">-- Cari produk --</option>

                                            @if (!orderedProducts.Any(p =>
                                                Convert.ToInt64(p.Id) == Convert.ToInt64(detail.ProductId)))
                                            {
                                                <option value="@detail.ProductId" selected>
                                                    Produk ID @detail.ProductId
                                                </option>
                                            }

                                            @foreach (var product in orderedProducts)
                                            {
                                                <option value="@product.Id"
                                                        selected="@(Convert.ToInt64(detail.ProductId) == Convert.ToInt64(product.Id))">
                                                    @(string.IsNullOrWhiteSpace(product.Sku) ? "-" : product.Sku)
                                                    - @product.Name
                                                </option>
                                            }
                                        </select>
                                    </td>

                                        <td>
                                            <input type="number"
                                                   class="form-control form-control-sm qty"
                                                   name="Details[@i].Qty"
                                                   min="0.01"
                                                   step="0.01"
                                                   value="@detail.Qty.ToString("N0")"
                                                   required />
                                        </td>

                                        <td>
                                            <select class="form-select form-select-sm unit-select"
                                                    name="Details[@i].UnitId"
                                                    required>
                                                <option value="">-</option>

                                                @foreach (var unit in units.OrderBy(u => u.Code))
                                                {
                                                    <option value="@unit.Id"
                                                            selected="@(detail.UnitId == unit.Id)">
                                                        @unit.Code
                                                    </option>
                                                }
                                            </select>
                                        </td>

                                    
                                        <td>
                                            <input type="text"
                                                   class="form-control form-control-sm price currency-input"
                                                   name="Details[@i].UnitPrice"
                                                   value="@FormatRupiah(detail.UnitPrice)"
                                                   data-raw="@FormatAngka(detail.UnitPrice)"
                                                   inputmode="decimal"
                                                   required />
                                        </td>

                                        <td>
                                            <input type="number"
                                                   class="form-control form-control-sm discount"
                                                   name="Details[@i].DiscPercent"
                                                   min="0"
                                                   max="100"
                                                   step="0.01"
                                                   value="@((detail.DiscPercent ?? 0m).ToString("0.##", CultureInfo.InvariantCulture))" />
                                                    
                                        </td>

                                        <td>
                                            <input type="number"
                                                   class="form-control form-control-sm tax"
                                                   name="Details[@i].TaxPercent"
                                                   min="0"
                                                   max="100"
                                                   step="0.01"
                                                   value="@((detail.TaxPercent ?? 0m).ToString("0.##", CultureInfo.InvariantCulture))" />
                                        </td>

                                        <td>
                                            <input type="text"
                                                   class="form-control form-control-sm subtotal currency-input"
                                                   name="Details[@i].Subtotal"
                                                   value="@FormatRupiah(detail.Subtotal)"
                                                   data-raw="@FormatAngka(detail.Subtotal)"
                                                   readonly />
                                        </td>

                                        <td>
                                            <button type="button"
                                                    class="btn btn-sm btn-danger btn-hapus"
                                                    title="Hapus baris">×</button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <!-- TOTAL -->
                <div class="po-summary-wrap">
                    <div class="row justify-content-end">
                        <div class="col-md-5">
                            <div class="table-responsive">
                                <table class="table table-sm table-bordered mb-0">
                                    <tbody>
                                        <tr>
                                            <td>Subtotal</td> 
                                            <td>
                                                <input type="text"
                                                       class="form-control form-control-sm text-end currency-input"
                                                       id="SubtotalAmount"
                                                       name="SubtotalAmount"
                                                       value="@FormatRupiah(Model.SubtotalAmount)"
                                                       data-raw="@FormatAngka(Model.SubtotalAmount)"
                                                       readonly />
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>Diskon Nota (Rp)</td>
                                             <td>
                                                <input type="text"
                                                       class="form-control form-control-sm text-end currency-input"
                                                       id="DiscountAmount"
                                                       name="DiscountAmount"
                                                       value="@FormatRupiah(Model.DiscountAmount)"
                                                       data-raw="@FormatAngka(Model.DiscountAmount)"
                                                       inputmode="decimal" />
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>Pajak (%)</td>
                                            <td>
                                                <input type="number"
                                                       class="form-control form-control-sm text-end"
                                                       id="TaxPercent"
                                                       name="TaxPercent"
                                                       min="0"
                                                       max="100"
                                                       step="0.01"
                                                       value="@FormatAngka(Model.TaxPercent)" />
                                            </td>
                                        </tr>

                                        <tr>
                                            <td><strong>Total</strong></td>
                                            <td>
                                                <input type="text"
                                                       class="form-control form-control-sm text-end currency-input"
                                                       id="TotalAmount"
                                                       name="TotalAmount"
                                                       value="@FormatRupiah(Model.TotalAmount)"
                                                       data-raw="@FormatAngka(Model.TotalAmount)"
                                                       readonly />
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <input type="hidden" id="Status" name="Status" value="draft" />

                    <div class="po-form-actions">
                        <button type="submit" class="btn po-btn-save">
                            <i class="bi bi-save"></i> Simpan Draft
                        </button>

                        <a asp-controller="GoodsPurchaseOrders"
                           asp-action="Index"
                           class="btn po-btn-cancel">
                            Batal
                        </a>
                    </div>
                </div>
            </div>
        </form> 
 </div>
 
@section Scripts {
    <script>
        const products = @Html.Raw(productsJson);
        const units = @Html.Raw(unitsJson);

        const tbody = document.getElementById('detailBody');
        const btnTambahBaris = document.getElementById('btnTambahBaris');
        const poForm = document.querySelector('form');

        const rupiahFormatter = new Intl.NumberFormat('id-ID', {
            minimumFractionDigits: 0,
            maximumFractionDigits: 2
        });
         
        function escapeHtml(value) {
            return String(value ?? '').replace(/[&<>"']/g, char => ({
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#39;'
            })[char]);
        }

        function parseNominal(value) {
            if (value === null || value === undefined || value === '') {
                return 0;
            }

            let text = String(value).trim().replace(/\s/g, '');

            if (!text) return 0;
             
            if (text.includes(',')) {
                text = text.replace(/\./g, '').replace(',', '.');
                const parsed = Number(text);
                return Number.isFinite(parsed) ? parsed : 0;
            }
             
            if (/^-?\d{1,3}(?:\.\d{3})+$/.test(text)) {
                text = text.replace(/\./g, '');
            }

            const parsed = Number(text);
            return Number.isFinite(parsed) ? parsed : 0;
        }

        function parseRaw(value) {
            const parsed = Number(value);
            return Number.isFinite(parsed) ? parsed : 0;
        }

        function formatRupiah(value) {
            return rupiahFormatter.format(Number(value) || 0);
        }

        function setCurrencyValue(input, value) {
            if (!input) return;

            const nominal = Number(value) || 0;
            input.dataset.raw = String(nominal);
            input.value = formatRupiah(nominal);
        }
         
        function buildProductOptionsHtml(selectedProductId = '') {
            const groupedProducts = {};

            products.forEach(product => {
                const category = product.categoryName?.trim() || 'Tanpa Kategori';

                if (!groupedProducts[category]) {
                    groupedProducts[category] = [];
                }

                groupedProducts[category].push(product);
            });

            const categories = Object.keys(groupedProducts).sort((a, b) => {
                if (a === 'Tanpa Kategori') return -1;
                if (b === 'Tanpa Kategori') return 1;

                return a.localeCompare(b, 'id');
            });

            return `
                <option value="">-- Pilih Produk --</option>
                ${categories.map(category => `
                    <optgroup label="${escapeHtml(category)}">
                        ${groupedProducts[category]
                            .sort((a, b) =>
                                String(a.name ?? '').localeCompare(
                                    String(b.name ?? ''),
                                    'id'
                                )
                            )
                            .map(product => `
                                <option
                                    value="${escapeHtml(product.id)}"
                                    ${String(product.id) === String(selectedProductId)
                                        ? 'selected'
                                        : ''}>
                                    ${escapeHtml(product.sku || '-')} -
                                    ${escapeHtml(product.name || '-')}
                                </option>
                            `).join('')}
                    </optgroup>
                `).join('')}
            `;
        }

        function buildUnitOptionsHtml(selectedUnitId = '') {
            const sortedUnits = [...units].sort((a, b) =>
                String(a.code ?? '').localeCompare(
                    String(b.code ?? ''),
                    'id'
                )
            );

            return `
                <option value="">-- Pilih Unit --</option>
                ${sortedUnits.map(unit => `
                    <option
                        value="${escapeHtml(unit.id)}"
                        ${String(unit.id) === String(selectedUnitId)
                            ? 'selected'
                            : ''}>
                        ${escapeHtml(unit.code || '-')}
                    </option>
                `).join('')}
            `;
        }

        function isiDataProduk(row, product) {
            const unitSelect = row.querySelector('.unit-select');
            const priceInput = row.querySelector('.price');

            if (!product) {
                if (unitSelect) {
                    unitSelect.value = '';
                }

                if (priceInput) {
                    setCurrencyValue(priceInput, 0);
                }

                hitungTotal();
                return;
            }

            if (unitSelect) {
                const unitExists = units.some(
                    unit => String(unit.id) === String(product.unitId)
                );

                unitSelect.value = unitExists
                    ? String(product.unitId)
                    : '';
            }

            if (priceInput) {
                setCurrencyValue(priceInput, product.costPrice ?? 0);
            }

            hitungTotal();
        }
         

        function tambahBaris() {
            const row = document.createElement('tr');

            row.innerHTML = `
                <td class="row-number text-end"></td>

                <td>
                    <select
                        class="form-select form-select-sm product-select"
                        name="Details[0].ProductId"
                        required>
                        ${buildProductOptionsHtml()}
                    </select>
                </td>

                <td>
                    <input
                        type="number"
                        class="form-control form-control-sm qty"
                        name="Details[0].Qty"
                        min="0.01"
                        step="0.01"
                        value="1"
                        required />
                </td>

                <td>
                    <select
                        class="form-select form-select-sm unit-select"
                        name="Details[0].UnitId"
                        required>
                        ${buildUnitOptionsHtml()}
                    </select>
                </td>

                <td>
                    <input
                        type="text"
                        class="form-control form-control-sm price currency-input"
                        name="Details[0].UnitPrice"
                        value="0"
                        data-raw="0"
                        inputmode="decimal"
                        required />
                </td>

                <td>
                    <input
                        type="number"
                        class="form-control form-control-sm discount"
                        name="Details[0].DiscPercent"
                        min="0"
                        max="100"
                        step="0.01"
                        value="0" />
                </td>

                <td>
                    <input
                        type="number"
                        class="form-control form-control-sm tax"
                        name="Details[0].TaxPercent"
                        min="0"
                        max="100"
                        step="0.01"
                        value="0" />
                </td>

                <td>
                    <input
                        type="text"
                        class="form-control form-control-sm subtotal currency-input"
                        name="Details[0].Subtotal"
                        value="0"
                        data-raw="0"
                        readonly />
                </td>

                <td>
                    <button
                        type="button"
                        class="btn btn-sm btn-danger btn-hapus"
                        title="Hapus baris">
                        ×
                    </button>
                </td>
            `;

            tbody.appendChild(row);
            perbaruiNomor();
            hitungTotal();
        }
         
        function perbaruiNomor() {
            tbody.querySelectorAll('tr').forEach((row, index) => {
                const numberCell = row.querySelector('.row-number');

                if (numberCell) {
                    numberCell.textContent = index + 1;
                }

                row.querySelectorAll('[name]').forEach(input => {
                    input.name = input.name.replace(
                        /Details\[\d+\]/,
                        `Details[${index}]`
                    );
                });
            });
        }
         
        function hitungBaris(row) {
            const qty = Math.max(
                0,
                parseNominal(row.querySelector('.qty')?.value)
            );

            const priceInput = row.querySelector('.price');

            const price = Math.max(
                0,
                priceInput
                    ? (
                        priceInput.dataset.raw !== undefined &&
                        document.activeElement !== priceInput
                            ? parseRaw(priceInput.dataset.raw)
                            : parseNominal(priceInput.value)
                    )
                    : 0
            );

            const discount = Math.min(
                100,
                Math.max(
                    0,
                    parseNominal(row.querySelector('.discount')?.value)
                )
            );

            const tax = Math.min(
                100,
                Math.max(
                    0,
                    parseNominal(row.querySelector('.tax')?.value)
                )
            );

            const bruto = qty * price;
            const setelahDiskon = bruto * (1 - discount / 100);
            const nilaiPajak = setelahDiskon * tax / 100;
            const subtotal = setelahDiskon + nilaiPajak;

            setCurrencyValue(
                row.querySelector('.subtotal'),
                subtotal
            );
        } 

        function hitungTotal() {
            let subtotalNota = 0;

            tbody.querySelectorAll('tr').forEach(row => {
                hitungBaris(row);

                const subtotalInput = row.querySelector('.subtotal');

                if (subtotalInput) {
                    subtotalNota += parseRaw(subtotalInput.dataset.raw);
                }
            });

            const discountInput = document.getElementById('DiscountAmount');
            const taxInput = document.getElementById('TaxPercent');

            const diskonNota = Math.max(
                0,
                discountInput
                    ? (
                        document.activeElement === discountInput
                            ? parseNominal(discountInput.value)
                            : parseRaw(
                                discountInput.dataset.raw ??
                                discountInput.value
                            )
                    )
                    : 0
            );

            const pajakNota = Math.min(
                100,
                Math.max(0, parseNominal(taxInput?.value))
            );

            const dasarPajak = Math.max(
                0,
                subtotalNota - diskonNota
            );

            const totalNota = dasarPajak * (1 + pajakNota / 100);

            setCurrencyValue(
                document.getElementById('SubtotalAmount'),
                subtotalNota
            );

            setCurrencyValue(
                document.getElementById('TotalAmount'),
                totalNota
            );
        }
         
        btnTambahBaris.addEventListener('click', tambahBaris);

        tbody.addEventListener('change', event => {
            if (!event.target.matches('.product-select')) return;

            const row = event.target.closest('tr');

            const product = products.find(
                product => String(product.id) === String(event.target.value)
            );

            isiDataProduk(row, product);
        });

        tbody.addEventListener('input', event => {
            if (event.target.matches('.price')) {
                event.target.dataset.raw = String(
                    parseNominal(event.target.value)
                );
            }

            if (
                event.target.matches(
                    '.qty, .price, .discount, .tax'
                )
            ) {
                hitungTotal();
            }
        });

        tbody.addEventListener('focusout', event => {
            if (!event.target.matches('.price')) return;

            const input = event.target;
            const nominal = parseNominal(input.value);

            input.dataset.raw = String(nominal);
            input.value = formatRupiah(nominal);

            hitungTotal();
        });

        tbody.addEventListener('click', event => {
            const button = event.target.closest('.btn-hapus');

            if (!button) return;

            button.closest('tr').remove();

            perbaruiNomor();
            hitungTotal();
        });
         
        const discountAmountInput =
            document.getElementById('DiscountAmount');

        if (discountAmountInput) {
            discountAmountInput.addEventListener('input', () => {
                discountAmountInput.dataset.raw = String(
                    parseNominal(discountAmountInput.value)
                );

                hitungTotal();
            });

            discountAmountInput.addEventListener('focusout', () => {
                const nominal = parseNominal(
                    discountAmountInput.value
                );

                discountAmountInput.dataset.raw = String(nominal);
                discountAmountInput.value = formatRupiah(nominal);

                hitungTotal();
            });
        }

        const taxPercentInput = document.getElementById('TaxPercent');

        if (taxPercentInput) {
            taxPercentInput.addEventListener('input', hitungTotal);
        }
         
        const poDateInput = document.getElementById('PODate');
        const poNumberInput = document.getElementById('PONo');

        async function perbaruiNomorPO() {
            if (!poDateInput?.value || !poNumberInput) return;

            try {
                const url =
                    '@Url.Action("NextPONumber", "GoodsPurchaseOrders")' +
                    '?poDate=' + encodeURIComponent(poDateInput.value);

                const response = await fetch(url);

                if (!response.ok) {
                    throw new Error('Gagal mengambil nomor PO.');
                }

                const result = await response.json();

                if (result.poNo) {
                    poNumberInput.value = result.poNo;
                }
            } catch (error) {
                console.error(
                    'Gagal memperbarui nomor PO:',
                    error
                );
            }
        }

        if (poDateInput) {
            poDateInput.addEventListener('change', perbaruiNomorPO);
        }
         
        poForm.addEventListener('submit', event => { 
            perbaruiNomor();
             
            poForm.querySelectorAll(
                '.price, .subtotal, #DiscountAmount, #SubtotalAmount, #TotalAmount'
            ).forEach(input => {
                const raw = input.dataset.raw;

                const nominal = raw !== undefined
                    ? parseRaw(raw)
                    : parseNominal(input.value);

                input.value = nominal.toLocaleString('en-US', {
                    useGrouping: false,
                    minimumFractionDigits: 0,
                    maximumFractionDigits: 2
                });
            });
        });
         
        tbody.querySelectorAll('.price, .subtotal').forEach(input => {
            if (
                input.dataset.raw === undefined ||
                input.dataset.raw === ''
            ) {
                input.dataset.raw = String(
                    parseNominal(input.value)
                );
            }
        });

        [
            'DiscountAmount',
            'SubtotalAmount',
            'TotalAmount'
        ].forEach(id => {
            const input = document.getElementById(id);

            if (
                input &&
                (
                    input.dataset.raw === undefined ||
                    input.dataset.raw === ''
                )
            ) {
                input.dataset.raw = String(
                    parseNominal(input.value)
                );
            }
        });

        perbaruiNomor();
        hitungTotal();
    </script>
}