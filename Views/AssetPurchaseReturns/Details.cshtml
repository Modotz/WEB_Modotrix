@model ERP.Web.Models.AssetPurchaseReturnViewModel
@{
    var r = Model;
    ViewData["Title"] = $"{T["Retur Aset"]} {r.ReturnNo}";
    var today = DateTime.Today.ToString("yyyy-MM-dd");
}
<div class="px-2">
    <div class="mb-3 d-flex flex-wrap align-items-center gap-2">
        <h3 class="fw-semibold text-white mb-0 me-2">@T["Retur Aset"] @r.ReturnNo</h3>
        <span class="badge @AssetPurchaseLabels.Css(r.Status) me-auto">@T[AssetPurchaseLabels.Label(AssetPurchaseLabels.ReturnStatuses, r.Status)]</span>
        @if (r.Status == "posted")
        {
            <button type="button" class="btn btn-outline-warning btn-sm" data-perm="update" data-bs-toggle="modal" data-bs-target="#cancelModal">
                <i class="bi bi-arrow-counterclockwise me-1"></i>@T["Batalkan Retur"]
            </button>
        }
        <a asp-action="Index" class="btn btn-secondary btn-sm" title="@T["Kembali"]"><i class="bi bi-arrow-left"></i></a>
    </div>

    <div class="card custom-card mb-3">
        <div class="card-body px-4 py-3">
            <div class="row g-3 text-white small">
                <div class="col-md-2"><div class="text-white-50">@T["Tanggal retur"]</div>@Acc.Date(r.ReturnDate)</div>
                <div class="col-md-3"><div class="text-white-50">@T["Supplier"]</div>@(r.SupplierName ?? "-")</div>
                <div class="col-md-2">
                    <div class="text-white-50">@T["PO Aset"]</div>
                    @if (r.Order != null)
                    {
                        <a asp-controller="AssetPurchaseOrders" asp-action="Details" asp-route-uid="@r.Order.Uid" class="text-info">@r.Order.No</a>
                    }
                    else
                    {
                        <span>-</span>
                    }
                </div>
                <div class="col-md-2"><div class="text-white-50">@T["Nilai (Dr GR/IR)"]</div><span class="fw-semibold">@Acc.Money(r.TotalAmount)</span></div>
                <div class="col-md-3"><div class="text-white-50">@T["Dibuat oleh"]</div>@(r.CreatedByName ?? "-")</div>
                <div class="col-md-6"><div class="text-white-50">@T["Alasan"]</div>@(r.Reason ?? "-")</div>
                <div class="col-md-6"><div class="text-white-50">@T["Catatan"]</div>@(r.Note ?? "-")</div>
                @if (r.Status == "cancelled")
                {
                    <div class="col-md-12 text-danger">@T["Dibatalkan {0}: {1}", Acc.Date(r.CancelDate), r.CancelReason ?? ""]</div>
                }
            </div>
        </div>
    </div>

    <div class="card custom-card mb-3">
        <div class="card-header custom-card-header py-3 px-4"><span class="fw-semibold text-white">@T["Aset diretur"]</span></div>
        <div class="table-responsive">
            <table class="table custom-table align-middle mb-0">
                <thead>
                    <tr>
                        <th class="fw-bold">@T["NO. ASET"]</th>
                        <th class="fw-bold">@T["NAMA"]</th>
                        <th class="fw-bold">@T["PENERIMAAN"]</th>
                        <th class="fw-bold text-end">@T["HARGA PEROLEHAN"]</th>
                        <th class="fw-bold text-end">@T["AKUMULASI"]</th>
                        <th class="fw-bold">@T["JURNAL"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in r.Items)
                    {
                        <tr>
                            <td>
                                @if (i.AssetUid != null)
                                {
                                    <a asp-controller="Assets" asp-action="Details" asp-route-uid="@i.AssetUid" class="text-info text-decoration-none">@i.AssetNo</a>
                                }
                                else
                                {
                                    @i.AssetNo
                                }
                            </td>
                            <td class="text-white">@i.AssetName</td>
                            <td class="text-white small">@(i.ReceiptNo ?? "-")</td>
                            <td class="text-end text-white">@Acc.Money(i.Value)</td>
                            <td class="text-end text-white">@Acc.Money(i.Accumulated)</td>
                            <td>
                                @if (i.JournalUid != null)
                                {
                                    <a asp-controller="Journals" asp-action="Details" asp-route-uid="@i.JournalUid" class="text-info">@i.JournalNo</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (r.Status == "posted")
{
    <div class="modal fade" id="cancelModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form method="post" asp-action="Cancel" asp-route-uid="@r.Uid" class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@T["Batalkan Retur"] @r.ReturnNo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T["Tutup"]"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-white-50">@T["Jurnal pelepasan tiap aset dibalik dan aset aktif kembali (jadwal dibuat ulang). Ditolak bila penerimaannya sudah difakturkan."]</p>
                    <div class="mb-2">
                        <label class="form-label small mb-1" for="cancelDate">@T["Tanggal pembatalan"]</label>
                        <input type="date" class="form-control form-control-sm" name="date" id="cancelDate" value="@today" />
                    </div>
                    <div>
                        <label class="form-label small mb-1" for="cancelReasonInput">@T["Alasan"]</label>
                        <input type="text" class="form-control form-control-sm" name="reason" id="cancelReasonInput" maxlength="255" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">@T["Tutup"]</button>
                    <button type="submit" class="btn btn-warning btn-sm">@T["Batalkan Retur"]</button>
                </div>
            </form>
        </div>
    </div>
}
