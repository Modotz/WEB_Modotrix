
@using ERP.Web.Models
@model PagedResult<ProductViewModel>

@{
    ViewData["Title"] = "Varian";

    var no = ((Model.Page - 1) * Model.PageSize);
    var variants = Model?.Data ?? Enumerable.Empty<ProductViewModel>();
    var parentProduct = ViewBag.ParentProduct as ProductViewModel;
}

<div class="page-heading supplier-page">
    <!-- JUDUL -->
    <div class="mb-2">

        <h4 class="page-title">
            Varian — @(parentProduct?.Name ?? "Produk")
        </h4>

        <div class="d-flex gap-1">

            <a asp-action="Index"
               asp-controller="Products"
               class="btn btn-sm btn-outline-secondary">

                <i class="bi bi-arrow-left"></i>
                Kembali ke Produk

            </a>

            <a asp-action="Edit"
               asp-controller="Products"
               asp-route-id="@parentProduct?.Id"
               class="btn btn-sm btn-outline-warning">

                <i class="bi bi-pencil"></i>
                Edit Induk

            </a>

        </div>
    </div>

    <!-- INFORMASI PRODUK INDUK -->
    <div class="card variant-card mb-2"> 
        <div class="card-body"> 
            <div class="variant-parent-label">
                Produk Induk
            </div>

            <div class="d-flex align-items-center flex-wrap gap-2"> 
                <h5 class="variant-parent-name mb-0">
                    @parentProduct?.Name
                </h5>

                <span class="badge variant-parent-sku">
                    @parentProduct?.Sku
                </span>

                @if (parentProduct?.HasVariants == true)
                {
                    <span class="badge bg-info text-dark">
                        Punya Varian
                    </span>
                }

            </div>

            <div class="variant-parent-description">
                Induk dijadikan template (tidak distok).
                Stok & harga ada di tiap varian.
            </div>

        </div>
    </div>

    <!-- FILTER -->
    <div class="card supplier-card supplier-filter"> 
        <div class="card-header bg-transparent d-flex justify-content-between align-items-center"> 
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-funnel"></i>
                <span class="fw-semibold">Filter</span>
            </div>

            <button class="btn btn-sm text-muted p-0"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#filterCollapse"
                    aria-expanded="true"
                    aria-controls="filterCollapse"> 
                <i class="bi bi-chevron-down"></i> 
            </button> 
        </div>

        <div class="collapse show" id="filterCollapse"> 
            <div class="card-body"> 
                <form method="get"
                      asp-action="Index"
                      class="row g-2 align-items-end">

                    <div class="col-md-3">
                        <label for="search" class="form-label">
                            Cari
                        </label>

                        <input type="text"
                               class="form-control"
                               id="search"
                               name="search"
                               value="@Context.Request.Query["search"]" />
                    </div>

                    <div class="col-md-2">
                        <label for="isActive" class="form-label">
                            Is Active
                        </label>

                        <select class="form-select"
                                id="isActive"
                                name="isActive">

                            <option value=""
                                    selected="@(Context.Request.Query["isActive"] == "")">
                                -- Semua --
                            </option>

                            <option value="true"
                                    selected="@(Context.Request.Query["isActive"] == "true")">
                                Aktif
                            </option>

                            <option value="false"
                                    selected="@(Context.Request.Query["isActive"] == "false")">
                                Non-Aktif
                            </option>

                        </select>
                    </div>

                    <div class="col-md-2">
                        <label for="isActive" class="form-label">
                            Track Stock
                        </label>

                        <select class="form-select"
                                id="trackStock"
                                name="trackStock">

                            <option value=""
                                    selected="@(Context.Request.Query["trackStock"] == "")">
                                -- Semua --
                            </option>

                            <option value="true"
                                    selected="@(Context.Request.Query["trackStock"] == "true")">
                                Ya
                            </option>

                            <option value="false"
                                    selected="@(Context.Request.Query["trackStock"] == "false")">
                                Tidak
                            </option>

                        </select>
                    </div>

                    <div class="col-md-2">
                        <label for="pageSize" class="form-label">
                            Per Halaman
                        </label>

                        <select class="form-select"
                                id="pageSize"
                                name="pageSize">

                            <option value="10" selected="@(Model.PageSize == 10)">10</option>
                            <option value="25" selected="@(Model.PageSize == 25)">25</option>
                            <option value="50" selected="@(Model.PageSize == 50)">50</option>
                            <option value="100" selected="@(Model.PageSize == 100)">100</option>

                        </select>
                    </div>

                    <div class="col-md-3 d-flex gap-2"> 
                        <button type="submit" class="btn btn-primary d-flex align-items-center gap-2"> 
                            <i class="bi bi-search"></i>
                            Terapkan 
                        </button>

                        <a asp-action="Index"
                           asp-controller="ProductVariants"
                           asp-route-id="@parentProduct?.Id"
                           class="btn filter-reset-btn">
                            <i class="bi bi-arrow-counterclockwise"></i>
                            Reset
                        </a>
                    </div> 
                </form> 
            </div> 
        </div> 
    </div>


 <div class="product-table-card">
    <div class="product-table-header">
        <div class="product-table-heading">

            <span class="product-table-title">Varian Terdaftar (@Model.TotalCount)</span> 
        </div>

            <a asp-action="Create"
               asp-controller="ProductVariants"
               asp-route-id="@parentProduct?.Id"
               class="btn btn-teal btn-custom-action">

                <i class="bi bi-plus-lg"></i>
                Tambah Varian

            </a>
    </div>

    @* tabel *@ 
    <div id="productTableBody" class="collapse show">
        <div class="product-table-wrapper">
            <table class="table product-table">
                <thead>
                    <tr>
                        <th class="text-center" >#</th>
                        <th class="text-center" >IMAGE</th>
                        <th class="text-center" >NO. PRODUK</th>
                        <th class="text-center" >SKU</th>
                        <th class="text-center" >NAME</th> 
                        <th class="text-center" >BRAND</th>
                        <th class="text-center" >CATEGORY</th> 
                        <th class="text-center">JENIS</th>
                        <th class="text-center" >UNIT</th>
                        <th class="text-center">COST PRICE</th>
                        <th class="text-center"> SELL PRICE </th>
                        <th class="text-center"> MIN STOCK </th>
                        <th class="text-center"> TRACK STOCK </th>
                        <th class="text-center"> IS ACTIVE </th>
                        <th class="text-center"> AKSI </th>
                    </tr>
                </thead>

                <tbody>
                     @if (variants.Any())
                    {
                        foreach (var item in variants)
                        {
                            no++; 
                            <tr>
                                 
                                <td class="text-center">
                                    @no
                                </td>
                                 
                                <td class="text-center">
                                   @if (!string.IsNullOrWhiteSpace(item.Image))
                                    {
                                        <img src="@item.Image" alt="@item.Name" class="product-image" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-box-seam product-image-placeholder"></i>
                                    } 
                                </td>

                                 
                                <td class="product-number">
                                    <span >
                                        @item.ProductNumber
                                    </span>
                                </td>

                                 
                                <td class="product-sku-cell"> 
                                     @item.Sku 
                                </td>
                                 
                                <td> 
                                     @item.Name 
                                </td>
                                   
                                <td> 
                                   @(item.BrandName ?? "-")
                                </td>

                                 
                                <td> 
                                    @(item.CategoryName ?? "-")
                                </td>
                                 
                                <td> 
                                    @item.ProductType
                                </td>

 
                                <td> 
                                    <span class="product-badge product-badge-unit flex-start fw-bold">
                                        @item.UnitName
                                    </span> 
                                </td>

                                 
                                <td class="product-price">

                                    @item.CostPrice?.ToString(
                                        "#,##0", new System.Globalization.CultureInfo("id-ID")
                                    ) 
                                </td>
                                 
                                <td class="product-price"> 
                                    @item.SellPrice?.ToString(
                                        "#,##0", new System.Globalization.CultureInfo("id-ID")
                                    ) 
                                </td>
                                 
                                <td class="product-stock"> 
                                    @item.MinStock?.ToString("#,##0.###") 
                                </td>

                                <td class="text-center"> 
                                    @if (item.TrackStock)
                                    {
                                    <span class="badge bg-success">
                                        Ya
                                    </span>
                                    }
                                    else
                                    {
                                    <span class="badge bg-secondary">
                                        Tidak
                                    </span>
                                    }

                                </td>

                                <td> 
                                    @if (item.IsActive)
                                    {
                                        <span class="product-badge product-badge-stock">
                                            Aktif
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="product-badge product-badge-no-stock">
                                            Nonaktif
                                        </span>
                                    } 
                                </td>
                                 
                                <td> 
                                    <div class="product-actions"> 
                                        <a asp-action="Variant"
                                           asp-controller="ProductUnits"
                                           asp-route-id="@item.Id"
                                           class="product-action-btn product-action-variant"
                                           title="Satuan & Konversi">

                                            <i class="bi bi-rulers"></i>

                                        </a>

                                        <a asp-action="Copy"
                                           asp-controller="ProductVariants"
                                           asp-route-id="@item.Id"
                                           class="product-action-btn product-action-copy"
                                           title="Salin Produk Varian">

                                            <i class="bi bi-files"></i>

                                        </a>
                                         
                                        <a asp-action="Edit"
                                           asp-controller="ProductVariants"
                                           asp-route-id="@item.Id"
                                           class="product-action-btn product-action-edit"
                                           title="Edit">

                                            <i class="bi bi-pencil-square"></i>

                                        </a>
                                         
                                        <form method="post"
                                              asp-action="Delete"
                                              asp-controller="ProductVariants"
                                              class="d-inline"
                                              onsubmit="return confirm('Yakin ingin menghapus varian ini?');">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@item.Id" />

                                            <input type="hidden"
                                                   name="parentId"
                                                   value="@parentProduct?.Id" />

                                            <button type="submit"
                                                    class="product-action-btn product-action-delete"
                                                    title="Hapus">

                                                <i class="bi bi-trash"></i>

                                            </button>

                                        </form>
                                    </div> 
                                </td> 
                            </tr>
                        }
                    }
                    else
                    {
                        <tr> 
                            <td colspan="17"
                                class="product-empty"> 
                                <i class="bi bi-box-seam"></i> 
                                Tidak ada data varian produk. 
                            </td> 
                        </tr>
                    }
                </tbody>
                
            </table>
        </div>
    </div>

    @* <!-- Footer / Pagination !--> *@
     <div class="card-footer bg-transparent border-top-0 d-flex justify-content-between align-items-center py-3">
         @{
             var startItem = Model.TotalCount == 0 ? 0 : ((Model.Page - 1) * Model.PageSize) + 1;
             var endItem = Math.Min(Model.Page * Model.PageSize, Model.TotalCount);
          }
          <span class="menu-description small"> Menampilkan <strong>@startItem – @endItem</strong> dari <strong>@Model.TotalCount</strong> data </span>
          @{
             var currentPage = Model.Page;
             var totalPages = Model.TotalPage;
           }
              <nav aria-label="Pagination">
                 <ul class="pagination">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                       <a class="page-link" href="@Url.Action("Index", new
                            {
                                page = currentPage - 1,
                                pageSize = Model.PageSize,
                                search = Context.Request.Query["search"].ToString(),
                                brandId = Context.Request.Query["brandId"].ToString(),
                                categoryId = Context.Request.Query["categoryId"].ToString(),
                                subCategoryId = Context.Request.Query["subCategoryId"].ToString(),
                                productType = Context.Request.Query["productType"].ToString(),
                                unitId = Context.Request.Query["unitId"].ToString(),
                                trackStock = Context.Request.Query["trackStock"].ToString(),
                                isActive = Context.Request.Query["isActive"].ToString(),
                                showVariant = Context.Request.Query["showVariant"].ToString()
                            })">
                             Sebelumnya
                       </a>
                    </li>

                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">

                            <a class="page-link"
                               href="@Url.Action("Index", new
                               {
                                   page = i,
                                   pageSize = Model.PageSize,
                                   search = Context.Request.Query["search"].ToString(),
                                   brandId = Context.Request.Query["brandId"].ToString(),
                                   categoryId = Context.Request.Query["categoryId"].ToString(),
                                   subCategoryId = Context.Request.Query["subCategoryId"].ToString(),
                                   productType = Context.Request.Query["productType"].ToString(),
                                   unitId = Context.Request.Query["unitId"].ToString(),
                                   trackStock = Context.Request.Query["trackStock"].ToString(),
                                   isActive = Context.Request.Query["isActive"].ToString(),
                                   showVariant = Context.Request.Query["showVariant"].ToString()
                               })">

                                @i

                            </a>

                        </li>
                    }
                       <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">

                            <a class="page-link"
                               href="@Url.Action("Index", new
                               {
                                   page = currentPage + 1,
                                   pageSize = Model.PageSize,
                                   search = Context.Request.Query["search"].ToString(),
                                   brandId = Context.Request.Query["brandId"].ToString(),
                                   categoryId = Context.Request.Query["categoryId"].ToString(),
                                   subCategoryId = Context.Request.Query["subCategoryId"].ToString(),
                                   productType = Context.Request.Query["productType"].ToString(),
                                   unitId = Context.Request.Query["unitId"].ToString(),
                                   trackStock = Context.Request.Query["trackStock"].ToString(),
                                   isActive = Context.Request.Query["isActive"].ToString(),
                                   showVariant = Context.Request.Query["showVariant"].ToString()
                               })">

                                Berikutnya

                            </a>

                        </li>
                   </ul>
              </nav>
        </div>
     </div>
</div>