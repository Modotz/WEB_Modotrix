<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ERPLITE - Sign in to your account</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
            :root {
                --bg-page: #383d46;
                --bg-card: #0c1322;
                --border-color: #1e293b;
                --input-bg: #070c17;
                --input-border: #1e2d42;
                --text-muted: #94a3b8;
                --accent-teal: #1ad1a5;
                --accent-teal-hover: #15b892;
                --badge-bg: #fbbf24;
                --badge-text: #000000;
            }

            body {
                font-family: 'Inter', sans-serif;
                background-color: var(--bg-page);
                color: #ffffff;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0;
                padding: 20px;
            }

            .login-card {
                background-color: var(--bg-card);
                border-radius: 12px;
                padding: 2.5rem 2.25rem;
                width: 100%;
                max-width: 440px;
                box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.4), 0 8px 10px -6px rgba(0, 0, 0, 0.3);
                border: 1px solid rgba(255, 255, 255, 0.05);
            }

            .brand-logo {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
                margin-bottom: 4px;
            }

            .logo-icon {
                width: 32px;
                height: 32px;
            }

            .brand-title {
                font-weight: 800;
                font-size: 1.5rem;
                letter-spacing: 0.5px;
                color: #1e6091; /* Distinct primary dark blue accent */
                background: linear-gradient(135deg, #2563eb, #38bdf8);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
            }

            .brand-subtitle {
                font-size: 0.65rem;
                color: #64748b;
                letter-spacing: 0.5px;
                text-transform: uppercase;
                font-weight: 500;
                margin-top: -4px;
                margin-bottom: 1.5rem;
            }

            .card-title-main {
                font-weight: 700;
                font-size: 1.35rem;
                margin-bottom: 1.75rem;
                color: #ffffff;
            }

            .form-label {
                font-size: 0.875rem;
                font-weight: 500;
                color: #ffffff;
                margin-bottom: 0.5rem;
            }

            .badge-testing {
                background-color: var(--badge-bg);
                color: var(--badge-text);
                font-size: 0.65rem;
                font-weight: 700;
                padding: 2px 6px;
                border-radius: 4px;
                vertical-align: middle;
                letter-spacing: 0.5px;
            }

            .form-select, .form-control {
                background-color: var(--input-bg);
                border: 1px solid var(--input-border);
                color: #cbd5e1;
                border-radius: 6px;
                padding: 0.65rem 0.85rem;
                font-size: 0.9rem;
                transition: all 0.2s ease-in-out;
            }

            .form-select {
                background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%3a94a3b8' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='m2 5 6 6 6-6'/%3e%3c/svg%3e");
            }

                .form-select:focus, .form-control:focus {
                    background-color: var(--input-bg);
                    border-color: var(--accent-teal);
                    color: #ffffff;
                    box-shadow: 0 0 0 2px rgba(26, 209, 165, 0.2);
                }

            .input-group .form-control {
                border-right: none;
            }

            .input-group .btn-outline-secondary {
                background-color: var(--input-bg);
                border: 1px solid var(--input-border);
                border-left: none;
                color: var(--text-muted);
                border-top-right-radius: 6px;
                border-bottom-right-radius: 6px;
            }

                .input-group .btn-outline-secondary:hover {
                    background-color: var(--input-bg);
                    color: #ffffff;
                    border-color: var(--input-border);
                }

            .forgot-link {
                font-size: 0.8rem;
                color: var(--accent-teal);
                text-decoration: none;
                font-weight: 500;
            }

                .forgot-link:hover {
                    color: var(--accent-teal-hover);
                    text-decoration: underline;
                }

            .form-check-input {
                background-color: transparent;
                border-color: #334155;
                width: 1.1em;
                height: 1.1em;
                margin-top: 0.15em;
                cursor: pointer;
            }

                .form-check-input:checked {
                    background-color: var(--accent-teal);
                    border-color: var(--accent-teal);
                }

            .form-check-label {
                color: #cbd5e1;
                font-size: 0.875rem;
                cursor: pointer;
            }

            .btn-submit {
                background-color: var(--accent-teal);
                border: none;
                color: #0c1322;
                font-weight: 700;
                padding: 0.7rem;
                border-radius: 6px;
                font-size: 1rem;
                width: 100%;
                transition: all 0.2s ease-in-out;
                margin-top: 0.5rem;
            }

                .btn-submit:hover {
                    background-color: var(--accent-teal-hover);
                    color: #0c1322;
                }

            .auth-footer {
                text-align: center;
                font-size: 0.825rem;
                color: #94a3b8;
                margin-top: 1.5rem;
            }

                .auth-footer a {
                    color: var(--accent-teal);
                    text-decoration: none;
                    font-weight: 500;
                }

                    .auth-footer a:hover {
                        text-decoration: underline;
                    }

            /* Custom options background styling for webkit */
            option {
                background-color: var(--input-bg);
                color: #ffffff;
            }
    </style>
</head>
<body>

    <div class="login-card">
        <!-- Logo section -->
        <div class="text-center">
            <div class="brand-logo">
                <svg class="logo-icon" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M20 5L32 12V28L20 35L8 28V12L20 5Z" stroke="#38bdf8" stroke-width="3" stroke-linejoin="round" />
                    <path d="M20 12L28 16.5V25.5L20 30L12 25.5V16.5L20 12Z" fill="#2563eb" />
                </svg>
                <span class="brand-title">ERPLITE</span>
            </div>
            <div class="brand-subtitle">Enterprise Resources Planning</div>
            <h1 class="card-title-main">Sign in to your account</h1>
        </div>

        <!-- Form section -->
        <form id="loginForm" onsubmit="handleLogin(event)">
            <!-- User selection dropdown -->
            <div class="mb-3">
                <label for="userSelect" class="form-label d-flex align-items-center gap-2">
                    Login sebagai <span class="badge-testing">TESTING</span>
                </label>
                <select class="form-select" id="userSelect" required>
                    <option value="" selected disabled>-- Pilih user --</option>
                    <option value="admin">Administrator (Admin)</option>
                    <option value="manager">Project Manager</option>
                    <option value="staff">Operational Staff</option>
                </select>
            </div>

            <!-- Password field -->
            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label for="passwordInput" class="form-label mb-0">Password</label>
                    <a href="#" class="forgot-link" onclick="handleForgotPassword(event)">Forgot Password?</a>
                </div>
                <div class="input-group">
                    <input type="password" class="form-control" id="passwordInput" placeholder="••••••••" required>
                    <button class="btn btn-outline-secondary" type="button" id="togglePassword">
                        <i class="bi bi-eye" id="toggleIcon"></i>
                    </button>
                </div>
            </div>

            <!-- Remember me checkbox -->
            <div class="mb-4 form-check">
                <input type="checkbox" class="form-check-input" id="rememberMe">
                <label class="form-check-label" for="rememberMe">Remember me</label>
            </div>

            <!-- Submit button -->
            <button type="submit" class="btn btn-submit">Sign in</button>
        </form>

        <!-- Card Footer -->
        <div class="auth-footer">
            Don't have an account? <a href="#" onclick="handleSignUp(event)">Sign up</a>
        </div>
    </div>

    <script>
            // Password toggle visibility functionality
            const togglePasswordBtn = document.getElementById('togglePassword');
            const passwordInput = document.getElementById('passwordInput');
            const toggleIcon = document.getElementById('toggleIcon');

            togglePasswordBtn.addEventListener('click', function() {
                const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
                passwordInput.setAttribute('type', type);

                // Toggle eye icon
                if (type === 'text') {
                    toggleIcon.classList.remove('bi-eye');
                    toggleIcon.classList.add('bi-eye-slash');
                } else {
                    toggleIcon.classList.remove('bi-eye-slash');
                    toggleIcon.classList.add('bi-eye');
                }
            });

            // Form submit handler mockup
            function handleLogin(event) {
                event.preventDefault();
                const user = document.getElementById('userSelect').value;
                const pass = document.getElementById('passwordInput').value;

                if (user && pass) {
                    const btn = document.querySelector('.btn-submit');
                    btn.innerText = 'Signing in...';
                    btn.disabled = true;

                    setTimeout(() => {
                        alert('Login successful! Welcome to ERPLITE.');
                        btn.innerText = 'Sign in';
                        btn.disabled = false;
                    }, 1000);
                }
            }

            function handleForgotPassword(e) {
                e.preventDefault();
                alert('Password reset link sent to registered administrator contact.');
            }

            function handleSignUp(e) {
                e.preventDefault();
                alert('Redirecting to Sign Up page.');
            }
    </script>
</body>
</html>