@model ERP.Web.Models.PagedResult<ERP.Web.Models.RoleViewModel>

@{
    ViewData["Title"] = T["Master Roles"];
    var no = (Model.Page - 1) * Model.PageSize;
}

<div class="px-2">

    <!-- HEADER -->
    <div class="mb-3">
        <h3 class="fw-semibold text-white mb-0">@T["Master Roles"]</h3>
    </div>

    <!-- TABLE CARD -->
    <div class="card custom-card">

        <div class="card-header custom-card-header d-flex justify-content-between align-items-center py-3 px-4"> 
            <span class="fw-semibold text-white fs-6">@T["Daftar Role"]</span>
            <button type="button"
                    class="btn btn-primary btn-sm px-3 py-1-5 custom-btn-add"
                    data-perm="create"
                    onclick="openCreateRole()">
                <i class="bi bi-plus me-1"></i>@T["Tambah Role"]
            </button>
        </div>

        <div class="table-responsive">
            <table class="table custom-table align-middle mb-0">
                <thead>
                    <tr>
                        <th class="text-center fw-bold" style="width: 50px;">#</th>
                        <th class="fw-bold" style="width: 180px;">@T["NAMA ROLE"]</th>
                        <th class="fw-bold">@T["DESKRIPSI"]</th>
                        <th class="text-center fw-bold" style="width: 90px;">@T["STATUS"]</th>
                        <th class="text-center fw-bold" style="width: 100px;">@T["AKSI"]</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Data != null && Model.Data.Count > 0)
                    {
                        foreach (var item in Model.Data)
                        {
                            no++;
                            <tr>
                                <!-- # -->
                                <td class="text-center text-white">@no</td>

                                <!-- NAMA ROLE -->
                                <td class="fw-semibold text-white">@item.Name</td>

                                <!-- DESKRIPSI -->
                                <td class="text-white text-description">
                                    @(string.IsNullOrWhiteSpace(item.Description) ? "-" : item.Description)
                                </td>

                                <!-- STATUS -->
                                <td class="text-center">
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success ms-2">@T["Aktif"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger ms-2">@T["Tidak Aktif"]</span>
                                    }
                                </td>

                                <!-- AKSI -->
                                <td class="text-center">
                                    <div class="row-actions">
                                        <!-- EDIT -->
                                        <button type="button"
                                                data-perm="update"
                                                class="act-btn act-edit"
                                                title="@T["Edit"]"
                                                onclick="openEditRole('@item.Uid')">
                                            <i class="bi bi-pencil"></i>
                                        </button>

                                        <!-- DELETE -->
                                        <form method="post"
                                              asp-controller="Roles"
                                              asp-action="Delete"
                                              data-perm="delete"
                                              onsubmit='return confirm(@Json.Serialize(T["Yakin ingin menghapus role ini?"]));'>
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="uid" value="@item.Uid" />
                                            <button type="submit"
                                                    class="act-btn act-delete"
                                                    title="@T["Hapus"]">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                @T["Data role tidak ditemukan."]
                            </td> 
                        </tr> 
                    } 
                </tbody> 
            </table>
        </div>

        <!-- PAGINATION -->
        @if (Model.TotalPage > 1)
        {
            <div class="d-flex justify-content-between align-items-center p-3 border-top custom-border-color">
                <div class="text-muted small">
                    @T["Menampilkan"] <strong>@((Model.Page - 1) * Model.PageSize + 1)</strong> - 
                    <strong>@Math.Min(Model.Page * Model.PageSize, Model.TotalData)</strong> @T["dari"] 
                    <strong>@Model.TotalData</strong> @T["data"]
                </div>

                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                            <a class="page-link"
                               asp-controller="Roles"
                               asp-action="Index"
                               asp-route-search="@ViewBag.Search"
                               asp-route-page="1"
                               asp-route-pageSize="@Model.PageSize">
                                <i class="bi bi-chevron-double-left"></i>
                            </a>
                        </li>
                        <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                            <a class="page-link"
                               asp-controller="Roles"
                               asp-action="Index"
                               asp-route-search="@ViewBag.Search"
                               asp-route-page="@(Model.Page - 1)"
                               asp-route-pageSize="@Model.PageSize">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>

                        @for (int i = 1; i <= Model.TotalPage; i++)
                        {
                            <li class="page-item @(i == Model.Page ? "active" : "")">
                                <a class="page-link"
                                   asp-controller="Roles"
                                   asp-action="Index"
                                   asp-route-search="@ViewBag.Search"
                                   asp-route-page="@i"
                                   asp-route-pageSize="@Model.PageSize">
                                    @i
                                </a>
                            </li>
                        }

                        <li class="page-item @(Model.Page >= Model.TotalPage ? "disabled" : "")">
                            <a class="page-link"
                               asp-controller="Roles"
                               asp-action="Index"
                               asp-route-search="@ViewBag.Search"
                               asp-route-page="@(Model.Page + 1)"
                               asp-route-pageSize="@Model.PageSize">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                        <li class="page-item @(Model.Page >= Model.TotalPage ? "disabled" : "")">
                            <a class="page-link"
                               asp-controller="Roles"
                               asp-action="Index"
                               asp-route-search="@ViewBag.Search"
                               asp-route-page="@Model.TotalPage"
                               asp-route-pageSize="@Model.PageSize">
                                <i class="bi bi-chevron-double-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<!-- ===================================================== -->
<!-- CREATE / EDIT MODAL -->
<!-- ===================================================== -->
<div class="modal fade" id="roleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content custom-modal-content">
            <form id="roleForm" method="post">
                @Html.AntiForgeryToken()

                <div class="modal-header border-bottom custom-border-color">
                    <h5 class="modal-title text-white" id="roleModalTitle">@T["Tambah Role"]</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" id="roleUid" name="Uid" />

                    <!-- NAME -->
                    <div class="mb-3">
                        <label for="roleName" class="form-label fw-semibold text-white">
                            @T["Nama Role"] <span class="text-danger">*</span>
                        </label>
                        <input type="text"
                               id="roleName"
                               name="Name"
                               class="form-control custom-input"
                               maxlength="100"
                               required />
                    </div>

                    <!-- DESCRIPTION -->
                    <div class="mb-3">
                        <label for="roleDescription" class="form-label fw-semibold text-white">
                            @T["Deskripsi"]
                        </label>
                        <textarea id="roleDescription"
                                  name="Description"
                                  class="form-control custom-input"
                                  rows="3"
                                  maxlength="255"
                                  placeholder="@T["Masukkan deskripsi role..."]"></textarea>
                    </div>

                    <!-- STATUS -->
                    <div class="form-check form-switch">
                        <input type="hidden" id="roleIsActiveValue" name="IsActive" value="true" />
                        <input class="form-check-input" type="checkbox" id="roleIsActive" checked />
                        <label class="form-check-label text-white" for="roleIsActive">@T["Role Aktif"]</label>
                    </div>
                </div>

                <div class="modal-footer border-top custom-border-color">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@T["Batal"]</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save me-1"></i>@T["Simpan"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function openCreateRole() {
        document.getElementById("roleModalTitle").innerText = @Json.Serialize(T["Tambah Role"]);
        document.getElementById("roleForm").action = "/Roles/Create";
        document.getElementById("roleUid").value = "";
        document.getElementById("roleName").value = "";
        document.getElementById("roleDescription").value = "";
        document.getElementById("roleIsActive").checked = true;
        document.getElementById("roleIsActiveValue").value = "true";

        const modal = new bootstrap.Modal(document.getElementById("roleModal"));
        modal.show();
    }

    async function openEditRole(uid) {
        try {
            const response = await fetch(`/Roles/GetById?uid=${encodeURIComponent(uid)}`);
            if (!response.ok) {
                alert(@Json.Serialize(T["Data role tidak ditemukan."]));
                return;
            }

            const role = await response.json();
            document.getElementById("roleModalTitle").innerText = "Edit Role";
            document.getElementById("roleForm").action = "/Roles/Edit";
            document.getElementById("roleUid").value = role.uid;
            document.getElementById("roleName").value = role.name ?? "";
            document.getElementById("roleDescription").value = role.description ?? "";

            const isActive = role.isActive === true;
            document.getElementById("roleIsActive").checked = isActive;
            document.getElementById("roleIsActiveValue").value = isActive ? "true" : "false";

            const modal = new bootstrap.Modal(document.getElementById("roleModal"));
            modal.show();
        } catch (error) {
            console.error(error);
            alert(@Json.Serialize(T["Terjadi kesalahan saat mengambil data role."]));
        }
    }

    document.getElementById("roleIsActive").addEventListener("change", function () {
        document.getElementById("roleIsActiveValue").value = this.checked ? "true" : "false";
    });
</script>
}
