@model ERP.Web.Models.GeneralLedgerPageViewModel

@{
    Layout = null;
    var gl = Model.Ledger!;
}

<!DOCTYPE html>
<html lang="@T.Lang">
<head>
    <meta charset="utf-8" />
    <title>@T["Buku Besar"] @gl.Account.Code</title>
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; padding: 20px; font-family: Arial, Helvetica, sans-serif; color: #111; background: #fff; font-size: 11px; }
        h1 { margin: 0 0 4px 0; font-size: 18px; }
        .meta { color: #6c757d; margin-bottom: 12px; }
        table { width: 100%; border-collapse: collapse; }
        th, td { border: 1px solid #ccc; padding: 4px 6px; text-align: left; }
        th { background: #f1f3f5; }
        .num { text-align: right; white-space: nowrap; }
        tfoot td { font-weight: 700; }
        @@media print { body { padding: 0; } }
    </style>
</head>
<body onload="window.print()">
    <h1>@T["Buku Besar"] — @gl.Account.Code @gl.Account.Name</h1>
    <div class="meta">
        @T["Periode {0} s/d {1}", Acc.Date(gl.From), Acc.Date(gl.To)] · @T["Saldo normal"] @(gl.Account.NormalBalance == "debit" ? T["debit"] : T["kredit"]) ·
        @T["Dicetak"] @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
    </div>
    <table>
        <thead>
            <tr><th>@T["Tanggal"]</th><th>@T["No. Jurnal"]</th><th>@T["Referensi"]</th><th>@T["Keterangan"]</th><th class="num">@T["Debit"]</th><th class="num">@T["Kredit"]</th><th class="num">@T["Saldo"]</th></tr>
        </thead>
        <tbody>
            <tr><td colspan="6"><em>@T["Saldo awal"]</em></td><td class="num">@Acc.Money(gl.Opening)</td></tr>
            @foreach (var l in gl.Lines)
            {
                <tr>
                    <td>@Acc.Date(l.Date)</td>
                    <td>@l.JournalNo</td>
                    <td>@l.Reference</td>
                    <td>@l.Description</td>
                    <td class="num">@Acc.MoneyOrBlank(l.Debit)</td>
                    <td class="num">@Acc.MoneyOrBlank(l.Credit)</td>
                    <td class="num">@Acc.Money(l.Balance)</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="4" class="num">@T["Total / Saldo akhir"]</td>
                <td class="num">@Acc.Money(gl.TotalDebit)</td>
                <td class="num">@Acc.Money(gl.TotalCredit)</td>
                <td class="num">@Acc.Money(gl.Closing)</td>
            </tr>
        </tfoot>
    </table>
</body>
</html>
